<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ========================================================================= -->
    <!-- 1. COLOR TOKENS (DESIGN_SYSTEM.md §2)                                      -->
    <!-- ========================================================================= -->

    <!-- Raw Colors -->
    <Color x:Key="Color.Bg.Window">#0B0B0D</Color>
    <Color x:Key="Color.Bg.Card">#141418</Color>
    <Color x:Key="Color.Bg.Control">#181820</Color>
    <Color x:Key="Color.Bg.Raised">#1C1E2A</Color>
    <Color x:Key="Color.Border.Subtle">#22222B</Color>
    <Color x:Key="Color.Border.Default">#2A2A38</Color>
    <Color x:Key="Color.Border.Hover">#3F3F50</Color>
    <Color x:Key="Color.Text.Primary">#E4E4E7</Color>
    <Color x:Key="Color.Text.Secondary">#A1A1AA</Color>
    <Color x:Key="Color.Text.Tertiary">#71717A</Color>
    <Color x:Key="Color.Accent">#3B82F6</Color>
    <Color x:Key="Color.Accent.Hover">#60A5FA</Color>
    <Color x:Key="Color.Accent.Soft">#293B82F6</Color>
    <Color x:Key="Color.Success">#10B981</Color>
    <Color x:Key="Color.Warning">#F59E0B</Color>
    <Color x:Key="Color.Danger">#EF4444</Color>
    <Color x:Key="Color.Violet">#7C3AED</Color>

    <!-- Solid Brushes -->
    <SolidColorBrush x:Key="Brush.Bg.Window" Color="{StaticResource Color.Bg.Window}"/>
    <SolidColorBrush x:Key="Brush.Bg.Card" Color="{StaticResource Color.Bg.Card}"/>
    <SolidColorBrush x:Key="Brush.Bg.Control" Color="{StaticResource Color.Bg.Control}"/>
    <SolidColorBrush x:Key="Brush.Bg.Raised" Color="{StaticResource Color.Bg.Raised}"/>
    <SolidColorBrush x:Key="Brush.Border.Subtle" Color="{StaticResource Color.Border.Subtle}"/>
    <SolidColorBrush x:Key="Brush.Border.Default" Color="{StaticResource Color.Border.Default}"/>
    <SolidColorBrush x:Key="Brush.Border.Hover" Color="{StaticResource Color.Border.Hover}"/>
    <SolidColorBrush x:Key="Brush.Text.Primary" Color="{StaticResource Color.Text.Primary}"/>
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="{StaticResource Color.Text.Secondary}"/>
    <SolidColorBrush x:Key="Brush.Text.Tertiary" Color="{StaticResource Color.Text.Tertiary}"/>
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}"/>
    <SolidColorBrush x:Key="Brush.Accent.Hover" Color="{StaticResource Color.Accent.Hover}"/>
    <SolidColorBrush x:Key="Brush.Accent.Soft" Color="{StaticResource Color.Accent.Soft}"/>
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}"/>
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}"/>
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}"/>
    <SolidColorBrush x:Key="Brush.Violet" Color="{StaticResource Color.Violet}"/>

    <!-- Backward compatibility mappings with old ThemeDictionary keys -->
    <SolidColorBrush x:Key="ThemeBackgroundBrush" Color="{StaticResource Color.Bg.Window}"/>
    <SolidColorBrush x:Key="ThemeSurfaceBrush" Color="{StaticResource Color.Bg.Card}"/>
    <SolidColorBrush x:Key="ThemeSurfaceRaisedBrush" Color="{StaticResource Color.Bg.Raised}"/>
    <SolidColorBrush x:Key="ThemeBorderBrush" Color="{StaticResource Color.Border.Subtle}"/>
    <SolidColorBrush x:Key="ThemeBorderStrongBrush" Color="{StaticResource Color.Border.Default}"/>
    <SolidColorBrush x:Key="ThemeTextBrush" Color="{StaticResource Color.Text.Primary}"/>
    <SolidColorBrush x:Key="ThemeMutedTextBrush" Color="{StaticResource Color.Text.Secondary}"/>
    <SolidColorBrush x:Key="ThemeAccentBrush" Color="{StaticResource Color.Accent}"/>
    <SolidColorBrush x:Key="ThemeAccentHoverBrush" Color="{StaticResource Color.Accent.Hover}"/>

    <!-- ========================================================================= -->
    <!-- 2. SHAPE & CORNER RADII (DESIGN_SYSTEM.md §4)                              -->
    <!-- ========================================================================= -->

    <CornerRadius x:Key="Radius.S">6</CornerRadius>
    <CornerRadius x:Key="Radius.M">10</CornerRadius>
    <CornerRadius x:Key="Radius.L">14</CornerRadius>
    <CornerRadius x:Key="Radius.XL">20</CornerRadius>
    <CornerRadius x:Key="Radius.Pill">999</CornerRadius>

    <!-- ========================================================================= -->
    <!-- 3. SPACING TOKENS (DESIGN_SYSTEM.md §4)                                   -->
    <!-- ========================================================================= -->

    <Thickness x:Key="Spacing.XS">4</Thickness>
    <Thickness x:Key="Spacing.S">8</Thickness>
    <Thickness x:Key="Spacing.M">12</Thickness>
    <Thickness x:Key="Spacing.L">16</Thickness>
    <Thickness x:Key="Spacing.XL">24</Thickness>
    <Thickness x:Key="Spacing.XXL">32</Thickness>

    <!-- ========================================================================= -->
    <!-- 4. TYPOGRAPHY (DESIGN_SYSTEM.md §3)                                       -->
    <!-- ========================================================================= -->

    <FontFamily x:Key="Font.Family.Default">Segoe UI Variable Text, Segoe UI, Arial</FontFamily>
    <FontFamily x:Key="Font.Family.Mono">Cascadia Mono, Consolas, Courier New</FontFamily>

    <sys:Double x:Key="Type.Size.Display">28</sys:Double>
    <sys:Double x:Key="Type.Size.Title">19</sys:Double>
    <sys:Double x:Key="Type.Size.Section">14</sys:Double>
    <sys:Double x:Key="Type.Size.Body">12.5</sys:Double>
    <sys:Double x:Key="Type.Size.Label">11.5</sys:Double>
    <sys:Double x:Key="Type.Size.Caption">10.5</sys:Double>

    <Style x:Key="Text.Display" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Family.Default}"/>
        <Setter Property="FontSize" Value="{StaticResource Type.Size.Display}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
    </Style>

    <Style x:Key="Text.Title" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Family.Default}"/>
        <Setter Property="FontSize" Value="{StaticResource Type.Size.Title}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
    </Style>

    <Style x:Key="Text.Section" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Family.Default}"/>
        <Setter Property="FontSize" Value="{StaticResource Type.Size.Section}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
    </Style>

    <Style x:Key="Text.Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Family.Default}"/>
        <Setter Property="FontSize" Value="{StaticResource Type.Size.Body}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
    </Style>

    <Style x:Key="Text.Label" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Family.Default}"/>
        <Setter Property="FontSize" Value="{StaticResource Type.Size.Label}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}"/>
    </Style>

    <Style x:Key="Text.Caption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Family.Default}"/>
        <Setter Property="FontSize" Value="{StaticResource Type.Size.Caption}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Tertiary}"/>
    </Style>

</ResourceDictionary>
