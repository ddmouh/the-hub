<UserControl x:Class="TheHub.Design.Controls.HoldToConfirmButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             Focusable="True"
             Cursor="Hand"
             ClipToBounds="True"
             Background="Transparent"
             PreviewMouseLeftButtonDown="OnPreviewMouseLeftButtonDown"
             PreviewMouseLeftButtonUp="OnPreviewMouseLeftButtonUp"
             PreviewMouseMove="OnPreviewMouseMove"
             MouseLeave="OnMouseLeave"
             KeyDown="OnKeyDown"
             KeyUp="OnKeyUp">

    <UserControl.Resources>
        <ResourceDictionary Source="pack://application:,,,/TheHub.Design;component/Tokens.xaml"/>
    </UserControl.Resources>

    <Grid x:Name="RootGrid" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="ScaleTransform" ScaleX="1.0" ScaleY="1.0"/>
            </TransformGroup>
        </Grid.RenderTransform>

        <!-- Background Container -->
        <Border x:Name="BaseBorder"
                Background="{Binding BaseBackground, RelativeSource={RelativeSource AncestorType=UserControl}}"
                BorderBrush="{Binding BaseBorderBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"
                BorderThickness="1"
                CornerRadius="{Binding CornerRadius, RelativeSource={RelativeSource AncestorType=UserControl}}"
                SnapsToDevicePixels="True"/>

        <!-- Progress Fill Layer (animated width clipped to corner radius) -->
        <Border CornerRadius="{Binding CornerRadius, RelativeSource={RelativeSource AncestorType=UserControl}}"
                ClipToBounds="True">
            <Border x:Name="ProgressFill"
                    HorizontalAlignment="Left"
                    Width="0"
                    Background="{Binding HoldBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Opacity="0.85"/>
        </Border>

        <!-- Subtle Top Glow Highlight when holding -->
        <Border x:Name="GlowBorder"
                BorderBrush="{Binding HoldBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"
                BorderThickness="1.5"
                CornerRadius="{Binding CornerRadius, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Opacity="0"
                IsHitTestVisible="False"/>

        <!-- Label / Icon Content -->
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8,4">
            <ContentPresenter x:Name="DefaultContentPresenter"
                              Content="{Binding Content, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>

            <TextBlock x:Name="TxtConfirmed"
                       Text="{Binding ConfirmedText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       Foreground="#FFFFFF"
                       FontWeight="Bold"
                       FontSize="11.5"
                       Visibility="Collapsed"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</UserControl>
