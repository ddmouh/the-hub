<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:TheHub.Design.Controls">

    <!-- Merge Tokens so all brushes and radii are available -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/TheHub.Design;component/Tokens.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- ========================================================================= -->
    <!-- 1. HUB BUTTONS (DESIGN_SYSTEM.md §5)                                       -->
    <!-- ========================================================================= -->

    <!-- Base Button -->
    <Style x:Key="HubButton.Base" TargetType="Button">
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="FontSize" Value="{StaticResource Type.Size.Label}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TransformGroup>
                    <ScaleTransform x:Name="BtnScale" ScaleX="1.0" ScaleY="1.0"/>
                    <TranslateTransform x:Name="BtnTranslate" Y="0"/>
                </TransformGroup>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Primary Button -->
    <Style x:Key="HubButton.Primary" TargetType="Button" BasedOn="{StaticResource HubButton.Base}">
        <Setter Property="Background" Value="{StaticResource Brush.Accent}"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource Radius.S}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{StaticResource Brush.Accent.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Secondary Button -->
    <Style x:Key="HubButton.Secondary" TargetType="Button" BasedOn="{StaticResource HubButton.Base}">
        <Setter Property="Background" Value="{StaticResource Brush.Bg.Control}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Default}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Radius.S}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource Brush.Border.Hover}"/>
                            <Setter TargetName="Border" Property="Background" Value="{StaticResource Brush.Bg.Raised}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Ghost Button -->
    <Style x:Key="HubButton.Ghost" TargetType="Button" BasedOn="{StaticResource HubButton.Base}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource Radius.S}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{StaticResource Brush.Bg.Raised}"/>
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Opacity" Value="0.8"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Danger Button -->
    <Style x:Key="HubButton.Danger" TargetType="Button" BasedOn="{StaticResource HubButton.Base}">
        <Setter Property="Background" Value="{StaticResource Brush.Danger}"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource Radius.S}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="0.9"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Opacity" Value="0.75"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========================================================================= -->
    <!-- 2. HUB HOLD BUTTON (DESTRUCTIVE CONFIRM)                                   -->
    <!-- ========================================================================= -->

    <Style TargetType="{x:Type controls:HubHoldButton}">
        <Setter Property="Height" Value="36"/>
        <Setter Property="MinWidth" Value="140"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="FontSize" Value="{StaticResource Type.Size.Label}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Background" Value="{StaticResource Brush.Danger.Soft}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Danger}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.S}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:HubHoldButton}">
                    <Border x:Name="MainBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            ClipToBounds="True"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <!-- 1. Fill Track overlay -->
                            <Border x:Name="PART_FillTrack"
                                    Background="{StaticResource Brush.Danger}"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    HorizontalAlignment="Left"
                                    Width="0"/>

                            <!-- 2. Base Normal Text Layer -->
                            <Grid x:Name="NormalTextContainer"
                                  Margin="{TemplateBinding Padding}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center">
                                <StackPanel x:Name="IdleContentPanel" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ContentPresenter Content="{TemplateBinding Content}"
                                                      RecognizesAccessKey="True"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </StackPanel>

                                <TextBlock x:Name="TxtHoldingLabel"
                                           Text="{TemplateBinding HoldingText}"
                                           Foreground="#FFFFFF"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           Visibility="Collapsed"/>

                                <StackPanel x:Name="ConfirmedContentPanel"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Center"
                                            Visibility="Collapsed">
                                    <TextBlock Text="✓ " FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                    <TextBlock Text="{TemplateBinding ConfirmedText}" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <!-- 3. Inverted Text Layer (Hardware-Accelerated Clip Geometry) -->
                            <Grid x:Name="PART_InvertedContainer"
                                  Margin="{TemplateBinding Padding}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ContentPresenter x:Name="InvertedPresenter"
                                                      Content="{TemplateBinding Content}"
                                                      TextBlock.Foreground="{StaticResource Brush.Bg.Window}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </StackPanel>

                                <TextBlock x:Name="TxtInvertedHoldingLabel"
                                           Text="{TemplateBinding HoldingText}"
                                           Foreground="{StaticResource Brush.Bg.Window}"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           Visibility="Collapsed"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <!-- Variant: Neutral -->
                        <Trigger Property="Variant" Value="Neutral">
                            <Setter Property="Background" Value="{StaticResource Brush.Bg.Control}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Default}"/>
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
                            <Setter TargetName="PART_FillTrack" Property="Background" Value="{StaticResource Brush.Text.Primary}"/>
                            <Setter TargetName="TxtHoldingLabel" Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
                            <Setter TargetName="InvertedPresenter" Property="TextBlock.Foreground" Value="{StaticResource Brush.Bg.Window}"/>
                            <Setter TargetName="TxtInvertedHoldingLabel" Property="Foreground" Value="{StaticResource Brush.Bg.Window}"/>
                        </Trigger>

                        <!-- Variant: Danger (Default) -->
                        <Trigger Property="Variant" Value="Danger">
                            <Setter Property="Foreground" Value="{StaticResource Brush.Danger}"/>
                            <Setter TargetName="InvertedPresenter" Property="TextBlock.Foreground" Value="#FFFFFF"/>
                            <Setter TargetName="TxtInvertedHoldingLabel" Property="Foreground" Value="#FFFFFF"/>
                        </Trigger>

                        <!-- Holding State -->
                        <Trigger Property="CurrentState" Value="Holding">
                            <Setter TargetName="IdleContentPanel" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="TxtHoldingLabel" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="InvertedPresenter" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="TxtInvertedHoldingLabel" Property="Visibility" Value="Visible"/>
                        </Trigger>

                        <!-- Releasing State -->
                        <Trigger Property="CurrentState" Value="Releasing">
                            <Setter TargetName="IdleContentPanel" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="TxtHoldingLabel" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="InvertedPresenter" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="TxtInvertedHoldingLabel" Property="Visibility" Value="Visible"/>
                        </Trigger>

                        <!-- Confirmed State -->
                        <Trigger Property="CurrentState" Value="Confirmed">
                            <Setter TargetName="MainBorder" Property="Background" Value="{StaticResource Brush.Success}"/>
                            <Setter TargetName="MainBorder" Property="BorderBrush" Value="{StaticResource Brush.Success}"/>
                            <Setter TargetName="IdleContentPanel" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="TxtHoldingLabel" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="ConfirmedContentPanel" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="PART_InvertedContainer" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="PART_FillTrack" Property="Visibility" Value="Collapsed"/>
                        </Trigger>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="MainBorder" Property="BorderBrush" Value="{StaticResource Brush.Border.Hover}"/>
                        </Trigger>

                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="MainBorder" Property="BorderBrush" Value="{StaticResource Brush.Accent}"/>
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========================================================================= -->
    <!-- 3. HUB RANGE SLIDER (DUAL THUMB)                                          -->
    <!-- ========================================================================= -->

    <!-- Range Thumb Style -->
    <Style x:Key="RangeSliderThumbStyle" TargetType="Thumb">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="ThumbBorder"
                            Width="16" Height="16"
                            CornerRadius="8"
                            Background="{StaticResource Brush.Text.Primary}"
                            BorderBrush="{StaticResource Brush.Border.Hover}"
                            BorderThickness="1"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbBorder" Property="BorderBrush" Value="{StaticResource Brush.Accent.Hover}"/>
                            <Setter TargetName="ThumbBorder" Property="Background" Value="#FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbBorder" Property="Background" Value="{StaticResource Brush.Accent}"/>
                            <Setter TargetName="ThumbBorder" Property="BorderBrush" Value="{StaticResource Brush.Accent.Hover}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type controls:HubRangeSlider}">
        <Setter Property="Height" Value="32"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:HubRangeSlider}">
                    <Grid VerticalAlignment="Center" Background="Transparent" SnapsToDevicePixels="True">
                        <!-- 1. Background Track (4px) -->
                        <Border x:Name="PART_TrackContainer"
                                Height="4"
                                Background="{StaticResource Brush.Border.Default}"
                                CornerRadius="2"
                                VerticalAlignment="Center"
                                Margin="8,0"/>

                        <!-- 2. Thumbs and Range Highlight Canvas -->
                        <Canvas Margin="8,0" Height="16" VerticalAlignment="Center">
                            <!-- Filled Accent segment between thumbs -->
                            <Border x:Name="PART_RangeHighlight"
                                    Height="4"
                                    Background="{StaticResource Brush.Accent}"
                                    CornerRadius="2"
                                    Canvas.Top="6"
                                    Width="0"/>

                            <!-- Lower Thumb -->
                            <Thumb x:Name="PART_LowerThumb"
                                   Style="{StaticResource RangeSliderThumbStyle}"
                                   Canvas.Top="0"
                                   Canvas.Left="0"/>

                            <!-- Upper Thumb -->
                            <Thumb x:Name="PART_UpperThumb"
                                   Style="{StaticResource RangeSliderThumbStyle}"
                                   Canvas.Top="0"
                                   Canvas.Left="0"/>
                        </Canvas>

                        <!-- 3. Floating Value Tooltip Bubble -->
                        <Border x:Name="PART_ValueBubble"
                                Background="{StaticResource Brush.Bg.Raised}"
                                BorderBrush="{StaticResource Brush.Border.Default}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Radius.S}"
                                Padding="8,3"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Margin="8,-26,0,0"
                                IsHitTestVisible="False">
                            <TextBlock x:Name="PART_BubbleText"
                                       Style="{StaticResource Text.Caption}"
                                       Foreground="{StaticResource Brush.Text.Primary}"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========================================================================= -->
    <!-- 4. HUB PILL TABS & PILL TAB ITEM                                          -->
    <!-- ========================================================================= -->

    <Style TargetType="{x:Type controls:HubPillTabItem}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}"/>
        <Setter Property="FontSize" Value="{StaticResource Type.Size.Label}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:HubPillTabItem}">
                    <Border x:Name="ItemBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource Radius.Pill}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource Brush.Border.Hover}"/>
                            <Setter TargetName="ItemBorder" Property="BorderThickness" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type controls:HubPillTabs}">
        <Setter Property="Background" Value="{StaticResource Brush.Bg.Control}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Subtle}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Padding" Value="3"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:HubPillTabs}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Radius.Pill}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <!-- Sliding Indicator Canvas behind tabs -->
                            <Canvas HorizontalAlignment="Left" VerticalAlignment="Stretch">
                                <Border x:Name="PART_Indicator"
                                        Height="30"
                                        Background="{StaticResource Brush.Bg.Raised}"
                                        BorderBrush="{StaticResource Brush.Border.Default}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource Radius.Pill}"
                                        SnapsToDevicePixels="True"/>
                            </Canvas>

                            <!-- Items StackPanel -->
                            <StackPanel IsItemsHost="True"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========================================================================= -->
    <!-- 5. HUB SLIDER (UPGRADED SINGLE THUMB WITH BUBBLE)                          -->
    <!-- ========================================================================= -->

    <Style x:Key="HubSliderThumbStyle" TargetType="Thumb">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="ThumbBorder"
                            Width="16" Height="16"
                            CornerRadius="8"
                            Background="{StaticResource Brush.Text.Primary}"
                            BorderBrush="{StaticResource Brush.Border.Hover}"
                            BorderThickness="1"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbBorder" Property="BorderBrush" Value="{StaticResource Brush.Accent.Hover}"/>
                            <Setter TargetName="ThumbBorder" Property="Background" Value="#FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbBorder" Property="Background" Value="{StaticResource Brush.Accent}"/>
                            <Setter TargetName="ThumbBorder" Property="BorderBrush" Value="{StaticResource Brush.Accent.Hover}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type controls:HubSlider}">
        <Setter Property="Height" Value="32"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:HubSlider}">
                    <Grid VerticalAlignment="Center" Background="Transparent" SnapsToDevicePixels="True">
                        <!-- 1. Background Track (4px) -->
                        <Border Height="4"
                                Background="{StaticResource Brush.Border.Default}"
                                CornerRadius="2"
                                VerticalAlignment="Center"
                                Margin="8,0"/>

                        <!-- 2. Track with Thumb -->
                        <Track x:Name="PART_Track" Margin="8,0">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge">
                                    <RepeatButton.Template>
                                        <ControlTemplate>
                                            <Border Height="4" Background="{StaticResource Brush.Accent}" CornerRadius="2"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource HubSliderThumbStyle}"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge">
                                    <RepeatButton.Template>
                                        <ControlTemplate>
                                            <Border Height="4" Background="Transparent"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                        </Track>

                        <!-- 3. Floating Value Bubble -->
                        <Border x:Name="PART_ValueBubble"
                                Background="{StaticResource Brush.Bg.Raised}"
                                BorderBrush="{StaticResource Brush.Border.Default}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Radius.S}"
                                Padding="8,3"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Margin="8,-26,0,0"
                                IsHitTestVisible="False">
                            <TextBlock x:Name="PART_BubbleText"
                                       Style="{StaticResource Text.Caption}"
                                       Foreground="{StaticResource Brush.Text.Primary}"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========================================================================= -->
    <!-- 6. HUB TOGGLE SWITCH (UPGRADED WITH PRESS-STRETCH)                         -->
    <!-- ========================================================================= -->

    <Style TargetType="{x:Type controls:HubToggle}">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Width" Value="48"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:HubToggle}">
                    <Grid Width="48" Height="32" Background="Transparent">
                        <Border x:Name="PART_Track"
                                Width="36" Height="20"
                                Background="{StaticResource Brush.Border.Default}"
                                CornerRadius="10"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <Canvas Width="36" Height="20">
                                <Ellipse x:Name="PART_Thumb"
                                         Width="14" Height="14"
                                         Fill="{StaticResource Brush.Text.Secondary}"
                                         Canvas.Left="3"
                                         Canvas.Top="3"/>
                            </Canvas>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="PART_Track" Property="Background" Value="{StaticResource Brush.Accent}"/>
                            <Setter TargetName="PART_Thumb" Property="Fill" Value="#FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_Track" Property="Opacity" Value="0.9"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Legacy Style compatibility for CheckBox -->
    <Style x:Key="HubToggle" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Width="36" Height="20">
                        <Border x:Name="Track"
                                Background="{StaticResource Brush.Border.Default}"
                                CornerRadius="10"/>
                        <Ellipse x:Name="Thumb"
                                 Width="14" Height="14"
                                 Fill="{StaticResource Brush.Text.Secondary}"
                                 Margin="3,0,0,0"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource Brush.Accent}"/>
                            <Setter TargetName="Thumb" Property="Fill" Value="#FFFFFF"/>
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="Opacity" Value="0.9"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========================================================================= -->
    <!-- 7. HUB CARD & CHIP                                                        -->
    <!-- ========================================================================= -->

    <Style x:Key="HubCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.Bg.Card}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Subtle}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.L}"/>
        <Setter Property="Padding" Value="16"/>
    </Style>

    <Style x:Key="HubChip" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="ChipBorder"
                            Background="{StaticResource Brush.Bg.Control}"
                            BorderBrush="{StaticResource Brush.Border.Default}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Radius.Pill}"
                            Padding="12,5"
                            Margin="0,0,8,0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="ChipBorder" Property="Background" Value="{StaticResource Brush.Accent}"/>
                            <Setter TargetName="ChipBorder" Property="BorderBrush" Value="{StaticResource Brush.Accent}"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ChipBorder" Property="BorderBrush" Value="{StaticResource Brush.Border.Hover}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ========================================================================= -->
    <!-- 8. HUB COMBOBOX (DESIGN_SYSTEM.md §2, §5)                                  -->
    <!-- ========================================================================= -->
    <ControlTemplate x:Key="HubComboBoxToggleButton" TargetType="ToggleButton">
        <Border x:Name="Border"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{StaticResource Radius.M}"
                SnapsToDevicePixels="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="32"/>
                </Grid.ColumnDefinitions>
                <Path x:Name="Arrow"
                      Grid.Column="1"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Data="M 0 0 L 4 4 L 8 0 Z"
                      Fill="{StaticResource Brush.Text.Secondary}"
                      Margin="0,1,0,0"/>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource Brush.Border.Hover}"/>
                <Setter TargetName="Arrow" Property="Fill" Value="{StaticResource Brush.Text.Primary}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource Brush.Accent}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="HubComboBox" TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
        <Setter Property="Background" Value="{StaticResource Brush.Bg.Control}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Default}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="{StaticResource Type.Size.Label}"/>
        <Setter Property="FontFamily" Value="{StaticResource Type.Family.Base}"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="ToggleButton"
                                      Template="{StaticResource HubComboBoxToggleButton}"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      Focusable="False"
                                      IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      ClickMode="Press"/>
                        <ContentPresenter x:Name="ContentSite"
                                          IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          Margin="12,3,32,3"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Left"/>
                        <Popup x:Name="Popup"
                               Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="Fade">
                            <Grid x:Name="DropDown"
                                  SnapsToDevicePixels="True"
                                  MinWidth="{TemplateBinding ActualWidth}"
                                  MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <Border x:Name="DropDownBorder"
                                        Background="{StaticResource Brush.Bg.Raised}"
                                        BorderBrush="{StaticResource Brush.Border.Default}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource Radius.M}"
                                        Margin="0,4,0,0"
                                        Padding="4">
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource HubComboBox}"/>

    <Style x:Key="HubComboBoxItem" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="12,7"/>
        <Setter Property="FontSize" Value="{StaticResource Type.Size.Label}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="ItemBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource Radius.S}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource Brush.Bg.Control}"/>
                            <Setter Property="Foreground" Value="{StaticResource Brush.Accent.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource Brush.Accent}"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ComboBoxItem}" BasedOn="{StaticResource HubComboBoxItem}"/>


    <!-- ========================================================================= -->
    <!-- 9. SETTING ROW (DESIGN_SYSTEM.md §5)                                      -->
    <!-- ========================================================================= -->
    <Style TargetType="{x:Type controls:SettingRow}">
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="Padding" Value="0,8"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Subtle}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="HorizontalContentAlignment" Value="Right"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:SettingRow}">
                    <Border MinHeight="{TemplateBinding MinHeight}"
                            Padding="{TemplateBinding Padding}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Background="{TemplateBinding Background}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="{TemplateBinding Title}"
                                           Style="{StaticResource Text.Body}"
                                           FontWeight="Medium"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="{TemplateBinding Description}"
                                           Style="{StaticResource Text.Caption}"
                                           Margin="0,2,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <ContentPresenter Grid.Column="1"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>