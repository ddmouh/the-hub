<UserControl x:Class="TheHub.Design.Controls.SettingRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border MinHeight="48"
            Padding="0,8"
            BorderBrush="{StaticResource Brush.Border.Subtle}"
            BorderThickness="0,0,0,1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                <TextBlock x:Name="TxtTitle"
                           Style="{StaticResource Text.Body}"
                           FontWeight="Medium"
                           TextWrapping="Wrap"/>
                <TextBlock x:Name="TxtDescription"
                           Style="{StaticResource Text.Caption}"
                           Margin="0,2,0,0"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"/>
            </StackPanel>

            <ContentPresenter x:Name="ControlHost"
                              Grid.Column="1"
                              VerticalAlignment="Center"/>
        </Grid>
    </Border>
</UserControl>
