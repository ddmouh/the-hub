<UserControl x:Class="TheHub.Overlays.DynamicIsland.DynamicIslandExpandedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:TheHub.Overlays.DynamicIsland"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=local:DynamicIslandViewModel}"
             FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>

        <!-- Close Button Style -->
        <Style x:Key="HeaderCloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#71717A"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="12">
                            <TextBlock Text="✕" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#27272E"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dynamic Island Sleek Slider Custom ControlTemplate -->
        <Style x:Key="WhiteSliderTrackDecreaseStyle" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="4.5" Background="#FFFFFF" CornerRadius="2.5" VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WhiteSliderTrackIncreaseStyle" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="4.5" Background="Transparent" VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RectSliderThumbStyle" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Width="16" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- Crisp White Rectangular Thumb with Rounded Corners and DropShadow matching reference -->
                            <Border x:Name="ThumbRect" Width="8.5" Height="17" Background="#FFFFFF" CornerRadius="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.5"/>
                                </Border.Effect>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbRect" Property="Width" Value="9.5"/>
                                <Setter TargetName="ThumbRect" Property="Height" Value="18"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbRect" Property="Width" Value="10"/>
                                <Setter TargetName="ThumbRect" Property="Height" Value="19"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IslandCustomSliderStyle" TargetType="Slider">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <!-- Background Track: Dimmed dark line -->
                            <Border Height="4.5" Background="#2A2A34" CornerRadius="2.5" VerticalAlignment="Center"/>
                            <!-- Interactive Track with White Range Fill and Rectangular Thumb -->
                            <Track x:Name="PART_Track" VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource WhiteSliderTrackDecreaseStyle}" Command="{x:Static Slider.DecreaseLarge}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource RectSliderThumbStyle}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource WhiteSliderTrackIncreaseStyle}" Command="{x:Static Slider.IncreaseLarge}"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pill Action Button Style -->
        <Style x:Key="PillActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#17171F"/>
            <Setter Property="Foreground" Value="#E4E4E7"/>
            <Setter Property="BorderBrush" Value="#292936"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="17"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#22222E"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#3F3F52"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2A2A3A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Styled Pill ComboBox with Vector Chevron & Non-Clipping Popup -->
        <ControlTemplate x:Key="PillComboBoxToggleButtonTemplate" TargetType="ToggleButton">
            <Border x:Name="border"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="17"
                    Padding="12,0,10,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ContentPresenter Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" Content="{TemplateBinding Content}"/>
                    <Path x:Name="Chevron" Grid.Column="1" Data="M7 10l5 5 5-5z" Fill="#71717A" Stretch="Uniform" Width="8" Height="6" Margin="4,0,0,0" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="border" Property="Background" Value="#22222E"/>
                    <Setter TargetName="border" Property="BorderBrush" Value="#3F3F52"/>
                    <Setter TargetName="Chevron" Property="Fill" Value="#E4E4E7"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="border" Property="BorderBrush" Value="#60A5FA"/>
                    <Setter TargetName="Chevron" Property="Fill" Value="#60A5FA"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="PillComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="#17171F"/>
            <Setter Property="Foreground" Value="#E4E4E7"/>
            <Setter Property="BorderBrush" Value="#292936"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="MaxDropDownHeight" Value="180"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <!-- Toggle Button Trigger -->
                            <ToggleButton x:Name="ToggleButton"
                                          Template="{StaticResource PillComboBoxToggleButtonTemplate}"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </ToggleButton>

                            <!-- Modern Dark Popup (Renders Above/Below Window without Clipping) -->
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade"
                                   Focusable="False"
                                   Margin="0,4,0,0">
                                <Border x:Name="DropDownBorder"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxWidth="280"
                                        Background="#121217"
                                        BorderBrush="#2D2D3A"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="4"
                                        Margin="0,4,0,6">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.6"/>
                                    </Border.Effect>
                                    <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}" 
                                                  CanContentScroll="True" 
                                                  VerticalScrollBarVisibility="Auto" 
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="#E4E4E7"/>
                        <Setter Property="Padding" Value="8,6"/>
                        <Setter Property="Margin" Value="0,1"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#20202C"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#29293C"/>
                                            <Setter Property="Foreground" Value="#60A5FA"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Outer Floating Dark Island Expanded Container -->
    <Border Background="#0D0D11"
            BorderBrush="#2A2A34"
            BorderThickness="1.5"
            CornerRadius="22"
            Padding="16,14"
            SnapsToDevicePixels="True"
            UseLayoutRounding="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.75"/>
        </Border.Effect>

        <StackPanel>
            <!-- 1. Header Row (Speaker Badge + Title/Subtitle + Close Button) -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Audio Speaker Badge -->
                <Border Grid.Column="0" Width="36" Height="36" Background="#1B1B22" CornerRadius="10" BorderBrush="#2C2C38" BorderThickness="1" Margin="0,0,10,0">
                    <Path Data="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"
                          Fill="#FFFFFF" Stretch="Uniform" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- Title & Volume Subtitle -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding HeaderTitle, FallbackValue='Audio Live'}" FontSize="13.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                    <TextBlock Text="{Binding HeaderSubtitle, FallbackValue='50%'}" FontSize="11" Foreground="#A1A1AA" Margin="0,1.5,0,0"/>
                </StackPanel>

                <!-- Subtle Close Button ('✕') -->
                <Button Grid.Column="2" Style="{StaticResource HeaderCloseButtonStyle}" Command="{Binding CloseCommand}" ToolTip="Dismiss"/>
            </Grid>

            <!-- 2. Interactive Sliders Section -->
            <StackPanel Margin="0,0,0,14">
                <!-- Master Volume Slider Row -->
                <Grid Margin="0,2,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>

                    <!-- Speaker Vector Icon -->
                    <Path Grid.Column="0" 
                          Data="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02z"
                          Fill="#E4E4E7" Stretch="Uniform" Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Center"/>

                    <!-- Custom White Track & Thumb Slider -->
                    <Slider Grid.Column="1" 
                            Style="{StaticResource IslandCustomSliderStyle}" 
                            Minimum="0" Maximum="100" SmallChange="2" LargeChange="10"
                            Value="{Binding MasterVolume, Mode=TwoWay}"
                            Margin="6,0"/>

                    <!-- Right Percentage Readout -->
                    <TextBlock Grid.Column="2" Text="{Binding VolumeText, FallbackValue='70%'}" 
                               FontSize="11.5" FontWeight="Medium" Foreground="#E4E4E7" 
                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <!-- Screen Brightness Slider Row -->
                <Grid Margin="0,4,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>

                    <!-- Sun Vector Icon (Amber/Orange #FFA500) -->
                    <Path Grid.Column="0" 
                          Data="M12 7c-2.76 0-5 2.24-5 5s2.24 5 5 5 5-2.24 5-5-2.24-5-5-5zM2 13h2c.55 0 1-.45 1-1s-.45-1-1-1H2c-.55 0-1 .45-1 1s.45 1 1 1zm18 0h2c.55 0 1-.45 1-1s-.45-1-1-1h-2c-.55 0-1 .45-1 1s.45 1 1 1zM11 2v2c0 .55.45 1 1 1s1-.45 1-1V2c0-.55-.45-1-1-1s-1 .45-1 1zm0 18v2c0 .55.45 1 1 1s1-.45 1-1v-2c0-.55-.45-1-1-1s-1 .45-1 1zM5.99 4.58c-.39-.39-1.03-.39-1.41 0s-.39 1.03 0 1.41l1.06 1.06c.39.39 1.03.39 1.41 0s.39-1.03 0-1.41L5.99 4.58zm12.37 12.37c-.39-.39-1.03-.39-1.41 0s-.39 1.03 0 1.41l1.06 1.06c.39.39 1.03.39 1.41 0s.39-1.03 0-1.41l-1.06-1.06zm1.06-10.96c.39-.39.39-1.03 0-1.41s-1.03-.39-1.41 0l-1.06 1.06c-.39.39-.39 1.03 0 1.41s1.03.39 1.41 0l1.06-1.06zM7.05 18.36c.39-.39.39-1.03 0-1.41s-1.03-.39-1.41 0l-1.06 1.06c-.39.39-.39 1.03 0 1.41s1.03.39 1.41 0l1.06-1.06z"
                          Fill="#FFA500" Stretch="Uniform" Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Center"/>

                    <!-- Custom White Track & Thumb Slider -->
                    <Slider Grid.Column="1" 
                            Style="{StaticResource IslandCustomSliderStyle}" 
                            Minimum="10" Maximum="100" SmallChange="5" LargeChange="10"
                            Value="{Binding Brightness, Mode=TwoWay}"
                            Margin="6,0"/>

                    <!-- Right Percentage Readout -->
                    <TextBlock Grid.Column="2" Text="{Binding BrightnessText, FallbackValue='100%'}" 
                               FontSize="11.5" FontWeight="Medium" Foreground="#E4E4E7" 
                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>

            <!-- 3. Device Selectors (2-Column Uniform Grid: "Audio" & "Mic") -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Selector: "Audio" (Output/Playback Endpoints) -->
                <ComboBox Grid.Column="0"
                          Style="{StaticResource PillComboBoxStyle}"
                          ItemsSource="{Binding PlaybackDevices}"
                          SelectedItem="{Binding SelectedPlaybackDevice, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="✓" Foreground="#60A5FA" FontWeight="Bold" FontSize="11" 
                                           Visibility="{Binding IsDefault, Converter={StaticResource BoolToVisConverter}}" 
                                           HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Icon}" FontSize="10.5" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding ShortName}" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- Right Selector: "Mic" (Recording/Capture Endpoints) -->
                <ComboBox Grid.Column="2"
                          Style="{StaticResource PillComboBoxStyle}"
                          ItemsSource="{Binding RecordingDevices}"
                          SelectedItem="{Binding SelectedRecordingDevice, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="✓" Foreground="#60A5FA" FontWeight="Bold" FontSize="11" 
                                           Visibility="{Binding IsDefault, Converter={StaticResource BoolToVisConverter}}" 
                                           HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Icon}" FontSize="10.5" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding ShortName}" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>

            <!-- 4. Action Buttons (2-Column Uniform Grid: "Mic Active" & "Deafen") -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Button 1: Microphone Mute Toggle -->
                <Button Grid.Column="0"
                        Style="{StaticResource PillActionButtonStyle}"
                        Command="{Binding ToggleMicMuteCommand}"
                        ToolTip="Toggle Microphone Mute">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="M12 14c1.66 0 3-1.34 3-3V5c0-1.66-1.34-3-3-3S9 3.34 9 5v6c0 1.66 1.34 3 3 3zm5.3-3c0 3-2.54 5.1-5.3 5.1S6.7 14 6.7 11H5c0 3.41 2.72 6.23 6 6.72V21h2v-3.28c3.28-.48 6-3.3 6-6.72h-1.7z"
                              Fill="{Binding MicButtonForeground}"
                              Stretch="Uniform" Width="12" Height="12" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding MicButtonText, FallbackValue='Mic Active'}"
                                   Foreground="{Binding MicButtonForeground}"
                                   FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Button 2: Deafen Toggle -->
                <Button Grid.Column="2"
                        Style="{StaticResource PillActionButtonStyle}"
                        Command="{Binding ToggleDeafenCommand}"
                        ToolTip="Toggle Deafen (Mute Speakers and Microphone)">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="M12 3c-4.97 0-9 4.03-9 9v7c0 1.66 1.34 3 3 3h3v-8H5v-2c0-3.87 3.13-7 7-7s7 3.13 7 7v2h-4v8h3c1.66 0 3-1.34 3-3v-7c0-4.97-4.03-9-9-9z"
                              Fill="{Binding DeafenButtonForeground}"
                              Stretch="Uniform" Width="13" Height="13" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding DeafenButtonText, FallbackValue='Deafen'}"
                                   Foreground="{Binding DeafenButtonForeground}"
                                   FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
