<Window x:Class="TheHub.Overlays.DynamicIsland.DynamicIslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TheHub.Overlays.DynamicIsland"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Dynamic Island"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{x:Null}"
        Topmost="True"
        ShowActivated="False"
        Focusable="False"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" GlassFrameThickness="0" ResizeBorderThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    
    <Window.Resources>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E4E4E7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#2E2E36"/>
                                <Setter Property="Foreground" Value="#60A5FA"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#3B82F6"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QuickPillButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#202028"/>
            <Setter Property="Foreground" Value="#E4E4E7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#31313E"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PillBorder"
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="#2F2F3D"/>
                                <Setter TargetName="PillBorder" Property="BorderBrush" Value="#4F46E5"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="#2563EB"/>
                                <Setter TargetName="PillBorder" Property="BorderBrush" Value="#3B82F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SelectItemButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E4E4E7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#22222E"/>
                                <Setter Property="Foreground" Value="#60A5FA"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#2D2D3E"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SliderTrackDecreaseStyle" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="5" Background="#3B82F6" CornerRadius="2.5" VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SliderTrackIncreaseStyle" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="5" Background="Transparent" VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SliderThumbStyle" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse x:Name="ThumbHalo" Width="20" Height="20" Fill="#3B82F6" Opacity="0"/>
                            <Ellipse x:Name="ThumbBody" Width="14" Height="14" Fill="#FFFFFF" Stroke="#3B82F6" StrokeThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.35"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbHalo" Property="Opacity" Value="0.2"/>
                                <Setter TargetName="ThumbBody" Property="StrokeThickness" Value="2.5"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbHalo" Property="Opacity" Value="0.35"/>
                                <Setter TargetName="ThumbBody" Property="Width" Value="15"/>
                                <Setter TargetName="ThumbBody" Property="Height" Value="15"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ShadcnSliderStyle" TargetType="Slider">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="5" Background="#27272A" CornerRadius="2.5" VerticalAlignment="Center" Margin="2,0"/>
                            <Track x:Name="PART_Track" VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderTrackDecreaseStyle}" Command="{x:Static Slider.DecreaseLarge}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SliderThumbStyle}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderTrackIncreaseStyle}" Command="{x:Static Slider.IncreaseLarge}"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Slider" BasedOn="{StaticResource ShadcnSliderStyle}"/>

        <!-- Custom Modern Minimalist Dark ScrollBar (No ugly white background) -->
        <Style x:Key="ModernScrollBarThumb" TargetType="{x:Type Thumb}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="ThumbBorder"
                                Background="#3F3F46"
                                CornerRadius="2.5"
                                Width="5"
                                HorizontalAlignment="Right"
                                Margin="0,2,2,2"
                                Opacity="0.8"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#71717A"/>
                                <Setter TargetName="ThumbBorder" Property="Opacity" Value="1.0"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#3B82F6"/>
                                <Setter TargetName="ThumbBorder" Property="Opacity" Value="1.0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernScrollRepeatBtn" TargetType="{x:Type RepeatButton}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernDarkScrollBarStyle" TargetType="{x:Type ScrollBar}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Width" Value="7"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ModernScrollRepeatBtn}" Command="{x:Static ScrollBar.PageUpCommand}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ModernScrollBarThumb}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ModernScrollRepeatBtn}" Command="{x:Static ScrollBar.PageDownCommand}"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource ModernDarkScrollBarStyle}"/>
    </Window.Resources>

    <Grid HorizontalAlignment="Center" VerticalAlignment="Top">
        <!-- The Morphing Pill Container -->
        <Border x:Name="IslandContainer"
                Background="#131317"
                BorderBrush="#383844"
                BorderThickness="1.5"
                CornerRadius="19"
                Width="190" Height="38"
                SnapsToDevicePixels="True"
                UseLayoutRounding="True"
                ClipToBounds="False"
                Cursor="Hand"
                MouseEnter="OnMouseEnter"
                MouseLeave="OnMouseLeave"
                MouseLeftButtonDown="OnIslandMouseLeftButtonDown"
                MouseMove="OnIslandMouseMove"
                MouseLeftButtonUp="OnIslandMouseLeftButtonUp">
            <Border.LayoutTransform>
                <ScaleTransform x:Name="IslandScaleTransform" ScaleX="1.0" ScaleY="1.0" CenterX="0" CenterY="0"/>
            </Border.LayoutTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.65"/>
            </Border.Effect>

            <Grid Margin="10,5" ClipToBounds="False">
                <!-- COMPACT VIEW (Normal / Ambient Activity state) -->
                <Grid x:Name="CompactView" Visibility="Visible">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="CompactGlyph" Text="⚡" FontSize="12" Foreground="#3B82F6" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="CompactTitle" Text="The Hub" FontSize="11.5" FontWeight="SemiBold" Foreground="#E4E4E7" VerticalAlignment="Center" MaxWidth="125" TextTrimming="CharacterEllipsis"/>
                        <Ellipse x:Name="CompactDot" Width="6" Height="6" Fill="#10B981" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- EXPANDED VIEW (Supports both compact Notification Banner and full Dashboard controls) -->
                <Grid x:Name="ExpandedView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Row 0: Notification / Alert Banner Header -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Event Glyph/Icon -->
                        <Border Grid.Column="0" Width="30" Height="30" Background="#1B1B22" CornerRadius="8" BorderBrush="#2C2C38" BorderThickness="1" Margin="0,0,8,0" VerticalAlignment="Center">
                            <TextBlock x:Name="ExpandedGlyph" Text="🎵" FontSize="14.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Title and Subtitle -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="ExpandedTitle" Text="Audio Live" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="ExpandedSubtitle" Text="50%" FontSize="10.5" Foreground="#A1A1AA" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                        </StackPanel>

                        <!-- Header Buttons: Open The Hub & Dismiss -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnHeaderTheHub" Content="⚙ The Hub" Style="{StaticResource ActionButtonStyle}" FontSize="10" Padding="6,2" Margin="0,0,4,0" Click="OnOpenTheHubClick" ToolTip="Open The Hub Settings"/>
                            <Button x:Name="BtnDismiss" Content="✕" Style="{StaticResource ActionButtonStyle}" FontSize="9" Click="OnDismissClick" ToolTip="Dismiss" Visibility="Collapsed" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- Row 1: Full Dashboard Controls (Sliders, Devices, Mic, Deafen) -->
                    <StackPanel x:Name="DashboardControlsPanel" Grid.Row="1" Visibility="Visible" Margin="0,6,0,0" ClipToBounds="False">
                        <!-- Media Playback Controls (if media active) -->
                        <StackPanel x:Name="MediaControlsPanel" Orientation="Horizontal" HorizontalAlignment="Center" Visibility="Collapsed" Margin="0,0,0,6">
                            <Button Content="⏮" Style="{StaticResource ActionButtonStyle}" Click="OnPrevClick" ToolTip="Previous Track"/>
                            <Button x:Name="PlayPauseButton" Content="⏸" Style="{StaticResource ActionButtonStyle}" Margin="8,0" Click="OnPlayPauseClick" ToolTip="Play/Pause"/>
                            <Button Content="⏭" Style="{StaticResource ActionButtonStyle}" Click="OnNextClick" ToolTip="Next Track"/>
                        </StackPanel>

                        <!-- Live Interactive Sliders (Volume & Screen Brightness) -->
                        <Grid Margin="0,2,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Live Interactive Master Volume Slider -->
                            <Grid Grid.Row="0" Margin="2,2,2,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="36"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="BtnAudioMute" Grid.Column="0" Content="🔊" Style="{StaticResource ActionButtonStyle}" Padding="2,0" FontSize="12" Click="OnAudioMuteClick" ToolTip="Toggle Mute"/>
                                <Slider x:Name="SldVolume" Grid.Column="1" Minimum="0" Maximum="100" SmallChange="2" LargeChange="10" Value="50" VerticalAlignment="Center" Margin="6,0" Cursor="Hand"/>
                                <TextBlock x:Name="TxtVolumePercent" Grid.Column="2" Text="50%" FontSize="10.5" Foreground="#D4D4D8" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            </Grid>

                            <!-- Live Interactive Screen Brightness Slider -->
                            <Grid x:Name="BrightnessControlGrid" Grid.Row="1" Margin="2,2,2,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="36"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="☀️" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#F59E0B"/>
                                <Slider x:Name="SldBrightness" Grid.Column="1" Minimum="10" Maximum="100" SmallChange="5" LargeChange="10" Value="100" VerticalAlignment="Center" Margin="6,0" Cursor="Hand"/>
                                <TextBlock x:Name="TxtBrightnessPercent" Grid.Column="2" Text="100%" FontSize="10.5" Foreground="#D4D4D8" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            </Grid>
                        </Grid>

                        <!-- Audio Device Switchers (Shadcn SelectTriggers) -->
                        <Border x:Name="DeviceSwitcherRow" Margin="0,5,0,0" Padding="0,4,0,0" BorderThickness="0,1,0,0" BorderBrush="#22222B">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Output Device (Speaker / Headphones) -->
                                <Button x:Name="BtnOutputDevice" Grid.Column="0" Style="{StaticResource QuickPillButtonStyle}" Margin="0" Click="OnOutputDeviceClick" ToolTip="Click to select Audio Output (Speakers / Headphones)">
                                    <TextBlock x:Name="TxtOutputDevice" Text="🔊 Output: Default ▾" FontSize="10.5" TextTrimming="CharacterEllipsis"/>
                                </Button>

                                <!-- Input Device (Microphone) -->
                                <Button x:Name="BtnInputDevice" Grid.Column="2" Style="{StaticResource QuickPillButtonStyle}" Margin="0" Click="OnInputDeviceClick" ToolTip="Click to select Microphone">
                                    <TextBlock x:Name="TxtInputDevice" Text="🎙️ Mic: Default ▾" FontSize="10.5" TextTrimming="CharacterEllipsis"/>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Shadcn Select Dropdown Panel (SelectContent) -->
                        <Border x:Name="ShadcnSelectDropdown" 
                                Visibility="Collapsed" 
                                Background="#101015" 
                                BorderBrush="#2C2C38" 
                                BorderThickness="1" 
                                CornerRadius="10" 
                                Margin="0,5,0,3" 
                                Padding="5,6">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="3" Color="#000000" Opacity="0.6"/>
                            </Border.Effect>
                            <StackPanel>
                                <!-- SelectLabel / Group Header -->
                                <Grid Margin="6,2,6,4">
                                    <TextBlock x:Name="SelectGroupLabel" Text="OUTPUT DEVICES (SPEAKERS / HEADPHONES)" 
                                               FontSize="9" FontWeight="Bold" Foreground="#71717A" VerticalAlignment="Center"/>
                                    <Button Content="✕" Style="{StaticResource ActionButtonStyle}" FontSize="9" Width="18" Height="18" 
                                            HorizontalAlignment="Right" VerticalAlignment="Center" Click="OnCloseSelectDropdownClick" ToolTip="Close list"/>
                                </Grid>
                                <Separator Background="#22222E" Margin="2,0,2,3" Height="1"/>

                                <!-- SelectItems Scrollable List -->
                                <ScrollViewer MaxHeight="135" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,2,0">
                                    <StackPanel x:Name="SelectItemsList" Margin="0,1"/>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>

                        <!-- Quick Action Buttons (Mic Mute & Deafen) -->
                        <Border x:Name="QuickControlsRow" Margin="0,5,0,2" Padding="0,2,0,0">
                            <Grid x:Name="QuickButtonsGrid">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" x:Name="ColMicMute"/>
                                    <ColumnDefinition Width="6" x:Name="ColSpacing"/>
                                    <ColumnDefinition Width="*" x:Name="ColDeafen"/>
                                </Grid.ColumnDefinitions>

                                <!-- Mic Mute Button -->
                                <Button x:Name="BtnMicMute" Grid.Column="0" Style="{StaticResource QuickPillButtonStyle}" Click="OnMicMuteClick" ToolTip="Toggle Microphone Mute">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock x:Name="TxtMicIcon" Text="🎙️" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtMicLabel" Text="Mic Active" FontSize="11" FontWeight="SemiBold" Foreground="#34D399" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <!-- Deafen (Mute Audio / Speakers) Button -->
                                <Button x:Name="BtnDeafen" Grid.Column="2" Style="{StaticResource QuickPillButtonStyle}" Click="OnDeafenClick" ToolTip="Toggle Deafen (Mute Speakers / Master Audio)">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock x:Name="TxtDeafenIcon" Text="🎧" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtDeafenLabel" Text="Deafen" FontSize="11" FontWeight="SemiBold" Foreground="#E4E4E7" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- ── Workspaces Quick Launcher Trigger ─────────────────────── -->
                        <Border x:Name="WorkspaceTriggerRow"
                                Margin="0,5,0,0" Padding="0,4,0,0"
                                BorderThickness="0,1,0,0" BorderBrush="#1A1A24">
                            <Button x:Name="BtnWorkspaceTrigger"
                                    Style="{StaticResource QuickPillButtonStyle}"
                                    Click="OnWorkspaceTriggerClick"
                                    ToolTip="Quick-launch a Workspace">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="📁" FontSize="10.5" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Workspaces" FontSize="10.5" FontWeight="SemiBold"
                                               Foreground="#A1A1AA" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtWorkspaceChevron" Text=" ▾" FontSize="9"
                                               Foreground="#71717A" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Border>

                        <!-- ── Workspaces Popover (hidden by default, ZIndex=100 prevents clipping) ─────────────────── -->
                        <Border x:Name="WorkspacePopover"
                                Panel.ZIndex="100"
                                Visibility="Collapsed"
                                Background="#0D0D12"
                                BorderBrush="#252530"
                                BorderThickness="1"
                                CornerRadius="10"
                                Margin="0,4,0,0"
                                Padding="6,8">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" Direction="270" ShadowDepth="4"
                                                  Color="#000000" Opacity="0.7"/>
                            </Border.Effect>
                            <StackPanel>
                                <!-- Popover Header -->
                                <Grid Margin="4,0,4,6">
                                    <TextBlock Text="WORKSPACES" FontSize="9" FontWeight="Bold"
                                               Foreground="#52525B" VerticalAlignment="Center"/>
                                    <Button Content="✕" Style="{StaticResource ActionButtonStyle}"
                                            FontSize="9" Width="18" Height="18"
                                            HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Click="OnCloseWorkspacePopoverClick"
                                            ToolTip="Close workspace launcher"/>
                                </Grid>
                                <Separator Background="#1E1E28" Margin="2,0,2,4" Height="1"/>
                                <!-- Workspace Items -->
                                <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel x:Name="WorkspacePopoverList" Margin="0,1"/>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>

                    </StackPanel>

                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
