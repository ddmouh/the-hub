<widgets:DesktopWidgetBase x:Class="TheHub.Overlays.Widgets.DesktopRamWidget"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:widgets="clr-namespace:TheHub.Overlays.Widgets"
        Title="RAM Widget"
        Width="240" Height="80"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="False"
        ResizeMode="NoResize">

    <Border x:Name="MainBorder" Margin="4" CornerRadius="10" Background="#141419" BorderBrush="#1A2E1F" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" ShadowDepth="3" Direction="270" Color="#000000" Opacity="0.55"/>
        </Border.Effect>
        <Grid Margin="10,7,10,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="5"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,4">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⋮⋮ " FontSize="11" FontWeight="Bold" Foreground="#10B981" VerticalAlignment="Center"
                               Cursor="SizeAll" MouseDown="OnDragBarMouseDown" ToolTip="Drag to reposition"/>
                    <TextBlock Text="🎛️ MEMORY" FontSize="9.5" FontWeight="Bold" Foreground="#A7F3D0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtRamText" Text="0.0 / 0.0 GB" FontSize="9.5" Foreground="#71717A" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock x:Name="TxtRamPercent" Text="0%" FontSize="12" FontWeight="Bold" Foreground="#10B981"/>
                    <Button Content="✕" Foreground="#71717A" Background="Transparent" BorderThickness="0"
                            FontSize="9" Cursor="Hand" Padding="4,0,0,0" Click="OnCloseClick" ToolTip="Close"/>
                </StackPanel>
            </Grid>

            <ProgressBar x:Name="PbRam" Grid.Row="2" Minimum="0" Maximum="100" Height="5"
                         Foreground="#10B981" Background="#1F1F24" BorderThickness="0"/>
        </Grid>
    </Border>
</widgets:DesktopWidgetBase>
