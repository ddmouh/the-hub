<widgets:DesktopWidgetBase x:Class="TheHub.Overlays.Widgets.DesktopClockWidget"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:widgets="clr-namespace:TheHub.Overlays.Widgets"
        Title="Desktop Clock Widget"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="False"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style x:Key="WidgetToolButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#71717A"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#27272A"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer Widget Card with Customizable Glass Background and Border -->
    <Border x:Name="MainBorder" Margin="2" CornerRadius="12" Background="#D9141419" BorderBrush="#252A33" BorderThickness="1.5">
        <Border.Effect>
            <DropShadowEffect x:Name="CardShadowEffect" BlurRadius="16" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.6"/>
        </Border.Effect>

        <Grid Margin="6,4,6,4">
            <Grid.RowDefinitions>
                <!-- Top Toolbar -->
                <RowDefinition Height="22"/>
                <!-- Main Clock Face (Digital / Analog) -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Row 0: Header / Tool Row (Revealed only on mouse hover) -->
            <Grid x:Name="HeaderRow" Grid.Row="0">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Opacity" Value="0"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                <Setter Property="Opacity" Value="1"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Drag Handle & Label -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⋮⋮ " FontSize="12" FontWeight="Bold" Foreground="#00F0FF" VerticalAlignment="Center" Cursor="SizeAll" ToolTip="Click and drag to reposition"/>
                    <TextBlock x:Name="TxtHeaderLabel" Text="CYBER CLOCK" FontSize="9" FontWeight="Bold" Foreground="#71717A" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Quick Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnModeToggle" Content="Analog" Style="{StaticResource WidgetToolButton}" Click="OnModeToggleClick" ToolTip="Switch Digital / Analog" Margin="0,0,2,0"/>
                    <Button x:Name="BtnFormat" Content="24H" Style="{StaticResource WidgetToolButton}" Click="OnFormatClick" ToolTip="Toggle 24H / 12H Format" Margin="0,0,2,0"/>
                    <Button x:Name="BtnPin" Content="📌" Style="{StaticResource WidgetToolButton}" Click="OnPinClick" ToolTip="Pin behind all windows (Desktop Wallpaper mode)" Margin="0,0,2,0"/>
                    <Button Content="✕" Style="{StaticResource WidgetToolButton}" Click="OnCloseClick" ToolTip="Close Widget"/>
                </StackPanel>
            </Grid>

            <!-- Row 1: Main Clock Face (Digital vs Analog) -->
            <Grid Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                
                <!-- 1. DIGITAL CLOCK FACE -->
                <StackPanel x:Name="DigitalPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Visible">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtTimeHoursMinutes" Text="20:45" FontSize="42" FontWeight="Bold" Foreground="#00F0FF" FontFamily="Consolas">
                            <TextBlock.Effect>
                                <DropShadowEffect x:Name="HoursGlow" BlurRadius="12" ShadowDepth="0" Color="#00F0FF" Opacity="0.6"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock x:Name="TxtTimeSeconds" Text=":18" FontSize="22" FontWeight="SemiBold" Foreground="#00F0FF" FontFamily="Consolas" VerticalAlignment="Bottom" Margin="0,0,4,6">
                            <TextBlock.Effect>
                                <DropShadowEffect x:Name="SecondsGlow" BlurRadius="8" ShadowDepth="0" Color="#00F0FF" Opacity="0.5"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock x:Name="TxtTimeAmPm" Text="" FontSize="11" FontWeight="Bold" Foreground="#F43F5E" VerticalAlignment="Bottom" Margin="2,0,0,10" Visibility="Collapsed"/>
                    </StackPanel>
                </StackPanel>

                <!-- 2. ANALOG CLOCK FACE -->
                <Grid x:Name="AnalogPanel" Width="120" Height="120" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" Margin="0">
                    <!-- Dial background -->
                    <Ellipse Width="116" Height="116" Stroke="#2A2C3A" StrokeThickness="1.5" Fill="#0D0E14" x:Name="AnalogDialOuter"/>
                    <Ellipse Width="108" Height="108" Stroke="#1B1C24" StrokeThickness="1" x:Name="AnalogDialInner"/>
                    
                    <!-- 12, 3, 6, 9 Cardinal Ticks -->
                    <Canvas Width="120" Height="120" ClipToBounds="False">
                        <!-- 12 O'Clock Tick -->
                        <Rectangle Canvas.Left="58.5" Canvas.Top="7" Width="3" Height="7" Fill="#A1A1AA" RadiusX="1" RadiusY="1"/>
                        <!-- 6 O'Clock Tick -->
                        <Rectangle Canvas.Left="58.5" Canvas.Top="106" Width="3" Height="7" Fill="#71717A" RadiusX="1" RadiusY="1"/>
                        <!-- 3 O'Clock Tick -->
                        <Rectangle Canvas.Left="106" Canvas.Top="58.5" Width="7" Height="3" Fill="#71717A" RadiusX="1" RadiusY="1"/>
                        <!-- 9 O'Clock Tick -->
                        <Rectangle Canvas.Left="7" Canvas.Top="58.5" Width="7" Height="3" Fill="#71717A" RadiusX="1" RadiusY="1"/>

                        <!-- Hour Hand -->
                        <Line x:Name="HourHand" X1="60" Y1="60" X2="60" Y2="34" Stroke="#FFFFFF" StrokeThickness="3.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                            <Line.RenderTransform>
                                <RotateTransform x:Name="HourHandTransform" CenterX="60" CenterY="60"/>
                            </Line.RenderTransform>
                        </Line>

                        <!-- Minute Hand -->
                        <Line x:Name="MinuteHand" X1="60" Y1="60" X2="60" Y2="20" Stroke="#E4E4E7" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                            <Line.RenderTransform>
                                <RotateTransform x:Name="MinuteHandTransform" CenterX="60" CenterY="60"/>
                            </Line.RenderTransform>
                        </Line>

                        <!-- Second Hand -->
                        <Line x:Name="SecondHand" X1="60" Y1="68" X2="60" Y2="14" Stroke="#00F0FF" StrokeThickness="1.2">
                            <Line.RenderTransform>
                                <RotateTransform x:Name="SecondHandTransform" CenterX="60" CenterY="60"/>
                            </Line.RenderTransform>
                        </Line>

                        <!-- Center Pivot Cap -->
                        <Ellipse Canvas.Left="56.5" Canvas.Top="56.5" Width="7" Height="7" Fill="#00F0FF" x:Name="AnalogCenterPivot"/>
                    </Canvas>
                </Grid>

            </Grid>
        </Grid>
    </Border>
</widgets:DesktopWidgetBase>
