<Window x:Class="TheHub.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TheHub.App.Controls"
        Title="The Hub — Desktop Companion"
        Height="680" Width="980"
        MinHeight="560" MinWidth="840"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="#0B0B0D"
        Foreground="#E4E4E7"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="1"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Modern Dark Styles -->
        <Style x:Key="NavButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A1A1AA"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="12,0">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#18181B"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#27272A"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2563EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#18181B"/>
            <Setter Property="Foreground" Value="#E4E4E7"/>
            <Setter Property="BorderBrush" Value="#27272A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#27272A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#7F1D1D"/>
            <Setter Property="Foreground" Value="#FECACA"/>
            <Setter Property="BorderBrush" Value="#991B1B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#991B1B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#18181B"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#27272A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="CaretBrush" Value="#3B82F6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" Margin="0,1"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#3B82F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SmallActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#27272A"/>
            <Setter Property="Foreground" Value="#E4E4E7"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="9,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3F3F46"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Icon Selector Box (matching screenshot style) -->
        <Style x:Key="IconSelectorButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#18181B"/>
            <Setter Property="BorderBrush" Value="#27272A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Width" Value="56"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="ToolTip" Value="Click to choose an icon from the gallery"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#3B82F6"/>
                                <Setter TargetName="bd" Property="Background" Value="#222226"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Category Chip Style for Icon Picker -->
        <Style x:Key="CategoryChipButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="#18181B"/>
            <Setter Property="Foreground" Value="#A1A1AA"/>
            <Setter Property="BorderBrush" Value="#27272A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="chip" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="chip" Property="BorderBrush" Value="#3F3F46"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="chip" Property="Background" Value="#3B82F6"/>
                                <Setter TargetName="chip" Property="BorderBrush" Value="#3B82F6"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- MODERN TOGGLE SWITCH STYLE -->
        <Style x:Key="ModernToggleSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#E4E4E7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <Border x:Name="Track" Grid.Column="1" Width="40" Height="22" CornerRadius="11" Background="#242429" BorderBrush="#383842" BorderThickness="1">
                                <Ellipse x:Name="Thumb" Width="16" Height="16" Fill="#8E8E98" HorizontalAlignment="Left" Margin="2,0,0,0"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#3B82F6"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="#60A5FA"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="#FFFFFF"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,2,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- SEGMENTED RADIO BUTTON STYLE (Rovyl Pill Controls) -->
        <Style x:Key="SegmentedRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1E1E24"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2A2A34"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#3F3F4E"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- SUB NAV RADIO BUTTON STYLE (For Tab Bar inside settings) -->
        <Style x:Key="SubNavRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#71717A"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#D4D4D8"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#3B82F6"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- COLOR DOT BUTTON STYLE (Fast Accent Color Selector) -->
        <Style x:Key="ColorDotButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="12" Background="{TemplateBinding Background}" BorderBrush="#3F3F46" BorderThickness="1.5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- SLEEK DARK COMBOBOX STYLE -->
        <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
            <Border x:Name="border" Background="#18181D" BorderBrush="#2F2F3B" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="32" />
                    </Grid.ColumnDefinitions>
                    <Path x:Name="Arrow" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 0 0 L 4 4 L 8 0 Z" Fill="#A1A1AA" Margin="0,1,0,0"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="true">
                    <Setter TargetName="border" Property="BorderBrush" Value="#4F46E5"/>
                    <Setter TargetName="border" Property="Background" Value="#22222B"/>
                    <Setter TargetName="Arrow" Property="Fill" Value="#FFFFFF"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#F4F4F5"/>
            <Setter Property="Background" Value="#18181D"/>
            <Setter Property="BorderBrush" Value="#2F2F3B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Template="{StaticResource ComboBoxToggleButton}" Focusable="false" IsChecked="{Binding Path=IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press"/>
                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="12,3,32,3" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Grid x:Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder" Background="#18181D" BorderBrush="#2F2F3B" BorderThickness="1" CornerRadius="8" Margin="0,4,0,0">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="14" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.55"/>
                                        </Border.Effect>
                                        <ScrollViewer Margin="4,6" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#E4E4E7"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#292934"/>
                                <Setter Property="Foreground" Value="#60A5FA"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#3B82F6"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Title Bar -->
            <RowDefinition Height="42"/>
            <!-- Main Body -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOP BAR (Custom Window Header) -->
        <Border Grid.Row="0" Height="42" Background="#0F0F11" BorderBrush="#1C1C1F" BorderThickness="0,0,0,1">
            <Grid Margin="16,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand / Status -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="22" Height="22" Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="6" Margin="0,0,10,0">
                        <TextBlock Text="⚡" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#3B82F6"/>
                    </Border>
                    <TextBlock Text="THE HUB" FontWeight="Bold" FontSize="12.5" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Border Background="#10B98120" BorderBrush="#10B981" BorderThickness="1" CornerRadius="10" Padding="6,1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="5" Height="5" Fill="#10B981" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="Core Active" FontSize="10" Foreground="#10B981" FontWeight="Medium"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Title Drag area -->
                <TextBlock Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Text="Desktop Companion v0.1" FontSize="11" Foreground="#71717A"/>

                <!-- Window Control Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                    <TextBlock x:Name="RamUsageText" Text="RAM: ~50 MB" FontSize="11" Foreground="#A1A1AA" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <Button Content="—" Style="{StaticResource SecondaryButtonStyle}" Padding="10,2" Margin="0,0,4,0" Click="OnMinimizeClick" ToolTip="تصغير (Minimize)" WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Content="▢" Style="{StaticResource SecondaryButtonStyle}" Padding="10,2" Margin="0,0,4,0" Click="OnMaximizeClick" ToolTip="تكبير / استعادة (Maximize / Restore)" WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Content="✕" Style="{StaticResource SecondaryButtonStyle}" Padding="10,2" Click="OnCloseButtonClick" ToolTip="إغلاق بالكامل (Close)" WindowChrome.IsHitTestVisibleInChrome="True"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN CONTENT AREA -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Sidebar -->
                <ColumnDefinition Width="220"/>
                <!-- Page Content -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- SIDEBAR -->
            <Border Grid.Column="0" Background="#0E0E10" BorderBrush="#1C1C1F" BorderThickness="0,0,1,0" Padding="12,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="NAVIGATION" FontSize="10.5" FontWeight="Bold" Foreground="#52525B" Margin="10,0,0,10"/>
                        
                        <RadioButton Content="⚡  Overview" Style="{StaticResource NavButtonStyle}" IsChecked="True" Checked="OnNavChecked" Tag="0"/>
                        <RadioButton Content="📁  Workspaces" Style="{StaticResource NavButtonStyle}" Checked="OnNavChecked" Tag="1"/>
                        <RadioButton Content="🎯  Radial Launcher" Style="{StaticResource NavButtonStyle}" Checked="OnNavChecked" Tag="2"/>
                        <RadioButton Content="🏝️  Dynamic Island" Style="{StaticResource NavButtonStyle}" Checked="OnNavChecked" Tag="3"/>
                        <RadioButton Content="🤖  AI Assistant" Style="{StaticResource NavButtonStyle}" Checked="OnNavChecked" Tag="4"/>
                        <RadioButton Content="🛡️  Permissions &amp; Safety" Style="{StaticResource NavButtonStyle}" Checked="OnNavChecked" Tag="5"/>
                    </StackPanel>

                    <!-- Bottom Quick Actions -->
                    <Border Grid.Row="1" Background="#141416" BorderBrush="#27272A" BorderThickness="1" CornerRadius="10" Padding="12">
                        <StackPanel>
                            <TextBlock Text="EMERGENCY" FontSize="10" FontWeight="Bold" Foreground="#EF4444"/>
                            <TextBlock Text="Instantly suspend AI &amp; Overlays" FontSize="10.5" Foreground="#71717A" Margin="0,2,0,8" TextWrapping="Wrap"/>
                            <Button x:Name="EmergencyButton" Content="Kill Switch" Style="{StaticResource DangerButtonStyle}" Click="OnEmergencyKillClick"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- CONTENT PAGES (TabControl / Panels) -->
            <Grid Grid.Column="1" Margin="24">

                <!-- TAB 0: OVERVIEW & WALLPAPERS -->
                <Grid x:Name="PageOverview" Visibility="Visible">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,10,20">
                            <!-- Header Bar with Add Wallpaper Button -->
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="System Overview &amp; Wallpapers" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    <TextBlock Text="Add live animated video or static high-resolution wallpapers to your Windows desktop environment." FontSize="12.5" Foreground="#71717A" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="+ Add Wallpaper" Style="{StaticResource PrimaryButtonStyle}" Click="OnAddWallpaperClick" VerticalAlignment="Center" Padding="16,8" FontSize="13" FontWeight="SemiBold" ToolTip="Add an animated video (MP4, WebM, GIF) or static image (JPG, PNG)"/>
                            </Grid>

                            <!-- Wallpaper Options Toolbar -->
                            <Border Background="#141417" BorderBrush="#222228" BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <CheckBox x:Name="ChkPauseWallpaperFullscreen" Content="Auto-pause animated wallpapers in games &amp; fullscreen" Foreground="#E4E4E7" FontSize="12" Margin="0,0,24,0" Checked="OnWallpaperSettingChanged" Unchecked="OnWallpaperSettingChanged" ToolTip="Completely stops live video graphics and CPU/GPU usage when full-screen apps or games run"/>
                                        <CheckBox x:Name="ChkMuteWallpaperAudio" Content="Mute live wallpaper sound" Foreground="#E4E4E7" FontSize="12" Margin="0,0,20,0" Checked="OnWallpaperMuteChanged" Unchecked="OnWallpaperMuteChanged"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="⟲ Reset Windows Wallpaper" Style="{StaticResource SmallActionButtonStyle}" Click="OnResetWallpaperClick" ToolTip="Stop live video wallpaper, clear WorkerW, and restore standard desktop"/>
                                </Grid>
                            </Border>

                            <!-- Multi-Monitor Selector Card (Display Layout matching Windows Settings) -->
                            <Border Background="#141418" BorderBrush="#27272E" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,0,0,20">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="🖥️" FontSize="14" Margin="0,0,6,0"/>
                                                <TextBlock Text="TARGET DISPLAY &amp; MULTI-MONITOR ASSIGNMENT" FontSize="11.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                                            </StackPanel>
                                            <TextBlock Text="Select target display for wallpaper application: Individual (per-display) or Duplicate (across all connected displays)." FontSize="11" Foreground="#71717A" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="🔄 Refresh Displays" Style="{StaticResource SmallActionButtonStyle}" Click="OnRefreshDisplaysClick" Margin="0,0,8,0" ToolTip="Detect newly connected monitors"/>
                                            <Button Content="🛑 Clear Display Wallpaper" Style="{StaticResource SmallActionButtonStyle}" Foreground="#F87171" Click="OnClearCurrentDisplayWallpaperClick" ToolTip="Clear and reset wallpaper on the selected display target"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Display Buttons Row (mini-monitors) -->
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                        <StackPanel x:Name="MonitorSelectorPanel" Orientation="Horizontal" Margin="0,4,0,4"/>
                                    </ScrollViewer>

                                    <!-- Current Target Status Indicator -->
                                    <Border Background="#0E0E12" BorderBrush="#1F1F26" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,10,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="Active Target:" FontSize="11.5" FontWeight="Medium" Foreground="#A1A1AA" Margin="0,0,6,0"/>
                                                <TextBlock x:Name="TxtSelectedTargetDisplay" Text="All Displays (Duplicate Mode)" FontSize="11.5" FontWeight="Bold" Foreground="#3B82F6"/>
                                            </StackPanel>
                                            <TextBlock x:Name="TxtCurrentTargetWallpaperStatus" Grid.Column="1" Text="Wallpaper: None" FontSize="11" Foreground="#71717A" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Section Title -->
                            <TextBlock Text="YOUR WALLPAPERS" FontSize="11" FontWeight="Bold" Foreground="#71717A" Margin="0,0,0,12"/>

                            <!-- Empty State Card -->
                            <Border x:Name="WallpaperEmptyPrompt" Visibility="Collapsed" Background="#0F0F12" BorderBrush="#27272A" BorderThickness="1" CornerRadius="14" Padding="32" Margin="0,0,0,16">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="🎬" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                    <TextBlock Text="No Wallpapers Added Yet" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Click '+ Add Wallpaper' to select any animated video (MP4, WebM, GIF) or high-res image (PNG, JPG)." FontSize="12" Foreground="#71717A" HorizontalAlignment="Center" Margin="0,6,0,16" TextAlignment="Center"/>
                                    <Button Content="+ Add Wallpaper" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Center" Padding="16,8" Click="OnAddWallpaperClick"/>
                                </StackPanel>
                            </Border>

                            <!-- Wallpaper Cards Grid -->
                            <ItemsControl x:Name="WallpapersGalleryControl">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="220" Height="185" Margin="0,0,14,14"
                                                Background="#141418"
                                                BorderBrush="{Binding CardBorderBrush}"
                                                BorderThickness="1.5"
                                                CornerRadius="14">
                                            <Grid Margin="12">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="95"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>

                                                <!-- Top Visual / Badge Box -->
                                                <Border Grid.Row="0" Background="#1C1C22" BorderBrush="#2A2A34" BorderThickness="1" CornerRadius="10" Padding="8">
                                                    <Grid>
                                                        <TextBlock Text="🎞️" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5"/>
                                                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="{Binding TypeBadgeBackground}" CornerRadius="4" Padding="6,2">
                                                            <TextBlock Text="{Binding TypeBadgeText}" FontSize="9.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>

                                                <!-- Bottom Details & Actions -->
                                                <Grid Grid.Row="1" Margin="0,8,0,0">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Grid.Row="0" Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" ToolTip="{Binding FilePath}"/>
                                                    
                                                    <Grid Grid.Row="1" Margin="0,6,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Button Grid.Column="0" Content="{Binding StatusText}" Style="{StaticResource SmallActionButtonStyle}" Background="{Binding StatusBackground}" Foreground="#FFFFFF" Tag="{Binding}" Click="OnApplyWallpaperCardClick" Margin="0,0,6,0"/>
                                                        <Button Grid.Column="1" Content="🗑️" Style="{StaticResource SmallActionButtonStyle}" Foreground="#F87171" Tag="{Binding}" Click="OnDeleteWallpaperCardClick" ToolTip="Delete this wallpaper"/>
                                                    </Grid>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- TAB 1: WORKSPACES & CATEGORIES -->
                <Grid x:Name="PageWorkspaces" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,10,20">
                            <!-- Header Bar -->
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Workspaces &amp; Environments (Batch Launcher)" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    <TextBlock Text="Customize environment profiles to launch multiple applications simultaneously with one click. Independent of the Radial Wheel." FontSize="12.5" Foreground="#71717A" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="+ New Workspace" Style="{StaticResource PrimaryButtonStyle}" Click="OnOpenAddWorkspaceClick" VerticalAlignment="Center" Padding="14,8"/>
                            </Grid>

                            <!-- NEW WORKSPACE FORM CARD (COLLAPSIBLE) -->
                            <Border x:Name="NewWorkspaceCard" Visibility="Collapsed" Background="#141416" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Create New Workspace Category" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,12"/>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="100"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Text="Name" FontSize="11" Foreground="#A1A1AA" Margin="0,0,0,4"/>
                                            <TextBox x:Name="NewWsNameBox" Style="{StaticResource ModernTextBoxStyle}" Text="Streaming"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                            <TextBlock Text="Icon" FontSize="11" Foreground="#A1A1AA" Margin="0,0,0,4"/>
                                            <Button x:Name="NewWsIconBtn" Content="📁" Style="{StaticResource IconSelectorButtonStyle}" Click="OnOpenIconPickerForNewWsClick"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Accent Color" FontSize="11" Foreground="#A1A1AA" Margin="0,0,0,4"/>
                                            <TextBox x:Name="NewWsColorBox" Style="{StaticResource ModernTextBoxStyle}" Text="#8B5CF6"/>
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Margin="0,0,0,14">
                                        <TextBlock Text="Description" FontSize="11" Foreground="#A1A1AA" Margin="0,0,0,4"/>
                                        <TextBox x:Name="NewWsDescBox" Style="{StaticResource ModernTextBoxStyle}" Text="Streaming setup with OBS, microphone tools, and chat overlay."/>
                                    </StackPanel>
                                    <WrapPanel>
                                        <Button Content="Create Workspace" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" Click="OnSaveNewWorkspaceClick"/>
                                        <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Click="OnCancelNewWorkspaceClick"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- WORKSPACE DETAIL & APP MANAGEMENT PANEL (COLLAPSIBLE) -->
                            <Border x:Name="WorkspaceDetailPanel" Visibility="Collapsed" Background="#141416" BorderBrush="#3B82F6" BorderThickness="1.5" CornerRadius="12" Padding="18" Margin="0,0,0,18">
                                <StackPanel>
                                    <!-- Detail Header with Close Button -->
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="34" Height="34" Background="#1C1C20" BorderBrush="#27272A" BorderThickness="1" CornerRadius="8" Margin="0,0,10,0">
                                                <TextBlock x:Name="DetailWsIconBlock" Text="🎮" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock x:Name="DetailWsTitleBlock" Text="Gaming" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                    <Border x:Name="DetailWsBadgeBorder" Background="#EF4444" CornerRadius="6" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock x:Name="DetailWsColorBadge" Text="Active Category" FontSize="10" Foreground="#FFFFFF" FontWeight="SemiBold"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock x:Name="DetailWsSubtitleBlock" Text="2 configured applications" FontSize="11" Foreground="#71717A"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Prominent Close Button to Collapse Panel Anytime -->
                                        <Button Grid.Column="1" Content="✕ Close Panel" Style="{StaticResource SecondaryButtonStyle}" Padding="12,6" Click="OnCloseWorkspaceDetailClick" ToolTip="Close and hide management panel"/>
                                    </Grid>

                                    <!-- Section 1: Quick Workspace Settings -->
                                    <Border Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,16">
                                        <StackPanel>
                                            <TextBlock Text="CATEGORY SETTINGS" FontSize="11" FontWeight="Bold" Foreground="#71717A" Margin="0,0,0,10"/>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="100"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                    <TextBlock Text="Name" FontSize="11" Foreground="#A1A1AA" Margin="0,0,0,3"/>
                                                    <TextBox x:Name="DetailWsNameBox" Style="{StaticResource ModernTextBoxStyle}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                                    <TextBlock Text="Icon" FontSize="11" Foreground="#A1A1AA" Margin="0,0,0,3"/>
                                                    <Button x:Name="DetailWsIconBtn" Content="🎮" Style="{StaticResource IconSelectorButtonStyle}" Click="OnOpenIconPickerForDetailWsClick"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="Color" FontSize="11" Foreground="#A1A1AA" Margin="0,0,0,3"/>
                                                    <TextBox x:Name="DetailWsColorBox" Style="{StaticResource ModernTextBoxStyle}"/>
                                                </StackPanel>
                                            </Grid>

                                            <StackPanel Margin="0,0,0,10">
                                                <TextBlock Text="Description" FontSize="11" Foreground="#A1A1AA" Margin="0,0,0,3"/>
                                                <TextBox x:Name="DetailWsDescBox" Style="{StaticResource ModernTextBoxStyle}"/>
                                            </StackPanel>

                                            <WrapPanel Margin="0,0,0,10">
                                                <CheckBox x:Name="DetailWsPauseWallpapers" Content="Pause animated wallpapers" Foreground="#E4E4E7" FontSize="11.5" Margin="0,0,16,6"/>
                                                <CheckBox x:Name="DetailWsDoNotDisturb" Content="Enable Do Not Disturb" Foreground="#E4E4E7" FontSize="11.5" Margin="0,0,16,6"/>
                                            </WrapPanel>

                                            <Button Content="Save Category Settings" Style="{StaticResource SmallActionButtonStyle}" HorizontalAlignment="Left" Click="OnUpdateWorkspaceSettingsClick"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Section 2: Applications in this Workspace -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="APPLICATIONS IN THIS CATEGORY" FontSize="11" FontWeight="Bold" Foreground="#71717A" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Content="+ Add Application" Style="{StaticResource PrimaryButtonStyle}" Padding="10,4" FontSize="11.5" Click="OnOpenAddAppClick"/>
                                    </Grid>

                                    <!-- Apps List -->
                                    <ItemsControl x:Name="WorkspaceAppsItemsControl">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="32"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- App Icon -->
                                                        <Border Grid.Column="0" Width="26" Height="26" Background="#27272A" CornerRadius="6" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding IconGlyph}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>

                                                        <!-- App Details -->
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,10,0">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding ExecutablePath}" FontFamily="Consolas, monospace" FontSize="11" Foreground="#9CA3AF" TextTrimming="CharacterEllipsis" ToolTip="{Binding ExecutablePath}" Margin="0,1,0,0"/>
                                                        </StackPanel>

                                                        <!-- App Actions -->
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Button Content="▶ Test" Style="{StaticResource SmallActionButtonStyle}" Margin="0,0,4,0" Tag="{Binding}" Click="OnTestSingleAppClick" ToolTip="Test run this app"/>
                                                            <Button Content="✏️ Edit" Style="{StaticResource SmallActionButtonStyle}" Margin="0,0,4,0" Tag="{Binding}" Click="OnEditSingleAppClick" ToolTip="Edit app path and options"/>
                                                            <Button Content="✕ Remove" Style="{StaticResource SmallActionButtonStyle}" Foreground="#F87171" Tag="{Binding}" Click="OnDeleteSingleAppClick" ToolTip="Remove app from this category"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Sub-card 3: App Add / Edit Form Card -->
                                    <Border x:Name="AppEditorCard" Visibility="Collapsed" Background="#1C1C22" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,10,0,0">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="AppEditorTitleBlock" Text="Add Application" FontSize="13" FontWeight="Bold" Foreground="#3B82F6" VerticalAlignment="Center"/>
                                                <Button Grid.Column="1" Content="⚡ Pick from Installed Apps..." Style="{StaticResource PrimaryButtonStyle}" Padding="12,5" FontSize="11.5" Click="OnOpenInstalledAppsClick" ToolTip="Scan PC and pick installed application automatically"/>
                                            </Grid>

                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                    <TextBlock Text="Application Title" FontSize="11" Foreground="#A1A1AA" Margin="0,0,0,3"/>
                                                    <TextBox x:Name="AppTitleBox" Style="{StaticResource ModernTextBoxStyle}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="Icon" FontSize="11" Foreground="#A1A1AA" Margin="0,0,0,3"/>
                                                    <Button x:Name="AppIconBtn" Content="⚡" Style="{StaticResource IconSelectorButtonStyle}" Click="OnOpenIconPickerForAppClick"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Path input with Browse button -->
                                            <StackPanel Margin="0,0,0,8">
                                                <TextBlock Text="Executable Path or Command (e.g. discord.exe or full path to .exe)" FontSize="11" Foreground="#A1A1AA" Margin="0,0,0,3"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="AppPathBox" Grid.Column="0" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,8,0"/>
                                                    <Button Grid.Column="1" Content="📁 Browse .exe..." Style="{StaticResource SecondaryButtonStyle}" Padding="10,5" FontSize="11.5" Click="OnBrowseExecutableClick"/>
                                                </Grid>
                                            </StackPanel>

                                            <!-- Arguments input -->
                                            <StackPanel Margin="0,0,0,12">
                                                <TextBlock Text="Arguments (Optional, e.g. --start-minimized)" FontSize="11" Foreground="#A1A1AA" Margin="0,0,0,3"/>
                                                <TextBox x:Name="AppArgsBox" Style="{StaticResource ModernTextBoxStyle}"/>
                                            </StackPanel>

                                            <!-- Save & Cancel buttons -->
                                            <WrapPanel>
                                                <Button Content="Save Application" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" Click="OnSaveAppClick"/>
                                                <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Click="OnCancelAppEditorClick"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- ACTIVE WORKSPACES CARDS LIST -->
                            <TextBlock Text="ALL CATEGORIES" FontSize="11" FontWeight="Bold" Foreground="#71717A" Margin="0,4,0,10"/>
                            <ItemsControl x:Name="WorkspacesListControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#141416" BorderBrush="#27272A" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" Width="44" Height="44" Background="#1C1C20" BorderBrush="#2E2E33" BorderThickness="1" CornerRadius="10" Margin="0,0,14,0">
                                                    <TextBlock Text="{Binding IconGlyph}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                                        <Border Background="#27272A" CornerRadius="6" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Apps.Count, StringFormat='{}{0} apps'}" FontSize="10.5" Foreground="#A1A1AA"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#71717A" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>

                                                <!-- Action Buttons -->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="Launch" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,6,0" Tag="{Binding}" Click="OnLaunchWorkspaceClick" ToolTip="Launch all apps in this category"/>
                                                    <Button Content="⚙️ Manage &amp; Apps" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0" Tag="{Binding}" Click="OnManageWorkspaceClick" ToolTip="Customize category and manage applications"/>
                                                    <Button Content="🗑️" Style="{StaticResource DangerButtonStyle}" Padding="10,7" Tag="{Binding}" Click="OnDeleteWorkspaceClick" ToolTip="Delete this category"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- TAB 2: RADIAL LAUNCHER STUDIO -->
                <Grid x:Name="PageRadial" Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- Header & Action Buttons -->
                            <RowDefinition Height="Auto"/>
                            <!-- Sub Tabs Selector -->
                            <RowDefinition Height="Auto"/>
                            <!-- Active Sub Tab Content -->
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Radial Wheel Studio" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF"/>
                                <TextBlock Text="Configure triggers, gestures, visual metrics, workspaces editor, and high-performance settings." FontSize="12" Foreground="#71717A" Margin="0,3,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="▶ Test Wheel" Style="{StaticResource PrimaryButtonStyle}" Padding="14,7" Margin="0,0,8,0" Click="OnTestRadialClick" ToolTip="Instantly summon radial wheel under current mouse cursor"/>
                                <Button Content="💾 Save Settings" Style="{StaticResource SecondaryButtonStyle}" Padding="12,7" Click="OnSaveRadialSettingsClick" ToolTip="Save all radial wheel settings to disk"/>
                            </StackPanel>
                        </Grid>

                        <!-- Sub Tabs Navigation (Rovyl Style) -->
                        <Border Grid.Row="1" Background="#111114" BorderBrush="#1F1F24" BorderThickness="1" CornerRadius="8" Padding="4" Margin="0,0,0,16">
                            <UniformGrid Columns="4">
                                <RadioButton x:Name="TabBtnActivation" Content="⚡ Activation" Style="{StaticResource SubNavRadioButtonStyle}" IsChecked="True" Checked="OnRadialSubTabChanged" Tag="0"/>
                                <RadioButton x:Name="TabBtnAppearance" Content="🎨 Appearance" Style="{StaticResource SubNavRadioButtonStyle}" Checked="OnRadialSubTabChanged" Tag="1"/>
                                <RadioButton x:Name="TabBtnWorkspaces" Content="🎯 Wheel Slices" Style="{StaticResource SubNavRadioButtonStyle}" Checked="OnRadialSubTabChanged" Tag="2"/>
                                <RadioButton x:Name="TabBtnAdvanced" Content="⚙️ Advanced" Style="{StaticResource SubNavRadioButtonStyle}" Checked="OnRadialSubTabChanged" Tag="3"/>
                            </UniformGrid>
                        </Border>

                        <!-- Sub Tab Panels Container -->
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,-6,0">
                            <StackPanel Margin="0,0,6,16">

                                <!-- ======================================================== -->
                                <!-- 2. ACTIVATION PANEL                                      -->
                                <!-- ======================================================== -->
                                <StackPanel x:Name="SubPanelActivation" Visibility="Visible">

                                    <!-- Global Shortcut (Keyboard) -->
                                    <Border Background="#141417" BorderBrush="#222228" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,14">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                                <TextBlock Text="Global Shortcut (Keyboard)" FontSize="13.5" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                                <TextBlock Text="Capture hotkey or single key (e.g. Alt+Z, Alt+Space, X) registered globally across Windows." FontSize="11.5" Foreground="#71717A" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBox x:Name="TxtGlobalShortcut" Text="Alt+Z" Style="{StaticResource ModernTextBoxStyle}" Width="110" TextAlignment="Center" FontWeight="SemiBold" PreviewKeyDown="OnShortcutTextBoxPreviewKeyDown" Margin="0,0,8,0" ToolTip="Click and press keys to record new hotkey"/>
                                                <Button Content="Record" Style="{StaticResource SmallActionButtonStyle}" Padding="10,6" Click="OnRecordShortcutClick" ToolTip="Listen to next pressed key combination"/>
                                                <Button Content="Reset" Style="{StaticResource SmallActionButtonStyle}" Padding="8,6" Margin="4,0,0,0" Click="OnResetShortcutClick" ToolTip="Reset to Alt+Z"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Mouse Trigger Switch -->
                                    <Border Background="#141417" BorderBrush="#222228" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,14">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                                <TextBlock Text="Mouse Trigger" FontSize="13.5" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                                <TextBlock Text="Enable or disable invoking the radial wheel via physical mouse buttons." FontSize="11.5" Foreground="#71717A" Margin="0,3,0,0"/>
                                            </StackPanel>
                                            <CheckBox x:Name="ChkMouseTrigger" Grid.Column="1" Style="{StaticResource ModernToggleSwitch}" IsChecked="True" Checked="OnMouseTriggerToggled" Unchecked="OnMouseTriggerToggled"/>
                                        </Grid>
                                    </Border>

                                    <!-- Trigger Button Segmented Control -->
                                    <Border Background="#141417" BorderBrush="#222228" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,14">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                                <TextBlock Text="Trigger Button" FontSize="13.5" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                                <TextBlock Text="Select dedicated button without interfering with primary Windows clicks (Left/Right)." FontSize="11.5" Foreground="#71717A" Margin="0,3,0,0"/>
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="#18181D" BorderBrush="#2A2A33" BorderThickness="1" CornerRadius="8" Padding="3" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <RadioButton x:Name="RbTriggerWheel" Content="Wheel (Middle)" Style="{StaticResource SegmentedRadioButtonStyle}" IsChecked="True" Checked="OnTriggerButtonChanged" Tag="Middle"/>
                                                    <RadioButton x:Name="RbTriggerBack" Content="Back (Side 1)" Style="{StaticResource SegmentedRadioButtonStyle}" Checked="OnTriggerButtonChanged" Tag="Back"/>
                                                    <RadioButton x:Name="RbTriggerForward" Content="Forward (Side 2)" Style="{StaticResource SegmentedRadioButtonStyle}" Checked="OnTriggerButtonChanged" Tag="Forward"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- Gesture Behavior -->
                                    <Border Background="#141417" BorderBrush="#222228" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,14">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                                <TextBlock Text="Gesture Behavior" FontSize="13.5" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                                <TextBlock Text="Click to Toggle (stays open until chosen) or Hold-and-Release (launches upon finger lift)." FontSize="11.5" Foreground="#71717A" Margin="0,3,0,0"/>
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="#18181D" BorderBrush="#2A2A33" BorderThickness="1" CornerRadius="8" Padding="3" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <RadioButton x:Name="RbGestureHold" Content="Hold (Flick &amp; Release)" Style="{StaticResource SegmentedRadioButtonStyle}" IsChecked="True" Checked="OnGestureBehaviorChanged" Tag="Hold"/>
                                                    <RadioButton x:Name="RbGestureClick" Content="Click (Stay Open)" Style="{StaticResource SegmentedRadioButtonStyle}" Checked="OnGestureBehaviorChanged" Tag="Click"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- Activation Zone (Deadzone Position Slider) -->
                                    <Border Background="#141417" BorderBrush="#222228" BorderThickness="1" CornerRadius="10" Padding="16">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Activation Zone (Deadzone)" FontSize="13.5" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                                    <TextBlock Text="Minimum distance from center before selection confirms, preventing accidental triggers." FontSize="11.5" Foreground="#71717A" Margin="0,3,0,0"/>
                                                </StackPanel>
                                                <TextBlock x:Name="TxtActivationZoneValue" Grid.Column="1" Text="60 px" FontSize="13" FontWeight="Bold" Foreground="#3B82F6" VerticalAlignment="Center"/>
                                            </Grid>
                                            <Slider x:Name="SldActivationZone" Minimum="20" Maximum="120" Value="60" SmallChange="1" LargeChange="10" ValueChanged="OnActivationZoneValueChanged" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- ======================================================== -->
                                <!-- 3. APPEARANCE PANEL                                      -->
                                <!-- ======================================================== -->
                                <StackPanel x:Name="SubPanelAppearance" Visibility="Collapsed">

                                    <!-- Rovyl Surfaces (Theme) -->
                                    <Border Background="#141417" BorderBrush="#222228" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,14">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                                <TextBlock Text="Rovyl Surfaces (Theme)" FontSize="13.5" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                                <TextBlock Text="Settings &amp; controls surface theme. The floating radial wheel remains sleek dark." FontSize="11.5" Foreground="#71717A" Margin="0,3,0,0"/>
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="#18181D" BorderBrush="#2A2A33" BorderThickness="1" CornerRadius="8" Padding="3" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <RadioButton x:Name="RbThemeBlack" Content="Black (Zenith)" Style="{StaticResource SegmentedRadioButtonStyle}" IsChecked="True" Checked="OnAppearanceThemeChanged" Tag="Black"/>
                                                    <RadioButton x:Name="RbThemeWhite" Content="White (Clean)" Style="{StaticResource SegmentedRadioButtonStyle}" Checked="OnAppearanceThemeChanged" Tag="White"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- Orbital Radius Slider -->
                                    <Border Background="#141417" BorderBrush="#222228" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,14">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Orbital Radius" FontSize="13.5" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                                    <TextBlock Text="Controls the orbit distance of floating tiles from the center hub." FontSize="11.5" Foreground="#71717A" Margin="0,3,0,0"/>
                                                </StackPanel>
                                                <TextBlock x:Name="TxtOrbitalRadiusValue" Grid.Column="1" Text="150 px" FontSize="13" FontWeight="Bold" Foreground="#3B82F6" VerticalAlignment="Center"/>
                                            </Grid>
                                            <Slider x:Name="SldOrbitalRadius" Minimum="90" Maximum="220" Value="150" SmallChange="2" LargeChange="10" ValueChanged="OnOrbitalRadiusValueChanged"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Center Hub Size Slider -->
                                    <Border Background="#141417" BorderBrush="#222228" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,14">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Center Hub Size (Logo Disc)" FontSize="13.5" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                                    <TextBlock Text="Controls the visual radius and scale of the central logo disc." FontSize="11.5" Foreground="#71717A" Margin="0,3,0,0"/>
                                                </StackPanel>
                                                <TextBlock x:Name="TxtCenterHubSizeValue" Grid.Column="1" Text="60 px" FontSize="13" FontWeight="Bold" Foreground="#3B82F6" VerticalAlignment="Center"/>
                                            </Grid>
                                            <Slider x:Name="SldCenterHubSize" Minimum="30" Maximum="95" Value="60" SmallChange="1" LargeChange="5" ValueChanged="OnCenterHubSizeValueChanged"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Icon Size Slider -->
                                    <Border Background="#141417" BorderBrush="#222228" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,14">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Icon Size" FontSize="13.5" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                                    <TextBlock Text="Visual scale of application icons and glass tiles on the wheel." FontSize="11.5" Foreground="#71717A" Margin="0,3,0,0"/>
                                                </StackPanel>
                                                <TextBlock x:Name="TxtIconSizeValue" Grid.Column="1" Text="64 px" FontSize="13" FontWeight="Bold" Foreground="#3B82F6" VerticalAlignment="Center"/>
                                            </Grid>
                                            <Slider x:Name="SldIconSize" Minimum="36" Maximum="92" Value="64" SmallChange="1" LargeChange="4" ValueChanged="OnIconSizeValueChanged"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Target Spacing Slider -->
                                    <Border Background="#141417" BorderBrush="#222228" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,14">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Target Spacing" FontSize="13.5" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                                    <TextBlock Text="Padding and angular separation margin between slices along the ring." FontSize="11.5" Foreground="#71717A" Margin="0,3,0,0"/>
                                                </StackPanel>
                                                <TextBlock x:Name="TxtTargetSpacingValue" Grid.Column="1" Text="10 px" FontSize="13" FontWeight="Bold" Foreground="#3B82F6" VerticalAlignment="Center"/>
                                            </Grid>
                                            <Slider x:Name="SldTargetSpacing" Minimum="0" Maximum="40" Value="10" SmallChange="1" LargeChange="5" ValueChanged="OnTargetSpacingValueChanged"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Hover Color & Targeting Mode -->
                                    <Border Background="#141417" BorderBrush="#222228" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,14">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                                <TextBlock Text="Hover Color &amp; Accent" FontSize="13.5" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                                <TextBlock Text="Highlight color for active hovered tiles. Enter HEX code or pick palette swatch." FontSize="11.5" Foreground="#71717A" Margin="0,3,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <!-- Swatches -->
                                                <Button Background="#FFFFFF" Style="{StaticResource ColorDotButtonStyle}" Click="OnColorSwatchClick" Tag="#FFFFFF" ToolTip="White (Rovyl default)"/>
                                                <Button Background="#3B82F6" Style="{StaticResource ColorDotButtonStyle}" Click="OnColorSwatchClick" Tag="#3B82F6" ToolTip="Electric Blue"/>
                                                <Button Background="#10B981" Style="{StaticResource ColorDotButtonStyle}" Click="OnColorSwatchClick" Tag="#10B981" ToolTip="Emerald Green"/>
                                                <Button Background="#8B5CF6" Style="{StaticResource ColorDotButtonStyle}" Click="OnColorSwatchClick" Tag="#8B5CF6" ToolTip="Violet Purple"/>
                                                <Button Background="#F59E0B" Style="{StaticResource ColorDotButtonStyle}" Click="OnColorSwatchClick" Tag="#F59E0B" ToolTip="Amber Gold"/>
                                                <TextBox x:Name="TxtHoverColor" Text="#FFFFFF" Style="{StaticResource ModernTextBoxStyle}" Width="80" TextAlignment="Center" FontWeight="SemiBold" TextChanged="OnHoverColorTextChanged"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Targeting Mechanism -->
                                    <Border Background="#141417" BorderBrush="#222228" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,14">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                                <TextBlock Text="Targeting Mechanism" FontSize="13.5" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                                <TextBlock Text="Direction (Polar angle vector, fastest motor memory) or Pointer (Direct hitbox collision)." FontSize="11.5" Foreground="#71717A" Margin="0,3,0,0"/>
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="#18181D" BorderBrush="#2A2A33" BorderThickness="1" CornerRadius="8" Padding="3" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <RadioButton x:Name="RbTargetingDirection" Content="Direction (Angle)" Style="{StaticResource SegmentedRadioButtonStyle}" IsChecked="True" Checked="OnTargetingModeChanged" Tag="Direction"/>
                                                    <RadioButton x:Name="RbTargetingPointer" Content="Pointer (Hitbox)" Style="{StaticResource SegmentedRadioButtonStyle}" Checked="OnTargetingModeChanged" Tag="Pointer"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- Persistent Labels -->
                                    <Border Background="#141417" BorderBrush="#222228" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,14">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                                <TextBlock Text="Persistent Labels" FontSize="13.5" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                                <TextBlock Text="Keep shortcut title pills always visible around tiles instead of only upon hover." FontSize="11.5" Foreground="#71717A" Margin="0,3,0,0"/>
                                            </StackPanel>
                                            <CheckBox x:Name="ChkPersistentLabels" Grid.Column="1" Style="{StaticResource ModernToggleSwitch}" Checked="OnPersistentLabelsToggled" Unchecked="OnPersistentLabelsToggled"/>
                                        </Grid>
                                    </Border>

                                    <!-- Wheel Opacity & Background Dimming -->
                                    <Border Background="#141417" BorderBrush="#222228" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,14">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Wheel Opacity" FontSize="13.5" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                                    <TextBlock Text="Glass tile and background opacity level." FontSize="11.5" Foreground="#71717A" Margin="0,3,0,0"/>
                                                </StackPanel>
                                                <TextBlock x:Name="TxtWheelOpacityValue" Grid.Column="1" Text="85%" FontSize="13" FontWeight="Bold" Foreground="#3B82F6" VerticalAlignment="Center"/>
                                            </Grid>
                                            <Slider x:Name="SldWheelOpacity" Minimum="35" Maximum="100" Value="85" SmallChange="1" LargeChange="5" ValueChanged="OnWheelOpacityValueChanged"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="#141417" BorderBrush="#222228" BorderThickness="1" CornerRadius="10" Padding="16">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Background Dimming" FontSize="13.5" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                                    <TextBlock Text="Dim fullscreen backdrop overlay to isolate desktop distraction and focus the wheel." FontSize="11.5" Foreground="#71717A" Margin="0,3,0,0"/>
                                                </StackPanel>
                                                <TextBlock x:Name="TxtBackgroundDimmingValue" Grid.Column="1" Text="25%" FontSize="13" FontWeight="Bold" Foreground="#3B82F6" VerticalAlignment="Center"/>
                                            </Grid>
                                            <Slider x:Name="SldBackgroundDimming" Minimum="0" Maximum="100" Value="25" SmallChange="1" LargeChange="10" ValueChanged="OnBackgroundDimmingValueChanged"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- ======================================================== -->
                                <!-- ======================================================== -->
                                <!-- 4. WORKSPACES & WHEEL CUSTOMIZER PANEL                   -->
                                <!-- ======================================================== -->
                                <StackPanel x:Name="SubPanelWorkspaces" Visibility="Collapsed">

                                    <!-- Header Section (Wheel Profiles & Slices) -->
                                    <StackPanel Margin="0,0,0,16">
                                        <TextBlock Text="Radial Wheel Profiles &amp; Slices" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF"/>
                                        <TextBlock Text="Configure the shortcut slices that appear on your Alt+Z radial wheel. Independent from Workspaces." FontSize="12" Foreground="#71717A" Margin="0,3,0,0"/>
                                        <TextBlock Text="Your Wheel Profiles" FontSize="12.5" FontWeight="SemiBold" Foreground="#D4D4D8" Margin="0,14,0,0"/>
                                    </StackPanel>

                                    <!-- Workspace Cards Grid -->
                                    <WrapPanel x:Name="WorkspacesCardsPanel" Orientation="Horizontal" Margin="0,0,0,16">
                                        <!-- Dynamic Cards ItemsControl -->
                                        <ItemsControl x:Name="WorkspacesCardsControl">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="205" Height="185" Margin="0,0,14,14"
                                                            Background="{Binding CardBackground}"
                                                            BorderBrush="{Binding BorderBrushColor}"
                                                            BorderThickness="{Binding BorderThicknessValue}"
                                                            CornerRadius="14"
                                                            Cursor="Hand"
                                                            MouseLeftButtonDown="OnSelectWorkspaceCardClick"
                                                            Tag="{Binding}">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="#17171D"/>
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Grid Margin="10,8">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="105"/>
                                                                <RowDefinition Height="*"/>
                                                            </Grid.RowDefinitions>

                                                            <!-- Top: Mini Radial Preview -->
                                                            <controls:MiniRadialPreview Grid.Row="0"
                                                                                        Apps="{Binding Apps}"
                                                                                        CenterColor="{Binding AccentColor}"
                                                                                        IsActive="{Binding IsActive}"
                                                                                        HorizontalAlignment="Center"
                                                                                        VerticalAlignment="Center"
                                                                                        Width="180" Height="105"/>

                                                            <!-- Bottom: Details -->
                                                            <StackPanel Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                                                <!-- Name + Hotkey Badge -->
                                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                                    <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                                                    <Border Background="#1D1D24" BorderBrush="#2F2F3D" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding HotkeyIndex}" FontSize="10" FontWeight="SemiBold" Foreground="#A1A1AA"/>
                                                                    </Border>
                                                                </StackPanel>

                                                                <!-- Subtitle: "Current · 4 shortcuts" or "5 shortcuts" or "0 shortcuts" -->
                                                                <TextBlock Text="{Binding ShortcutCountText}" FontSize="11" Foreground="#71717A" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- "+ New workspace" Card Tile -->
                                        <Border Width="205" Height="185" Margin="0,0,14,14"
                                                Background="#0E0E12"
                                                BorderBrush="#24242C"
                                                BorderThickness="1"
                                                CornerRadius="14"
                                                Cursor="Hand"
                                                MouseLeftButtonDown="OnCreateNewWorkspaceCardClick">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="BorderBrush" Value="#3F3F50"/>
                                                            <Setter Property="Background" Value="#14141A"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="+" FontSize="28" Foreground="#71717A" HorizontalAlignment="Center"/>
                                                <TextBlock Text="New wheel profile" FontSize="12" Foreground="#71717A" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </WrapPanel>

                                    <!-- Workspace Configuration & Wheel Slices Section -->
                                    <Border x:Name="WorkspaceEditorSection"
                                            Background="#131317" BorderBrush="#24242C" BorderThickness="1" CornerRadius="12"
                                            Padding="20" Margin="0,4,0,24">
                                        <StackPanel>
                                            <!-- Editor Header: Workspace Title, Accent Color Dots, Switcher Toggle, Delete -->
                                            <Grid Margin="0,0,0,16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Left: Icon + Name (inline editable) + Color Picker -->
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="38" Height="38" Background="#1B1B22" BorderBrush="#2A2A34" BorderThickness="1" CornerRadius="8" Margin="0,0,12,0" VerticalAlignment="Center">
                                                        <TextBlock x:Name="WsEditorIconText" Text="🎯" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBox x:Name="WsEditorNameBox" Style="{StaticResource ModernTextBoxStyle}" Width="160" FontSize="14" FontWeight="SemiBold" TextChanged="OnWsEditorNameChanged" Margin="0,0,12,0"/>
                                                            <!-- Accent Color Picker Dots -->
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Button Style="{StaticResource ColorDotButtonStyle}" Background="#3B82F6" Tag="#3B82F6" Click="OnWsEditorColorDotClick" ToolTip="Blue"/>
                                                                <Button Style="{StaticResource ColorDotButtonStyle}" Background="#EF4444" Tag="#EF4444" Click="OnWsEditorColorDotClick" ToolTip="Red"/>
                                                                <Button Style="{StaticResource ColorDotButtonStyle}" Background="#10B981" Tag="#10B981" Click="OnWsEditorColorDotClick" ToolTip="Emerald"/>
                                                                <Button Style="{StaticResource ColorDotButtonStyle}" Background="#8B5CF6" Tag="#8B5CF6" Click="OnWsEditorColorDotClick" ToolTip="Purple"/>
                                                                <Button Style="{StaticResource ColorDotButtonStyle}" Background="#F59E0B" Tag="#F59E0B" Click="OnWsEditorColorDotClick" ToolTip="Amber"/>
                                                                <Button Style="{StaticResource ColorDotButtonStyle}" Background="#FFFFFF" Tag="#FFFFFF" Click="OnWsEditorColorDotClick" ToolTip="White"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <TextBlock x:Name="WsEditorSubtitle" Text="Configure the wheel slices for this profile" FontSize="11" Foreground="#71717A" Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Right: Actions (Switcher Visibility, Launch All, Delete) -->
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button x:Name="WsEditorVisibilityBtn" Content="👁️ In Switcher" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Padding="12,6" Click="OnWsEditorToggleVisibilityClick" ToolTip="Show/hide in radial switcher"/>
                                                    <Button Content="▶ Launch All" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Padding="12,6" Click="OnWsEditorLaunchAllClick" ToolTip="Launch all applications in this wheel"/>
                                                    <Button x:Name="WsEditorDeleteBtn" Content="🗑️ Delete" Style="{StaticResource DangerButtonStyle}" Padding="12,6" Click="OnWsEditorDeleteClick" ToolTip="Delete this wheel profile"/>
                                                </StackPanel>
                                            </Grid>

                                            <Separator Background="#202026" Margin="0,0,0,16"/>

                                            <!-- Two Columns: Current Wheel Slices (Left) and Add Applications (Right) -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.1*"/>
                                                    <ColumnDefinition Width="20"/>
                                                    <ColumnDefinition Width="1.4*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- LEFT COLUMN: Slices currently inside this wheel -->
                                                <StackPanel Grid.Column="0">
                                                    <Grid Margin="0,0,0,10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="WHEEL SLICES" FontSize="11" FontWeight="Bold" Foreground="#71717A" VerticalAlignment="Center"/>
                                                        <TextBlock x:Name="WsEditorSliceCountText" Grid.Column="1" Text="4 items" FontSize="11" Foreground="#3B82F6" FontWeight="SemiBold"/>
                                                    </Grid>

                                                    <!-- List of current apps in this wheel -->
                                                    <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                                                        <ItemsControl x:Name="WsEditorCurrentAppsList">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Background="#17171D" BorderBrush="#25252E" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,6">
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                            </Grid.ColumnDefinitions>

                                                                            <!-- Icon -->
                                                                            <Border Grid.Column="0" Width="28" Height="28" Background="#222228" CornerRadius="6" Margin="0,0,10,0">
                                                                                <TextBlock Text="{Binding IconGlyph}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                            </Border>

                                                                            <!-- Details -->
                                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                                <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                                                                <TextBlock Text="{Binding ExecutablePath}" FontSize="10.5" Foreground="#71717A" TextTrimming="CharacterEllipsis"/>
                                                                            </StackPanel>

                                                                            <!-- Actions: Up, Down, Remove -->
                                                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                                                <Button Content="▲" Style="{StaticResource SmallActionButtonStyle}" Padding="6,3" Margin="0,0,3,0" Tag="{Binding}" Click="OnWsSliceMoveUpClick" ToolTip="Move up (counter-clockwise)"/>
                                                                                <Button Content="▼" Style="{StaticResource SmallActionButtonStyle}" Padding="6,3" Margin="0,0,6,0" Tag="{Binding}" Click="OnWsSliceMoveDownClick" ToolTip="Move down (clockwise)"/>
                                                                                <Button Content="✕" Style="{StaticResource SmallActionButtonStyle}" Foreground="#F87171" Padding="7,3" Tag="{Binding}" Click="OnWsSliceRemoveClick" ToolTip="Remove from wheel"/>
                                                                            </StackPanel>
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </ScrollViewer>
                                                    <TextBlock x:Name="WsEditorEmptyPrompt" Text="No shortcuts in this wheel yet. Add from the right panel!" FontSize="11" Foreground="#71717A" HorizontalAlignment="Center" Margin="0,16,0,0" Visibility="Collapsed"/>
                                                </StackPanel>

                                                <!-- RIGHT COLUMN: Add Applications to Wheel -->
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="ADD SHORTCUTS TO WHEEL" FontSize="11" FontWeight="Bold" Foreground="#71717A" Margin="0,0,0,10"/>

                                                    <!-- Source Selector Tabs (Installed Apps / File / URL) -->
                                                    <Border Background="#18181F" BorderBrush="#272732" BorderThickness="1" CornerRadius="8" Padding="3" Margin="0,0,0,10">
                                                        <UniformGrid Columns="3">
                                                            <RadioButton x:Name="RbSourceInstalled" Content="💻 Installed Apps" Style="{StaticResource SegmentedRadioButtonStyle}" IsChecked="True" Checked="OnAddSourceTabChanged" Tag="Installed"/>
                                                            <RadioButton x:Name="RbSourceFile" Content="📁 File / Folder" Style="{StaticResource SegmentedRadioButtonStyle}" Checked="OnAddSourceTabChanged" Tag="File"/>
                                                            <RadioButton x:Name="RbSourceUrl" Content="🌐 Web URL" Style="{StaticResource SegmentedRadioButtonStyle}" Checked="OnAddSourceTabChanged" Tag="URL"/>
                                                        </UniformGrid>
                                                    </Border>

                                                    <!-- Panel 1: Installed Apps Filter & Add -->
                                                    <StackPanel x:Name="PanelAddInstalled">
                                                        <TextBox x:Name="TxtInstalledFilter" Style="{StaticResource ModernTextBoxStyle}" TextChanged="OnInstalledFilterChanged" Margin="0,0,0,8"/>
                                                        <ScrollViewer MaxHeight="255" VerticalScrollBarVisibility="Auto">
                                                            <ItemsControl x:Name="ListInstalledAppsSuggestions">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border Background="#16161C" BorderBrush="#22222A" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,5">
                                                                            <Grid>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                    <ColumnDefinition Width="*"/>
                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                </Grid.ColumnDefinitions>
                                                                                <TextBlock Grid.Column="0" Text="{Binding IconGlyph}" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                                                                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                                                                                </StackPanel>
                                                                                <Button Grid.Column="2" Content="+ Add to Wheel" Style="{StaticResource PrimaryButtonStyle}" Padding="8,3" FontSize="10.5" Tag="{Binding}" Click="OnAddInstalledAppToCurrentWsClick"/>
                                                                            </Grid>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </ScrollViewer>
                                                    </StackPanel>

                                                    <!-- Panel 2: File / Folder Browse -->
                                                    <StackPanel x:Name="PanelAddFile" Visibility="Collapsed">
                                                        <Border Background="#16161C" BorderBrush="#22222A" BorderThickness="1" CornerRadius="8" Padding="14">
                                                            <StackPanel>
                                                                <TextBlock Text="Add an executable (.exe) or folder directly:" FontSize="11.5" Foreground="#9CA3AF" Margin="0,0,0,12"/>
                                                                <Button Content="📂 Browse Executable Application (.exe)..." Style="{StaticResource PrimaryButtonStyle}" Padding="12,8" Margin="0,0,0,8" Click="OnBrowseExeForCurrentWsClick"/>
                                                                <Button Content="📁 Browse Folder Directory..." Style="{StaticResource SecondaryButtonStyle}" Padding="12,8" Click="OnBrowseFolderForCurrentWsClick"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>

                                                    <!-- Panel 3: Web URL -->
                                                    <StackPanel x:Name="PanelAddUrl" Visibility="Collapsed">
                                                        <Border Background="#16161C" BorderBrush="#22222A" BorderThickness="1" CornerRadius="8" Padding="14">
                                                            <StackPanel>
                                                                <TextBlock Text="Web Page / Service URL:" FontSize="11" Foreground="#A1A1AA" Margin="0,0,0,4"/>
                                                                <TextBox x:Name="TxtCustomUrl" Style="{StaticResource ModernTextBoxStyle}" Text="https://" Margin="0,0,0,8"/>
                                                                <TextBlock Text="Title / Display Name:" FontSize="11" Foreground="#A1A1AA" Margin="0,0,0,4"/>
                                                                <TextBox x:Name="TxtCustomUrlTitle" Style="{StaticResource ModernTextBoxStyle}" Text="YouTube" Margin="0,0,0,12"/>
                                                                <Button Content="+ Add Web Shortcut to Wheel" Style="{StaticResource PrimaryButtonStyle}" Padding="12,7" Click="OnAddUrlForCurrentWsClick"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                </StackPanel>

                                <!-- ======================================================== -->
                                <!-- 5. ADVANCED PANEL                                        -->
                                <!-- ======================================================== -->
                                <StackPanel x:Name="SubPanelAdvanced" Visibility="Collapsed">

                                    <!-- Check for Updates -->
                                    <Border Background="#141417" BorderBrush="#222228" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,14">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                                <TextBlock Text="Check for Updates" FontSize="13.5" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                                <TextBlock x:Name="TxtUpdateStatus" Text="The Hub v0.1.0 • Running latest build. Automatic check enabled." FontSize="11.5" Foreground="#71717A" Margin="0,3,0,0"/>
                                            </StackPanel>
                                            <Button x:Name="BtnCheckUpdates" Grid.Column="1" Content="Check Now" Style="{StaticResource SecondaryButtonStyle}" Padding="14,7" Click="OnCheckForUpdatesClick" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <!-- Precision Mode (Low Latency) -->
                                    <Border Background="#141417" BorderBrush="#222228" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,14">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                                <TextBlock Text="Precision Mode (Low Latency)" FontSize="13.5" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                                <TextBlock Text="Disable bloom transitions, blur effects, and animations for zero-lag instant responsiveness." FontSize="11.5" Foreground="#71717A" Margin="0,3,0,0"/>
                                            </StackPanel>
                                            <CheckBox x:Name="ChkPrecisionMode" Grid.Column="1" Style="{StaticResource ModernToggleSwitch}" Checked="OnPrecisionModeToggled" Unchecked="OnPrecisionModeToggled"/>
                                        </Grid>
                                    </Border>

                                    <!-- Fullscreen Protection -->
                                    <Border Background="#141417" BorderBrush="#222228" BorderThickness="1" CornerRadius="10" Padding="16">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                                <TextBlock Text="Fullscreen Protection" FontSize="13.5" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                                <TextBlock Text="Monitor active foreground windows to prevent accidental wheel triggers during games or video playback." FontSize="11.5" Foreground="#71717A" Margin="0,3,0,0"/>
                                            </StackPanel>
                                            <CheckBox x:Name="ChkFullscreenProtection" Grid.Column="1" Style="{StaticResource ModernToggleSwitch}" IsChecked="True" Checked="OnFullscreenProtectionToggled" Unchecked="OnFullscreenProtectionToggled"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>

                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <!-- TAB 3: DYNAMIC ISLAND -->
                <Grid x:Name="PageIsland" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Dynamic Island Settings" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF"/>
                            <TextBlock Text="Configure events, size, positioning, hover quick controls, and live stream tracking." FontSize="12.5" Foreground="#71717A" Margin="0,4,0,20"/>

                            <!-- Section 1: Events & Tracking -->
                            <Border Background="#141416" BorderBrush="#27272A" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="EVENT &amp; ACTIVITY TRACKING" FontSize="11" FontWeight="Bold" Foreground="#71717A" Margin="0,0,0,12"/>
                                    <CheckBox x:Name="ChkMedia" Content="Track Media playback (Spotify, Chrome, YouTube)" IsChecked="True" Foreground="#FFFFFF" Margin="0,0,0,10" Checked="OnSettingToggled" Unchecked="OnSettingToggled"/>
                                    <CheckBox x:Name="ChkShowActiveApp" Content="Show Active Stream &amp; App in Compact Mode (YouTube, Twitch, Games, Discord, Coding)" IsChecked="True" Foreground="#FFFFFF" Margin="0,0,0,10" Checked="OnSettingToggled" Unchecked="OnSettingToggled"/>
                                    <CheckBox x:Name="ChkVolume" Content="Show Volume adjustment capsule" IsChecked="True" Foreground="#FFFFFF" Margin="0,0,0,10" Checked="OnSettingToggled" Unchecked="OnSettingToggled"/>
                                    <CheckBox x:Name="ChkClipboard" Content="Show Clipboard copied notices" IsChecked="True" Foreground="#FFFFFF" Margin="0,0,0,10" Checked="OnSettingToggled" Unchecked="OnSettingToggled"/>
                                    <CheckBox x:Name="ChkUsb" Content="Show USB device plug/unplug events" IsChecked="True" Foreground="#FFFFFF" Margin="0,0,0,10" Checked="OnSettingToggled" Unchecked="OnSettingToggled"/>
                                    <CheckBox x:Name="ChkHideOnFullscreen" Content="Hide Dynamic Island when Fullscreen is active on its screen (Games, Videos, F11)" IsChecked="True" Foreground="#FFFFFF" Margin="0,0,0,10" Checked="OnSettingToggled" Unchecked="OnSettingToggled"/>
                                    <CheckBox x:Name="ChkAlwaysShowFullscreen" Content="Always Keep Dynamic Island visible on top of Fullscreen (Overrides Hide)" IsChecked="False" Foreground="#FFFFFF" Margin="0,0,0,6" Checked="OnSettingToggled" Unchecked="OnSettingToggled"/>
                                </StackPanel>
                            </Border>

                            <!-- Section 2: Display Screen Selection & Position -->
                            <Border Background="#141416" BorderBrush="#27272A" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="TARGET DISPLAY &amp; FREE POSITIONING" FontSize="11" FontWeight="Bold" Foreground="#71717A" Margin="0,0,0,12"/>
                                    
                                    <!-- Screen Selector -->
                                    <TextBlock Text="Target Display Screen" FontSize="12.5" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,4"/>
                                    <TextBlock Text="Choose which monitor the Dynamic Island is anchored to. Fullscreen detection will only hide the island if a fullscreen window is on this exact screen!" FontSize="11" Foreground="#71717A" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                    <ComboBox x:Name="CmbIslandMonitor" Style="{StaticResource DarkComboBoxStyle}" Width="360" HorizontalAlignment="Left" Margin="0,0,0,16" SelectionChanged="OnIslandMonitorSelectionChanged"/>

                                    <!-- Size Scale Slider -->
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Island Size Scale (تكبير / تصغير الجزيرة)" FontSize="12" Foreground="#FFFFFF"/>
                                        <TextBlock x:Name="TxtScaleValue" Grid.Column="1" Text="100%" FontSize="12" FontWeight="SemiBold" Foreground="#60A5FA"/>
                                    </Grid>
                                    <Slider x:Name="SldIslandScale" Minimum="0.7" Maximum="1.5" SmallChange="0.05" LargeChange="0.1" Value="1.0" Margin="0,0,0,16" ValueChanged="OnIslandScaleChanged"/>

                                    <!-- Top Offset Slider -->
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Vertical Distance from Top (المسافة من أعلى الشاشة)" FontSize="12" Foreground="#FFFFFF"/>
                                        <TextBlock x:Name="TxtTopValue" Grid.Column="1" Text="12 px" FontSize="12" FontWeight="SemiBold" Foreground="#60A5FA"/>
                                    </Grid>
                                    <Slider x:Name="SldIslandTop" Minimum="0" Maximum="120" SmallChange="2" LargeChange="10" Value="12" Margin="0,0,0,16" ValueChanged="OnIslandTopChanged"/>

                                    <!-- Dragging & Reset Controls -->
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <CheckBox x:Name="ChkLockPosition" Content="🔒 Lock Island Position (Prevent Dragging)" Foreground="#E4E4E7" FontSize="12" Margin="0,0,20,0" VerticalAlignment="Center" Checked="OnSettingToggled" Unchecked="OnSettingToggled"/>
                                        <Button Content="🎯 Reset Position to Screen Center" Style="{StaticResource SecondaryButtonStyle}" Padding="14,6" Click="OnResetIslandPositionClick" ToolTip="Center the Dynamic Island horizontally at the top of the monitor"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Section 3: Hover Quick Controls -->
                            <Border Background="#141416" BorderBrush="#27272A" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,16">
                                <StackPanel>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="HOVER QUICK CONTROLS BAR (أزرار التحكم عند وضع الماوس)" FontSize="11" FontWeight="Bold" Foreground="#71717A" Margin="0,0,0,4"/>
                                            <TextBlock Text="Customize which interactive control elements are shown when expanding the Dynamic Island" FontSize="11" Foreground="#A1A1AA"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="⚡ Preview Live" Style="{StaticResource SecondaryButtonStyle}" Padding="12,5" Click="OnPreviewIslandClick" ToolTip="Trigger live interactive preview of Dynamic Island"/>
                                    </Grid>

                                    <!-- Option 1: Quick Controls Row -->
                                    <Border Background="#18181E" BorderBrush="#2A2A36" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="26" Height="26" Background="#23232D" CornerRadius="6" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="🎛️" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,12,0">
                                                <TextBlock Text="Show Quick Controls bar when mouse hovers on Dynamic Island" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                                <TextBlock Text="Displays the action row with Mic Mute and Deafen buttons at the bottom of the island" FontSize="10.5" Foreground="#71717A" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <CheckBox x:Name="ChkShowQuickControls" Grid.Column="2" VerticalAlignment="Center" IsChecked="True" Foreground="#FFFFFF" Checked="OnSettingToggled" Unchecked="OnSettingToggled"/>
                                        </Grid>
                                    </Border>

                                    <!-- Option 2: Mic Mute Button -->
                                    <Border Background="#18181E" BorderBrush="#2A2A36" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="26" Height="26" Background="#23232D" CornerRadius="6" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="🎙️" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,12,0">
                                                <TextBlock Text="Include Microphone Mute button (🎙️ / 🎤)" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                                <TextBlock Text="Instant toggle to mute/unmute Windows system microphone input with green/red status" FontSize="10.5" Foreground="#71717A" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <CheckBox x:Name="ChkShowMicMute" Grid.Column="2" VerticalAlignment="Center" IsChecked="True" Foreground="#FFFFFF" Checked="OnSettingToggled" Unchecked="OnSettingToggled"/>
                                        </Grid>
                                    </Border>

                                    <!-- Option 3: Screen Brightness -->
                                    <Border Background="#18181E" BorderBrush="#2A2A36" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="26" Height="26" Background="#23232D" CornerRadius="6" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="☀️" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,12,0">
                                                <TextBlock Text="Include Screen Brightness controls (🔅 / 🔆)" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                                <TextBlock Text="Live hardware DDC/CI monitor brightness slider with instant percentage readout" FontSize="10.5" Foreground="#71717A" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <CheckBox x:Name="ChkShowBrightness" Grid.Column="2" VerticalAlignment="Center" IsChecked="True" Foreground="#FFFFFF" Checked="OnSettingToggled" Unchecked="OnSettingToggled"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Section 4: Live Event Simulators -->
                            <Border Background="#141416" BorderBrush="#27272A" BorderThickness="1" CornerRadius="12" Padding="18">
                                <StackPanel>
                                    <TextBlock Text="LIVE EVENT SIMULATORS" FontSize="11" FontWeight="Bold" Foreground="#71717A" Margin="0,0,0,12"/>
                                    <WrapPanel>
                                        <Button Content="Simulate Spotify 'Blinding Lights'" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8" Click="OnTestMediaIslandClick"/>
                                        <Button Content="Simulate Volume Level (75%)" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8" Click="OnTestVolumeIslandClick"/>
                                        <Button Content="Simulate Pomodoro (25:00)" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8" Click="OnTestTimerIslandClick"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- TAB 4: AI ASSISTANT -->
                <Grid x:Name="PageAi" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="System AI Assistant" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF"/>
                            <TextBlock Text="Computer Assistant with real OS tool calling and action execution." FontSize="12.5" Foreground="#71717A" Margin="0,4,0,20"/>

                            <!-- Prompt Box -->
                            <Border Background="#141416" BorderBrush="#27272A" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBox x:Name="AiInputTextBox" Grid.Row="0" Height="42" Background="#18181B" Foreground="#FFFFFF" BorderBrush="#2E2E33" BorderThickness="1" Padding="12,10" FontSize="13" Text="افتح Spotify وDiscord"/>

                                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                                        <Button Content="Execute Command" Style="{StaticResource PrimaryButtonStyle}" Click="OnAiExecuteClick"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- AI Output Card -->
                            <Border Background="#141416" BorderBrush="#27272A" BorderThickness="1" CornerRadius="12" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="ASSISTANT EXECUTION LOG" FontSize="11" FontWeight="Bold" Foreground="#71717A" Margin="0,0,0,8"/>
                                    <TextBlock x:Name="AiOutputTextBlock" Text="Ready to execute commands. Try 'افتح Spotify' or 'شن استهلاك الجهاز' or 'Launch Gaming'." FontSize="12.5" Foreground="#D4D4D8" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- TAB 5: PERMISSIONS -->
                <Grid x:Name="PagePermissions" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="AI Permissions &amp; Security" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF"/>
                            <TextBlock Text="Tiered safety model (Levels 0-3) preventing unauthorized operations." FontSize="12.5" Foreground="#71717A" Margin="0,4,0,20"/>

                            <ItemsControl x:Name="PermissionsListControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#141416" BorderBrush="#27272A" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding ActionName}" FontWeight="SemiBold" FontSize="13" Foreground="#FFFFFF"/>
                                                        <Border Background="#27272A" CornerRadius="4" Padding="6,1" Margin="8,0,0,0">
                                                            <TextBlock Text="{Binding Level}" FontSize="10" Foreground="#60A5FA"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#71717A" Margin="0,2,0,0"/>
                                                </StackPanel>

                                                <CheckBox Grid.Column="1" IsChecked="{Binding IsGranted}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

            </Grid>
        </Grid>

        <!-- ========================================================= -->
        <!-- MODAL 1: ICON PICKER (180+ Curated Application Icons)    -->
        <!-- ========================================================= -->
        <Grid x:Name="IconPickerModal" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed">
            <!-- Backdrop -->
            <Border Background="#B2000000" MouseDown="OnIconPickerBackdropClick"/>

            <!-- Centered Modal Dialog -->
            <Border Width="640" MaxHeight="560" Background="#141416" BorderBrush="#3B82F6" BorderThickness="1.5" CornerRadius="12" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Choose Application Icon" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                            <TextBlock Text="Select from 180+ curated icons categorized by application and workflow type" FontSize="11.5" Foreground="#71717A" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="✕" Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" FontSize="13" Click="OnCloseIconPickerClick" ToolTip="Close Icon Picker"/>
                    </Grid>

                    <!-- Search Input -->
                    <TextBox x:Name="IconSearchBox" Grid.Row="1" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,12" Height="36" Padding="10,6" FontSize="12.5" TextChanged="OnIconSearchChanged"/>

                    <!-- Category Chips -->
                    <WrapPanel x:Name="IconCategoriesPanel" Grid.Row="2" Margin="0,0,0,12">
                        <RadioButton Content="All" Style="{StaticResource CategoryChipButtonStyle}" Tag="All" IsChecked="True" Click="OnIconCategoryChipClick"/>
                        <RadioButton Content="Gaming" Style="{StaticResource CategoryChipButtonStyle}" Tag="Gaming" Click="OnIconCategoryChipClick"/>
                        <RadioButton Content="Media &amp; Audio" Style="{StaticResource CategoryChipButtonStyle}" Tag="Media &amp; Audio" Click="OnIconCategoryChipClick"/>
                        <RadioButton Content="Browsers &amp; Web" Style="{StaticResource CategoryChipButtonStyle}" Tag="Browsers &amp; Web" Click="OnIconCategoryChipClick"/>
                        <RadioButton Content="Dev &amp; Tech" Style="{StaticResource CategoryChipButtonStyle}" Tag="Dev &amp; Tech" Click="OnIconCategoryChipClick"/>
                        <RadioButton Content="Productivity" Style="{StaticResource CategoryChipButtonStyle}" Tag="Productivity" Click="OnIconCategoryChipClick"/>
                        <RadioButton Content="Design &amp; Art" Style="{StaticResource CategoryChipButtonStyle}" Tag="Design &amp; Art" Click="OnIconCategoryChipClick"/>
                        <RadioButton Content="System &amp; Utilities" Style="{StaticResource CategoryChipButtonStyle}" Tag="System &amp; Utilities" Click="OnIconCategoryChipClick"/>
                    </WrapPanel>

                    <!-- Icons Grid View -->
                    <Border Grid.Row="3" Background="#101012" BorderBrush="#27272A" BorderThickness="1" CornerRadius="8" Padding="8" MaxHeight="340">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="IconsListControl">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel HorizontalAlignment="Center"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding Glyph}" ToolTip="{Binding Name}" Tag="{Binding Glyph}" Style="{StaticResource IconSelectorButtonStyle}" Margin="4" Click="OnIconTileClick"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ========================================================= -->
        <!-- MODAL 2: INSTALLED APPS AUTO-DETECTION PICKER             -->
        <!-- ========================================================= -->
        <Grid x:Name="InstalledAppsModal" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed">
            <!-- Backdrop -->
            <Border Background="#B2000000" MouseDown="OnInstalledAppsBackdropClick"/>

            <!-- Centered Modal Dialog -->
            <Border Width="680" Height="580" Background="#141416" BorderBrush="#3B82F6" BorderThickness="1.5" CornerRadius="12" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="⚡ Pick Installed Application" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                            <TextBlock Text="Auto-detected software on your PC. Click 'Select' to automatically fill title, path, and icon." FontSize="11.5" Foreground="#71717A" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="↻ Rescan" Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" FontSize="11.5" Margin="0,0,8,0" Click="OnRescanInstalledAppsClick" ToolTip="Rescan PC for newly installed apps"/>
                        <Button Grid.Column="2" Content="✕" Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" FontSize="13" Click="OnCloseInstalledAppsClick" ToolTip="Close Picker"/>
                    </Grid>

                    <!-- Search Input -->
                    <TextBox x:Name="InstalledAppsSearchBox" Grid.Row="1" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,8" Height="36" Padding="10,6" FontSize="12.5" TextChanged="OnInstalledAppSearchChanged"/>

                    <!-- Status / Count -->
                    <TextBlock x:Name="InstalledAppsStatusBlock" Grid.Row="2" Text="Scanning installed applications..." FontSize="11" Foreground="#71717A" Margin="2,0,0,8"/>

                    <!-- Apps List View -->
                    <Border Grid.Row="3" Background="#101012" BorderBrush="#27272A" BorderThickness="1" CornerRadius="8" Padding="6">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="InstalledAppsListControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- App Glyph Badge -->
                                                <Border Grid.Column="0" Width="36" Height="36" Background="#222226" BorderBrush="#2E2E33" BorderThickness="1" CornerRadius="8" VerticalAlignment="Center" Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding IconGlyph}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>

                                                <!-- App Name & Category (Clean, No raw paths) -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                                        <Border Background="#27272A" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Category}" FontSize="10" Foreground="#9CA3AF" FontWeight="Medium"/>
                                                        </Border>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Select Button -->
                                                <Button Grid.Column="2" Content="Select" Style="{StaticResource PrimaryButtonStyle}" Padding="16,6" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" Tag="{Binding}" Click="OnSelectInstalledAppClick" ToolTip="Select this application"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</Window>
