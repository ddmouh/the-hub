<UserControl x:Class="TheHub.App.Controls.ColorPickerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Hue gradient for slider track -->
        <LinearGradientBrush x:Key="HueGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FF0000" Offset="0.000"/>
            <GradientStop Color="#FFFF00" Offset="0.167"/>
            <GradientStop Color="#00FF00" Offset="0.333"/>
            <GradientStop Color="#00FFFF" Offset="0.500"/>
            <GradientStop Color="#0000FF" Offset="0.667"/>
            <GradientStop Color="#FF00FF" Offset="0.833"/>
            <GradientStop Color="#FF0000" Offset="1.000"/>
        </LinearGradientBrush>
    </UserControl.Resources>

    <Border Background="#0F0F14" BorderBrush="#262836" BorderThickness="1" CornerRadius="10" Padding="12">
        <StackPanel Width="240">
            <!-- Saturation / Brightness canvas -->
            <Border x:Name="SBCanvas" Height="160" CornerRadius="6" ClipToBounds="True" Cursor="Cross"
                    MouseDown="OnSBMouseDown" MouseMove="OnSBMouseMove" MouseUp="OnSBMouseUp">
                <Grid>
                    <!-- Hue base fill (set in code-behind) -->
                    <Border x:Name="HueBase" CornerRadius="6"/>
                    <!-- White saturation gradient -->
                    <Border CornerRadius="6">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="White" Offset="0"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <!-- Black brightness gradient -->
                    <Border CornerRadius="6">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="Transparent" Offset="0"/>
                                <GradientStop Color="Black" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <!-- Cursor dot -->
                    <Canvas x:Name="SBCursorCanvas" IsHitTestVisible="False">
                        <Ellipse x:Name="SBCursor" Width="12" Height="12" StrokeThickness="2" Stroke="White"
                                 Canvas.Left="0" Canvas.Top="0">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="4" ShadowDepth="0" Opacity="0.6" Color="Black"/>
                            </Ellipse.Effect>
                        </Ellipse>
                    </Canvas>
                </Grid>
            </Border>

            <!-- Hue Slider -->
            <Grid Margin="0,10,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="36"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Height="14" CornerRadius="7" Margin="0,0,8,0"
                        Background="{StaticResource HueGradient}" Cursor="Hand"
                        MouseDown="OnHueMouseDown" MouseMove="OnHueMouseMove" MouseUp="OnHueMouseUp">
                    <Canvas x:Name="HueCursorCanvas" IsHitTestVisible="False">
                        <Border x:Name="HueCursor" Width="6" Height="18" CornerRadius="3"
                                Background="White" BorderBrush="#333" BorderThickness="1"
                                Canvas.Left="0" Canvas.Top="-2">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="4" ShadowDepth="0" Opacity="0.5"/>
                            </Border.Effect>
                        </Border>
                    </Canvas>
                </Border>
                <!-- Preview swatch -->
                <Border x:Name="ColorPreview" Grid.Column="1" Width="32" Height="32" CornerRadius="6"
                        BorderBrush="#333" BorderThickness="1" HorizontalAlignment="Right"/>
            </Grid>

            <!-- Hex Input -->
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="#" FontSize="12" Foreground="#71717A" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBox x:Name="TxtHex" Grid.Column="1" Text="00F0FF"
                         Background="#1A1B24" Foreground="#E4E4E7" BorderBrush="#2C2C38"
                         BorderThickness="1" Padding="6,4" FontSize="11.5" FontFamily="Consolas"
                         CharacterCasing="Upper" MaxLength="6"
                         TextChanged="OnHexTextChanged" LostFocus="OnHexLostFocus"/>
            </Grid>

            <!-- RGB Inputs -->
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="R" FontSize="9" FontWeight="Bold" Foreground="#71717A" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                    <TextBox x:Name="TxtR" Text="0" Background="#1A1B24" Foreground="#E4E4E7" BorderBrush="#2C2C38" BorderThickness="1" Padding="4,3" FontSize="11" FontFamily="Consolas" TextAlignment="Center" MaxLength="3" TextChanged="OnRgbTextChanged" LostFocus="OnRgbLostFocus"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="G" FontSize="9" FontWeight="Bold" Foreground="#71717A" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                    <TextBox x:Name="TxtG" Text="240" Background="#1A1B24" Foreground="#E4E4E7" BorderBrush="#2C2C38" BorderThickness="1" Padding="4,3" FontSize="11" FontFamily="Consolas" TextAlignment="Center" MaxLength="3" TextChanged="OnRgbTextChanged" LostFocus="OnRgbLostFocus"/>
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="B" FontSize="9" FontWeight="Bold" Foreground="#71717A" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                    <TextBox x:Name="TxtB" Text="255" Background="#1A1B24" Foreground="#E4E4E7" BorderBrush="#2C2C38" BorderThickness="1" Padding="4,3" FontSize="11" FontFamily="Consolas" TextAlignment="Center" MaxLength="3" TextChanged="OnRgbTextChanged" LostFocus="OnRgbLostFocus"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
