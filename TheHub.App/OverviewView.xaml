<UserControl x:Class="TheHub.App.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:TheHub.App"
             xmlns:controls="clr-namespace:TheHub.App.Controls"
             mc:Ignorable="d" 
             d:DesignWidth="1100" d:DesignHeight="780">

    <UserControl.Resources>
        <!-- ======================================================== -->
        <!-- JAXCORE CYBER-MINIMALIST DESIGN SYSTEM & STYLES          -->
        <!-- ======================================================== -->

        <!-- Cyber Toggle Switch -->
        <Style x:Key="CyberToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Border x:Name="Track" Width="44" Height="24" CornerRadius="12" Background="#181920" BorderBrush="#2C2E3B" BorderThickness="1.5">
                                <Grid>
                                    <Border x:Name="ThumbOff" Width="16" Height="16" CornerRadius="8" Background="#71717A" HorizontalAlignment="Left" Margin="3,0,0,0" Visibility="Visible"/>
                                    <Border x:Name="ThumbOn" Width="16" Height="16" CornerRadius="8" Background="#00F0FF" HorizontalAlignment="Right" Margin="0,0,3,0" Visibility="Collapsed">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#00F0FF" Opacity="0.85"/>
                                        </Border.Effect>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="#4B4E63"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#10252A"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="#00F0FF"/>
                                <Setter TargetName="ThumbOff" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="ThumbOn" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cyber Action Button (Launch / Trigger) -->
        <Style x:Key="CyberActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#181922"/>
            <Setter Property="Foreground" Value="#D4D4D8"/>
            <Setter Property="BorderBrush" Value="#2A2C3A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#222430"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#00F0FF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#14151C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cyber Mode Toggle Button (Lock / Drag Mode) -->
        <Style x:Key="CyberModeButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#14151D"/>
            <Setter Property="Foreground" Value="#A1A1AA"/>
            <Setter Property="BorderBrush" Value="#262835"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#3F4257"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segmented Mode Radio/Button Style -->
        <Style x:Key="CyberSegmentedTabStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#71717A"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="TabBorder" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#1A1B24"/>
                                <Setter Property="Foreground" Value="#D4D4D8"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#222432"/>
                                <Setter Property="Foreground" Value="#00F0FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cyber Progress Bar Style for Telemetry -->
        <Style x:Key="CyberProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="5"/>
            <Setter Property="Background" Value="#181922"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="2.5">
                            <Grid x:Name="PART_Track">
                                <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="2.5" HorizontalAlignment="Left"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark ComboBox Item Style -->
        <Style x:Key="CyberComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Foreground" Value="#E0E6ED"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="Transparent" BorderThickness="0" CornerRadius="4" Padding="10,6" Margin="2,1">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#252E42"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#2A3447"/>
                                <Setter Property="Foreground" Value="#00F0FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark ComboBox ToggleButton Template -->
        <ControlTemplate x:Key="CyberComboBoxToggleButtonTemplate" TargetType="ToggleButton">
            <Border x:Name="ToggleBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="24"/>
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 0 0 L 3.5 4 L 7 0 Z" Fill="#A1A1AA" x:Name="ArrowGlyph"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="#3F4257"/>
                    <Setter TargetName="ArrowGlyph" Property="Fill" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="#00F0FF"/>
                    <Setter TargetName="ArrowGlyph" Property="Fill" Value="#00F0FF"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Cyber Dark ComboBox Style -->
        <Style x:Key="CyberComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#13141B"/>
            <Setter Property="Foreground" Value="#E0E6ED"/>
            <Setter Property="BorderBrush" Value="#262835"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource CyberComboBoxItemStyle}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" 
                                          Template="{StaticResource CyberComboBoxToggleButtonTemplate}" 
                                          Background="{TemplateBinding Background}" 
                                          BorderBrush="{TemplateBinding BorderBrush}" 
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Focusable="False" 
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" 
                                          ClickMode="Press"/>
                            <ContentPresenter x:Name="ContentSite" 
                                              IsHitTestVisible="False" 
                                              Content="{TemplateBinding SelectionBoxItem}" 
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" 
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" 
                                              Margin="10,6,26,6" 
                                              VerticalAlignment="Center" 
                                              HorizontalAlignment="Left"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                            <Popup x:Name="Popup" 
                                   Placement="Bottom" 
                                   IsOpen="{TemplateBinding IsDropDownOpen}" 
                                   AllowsTransparency="True" 
                                   Focusable="False" 
                                   PopupAnimation="Slide">
                                <Grid x:Name="DropDown" 
                                      SnapsToDevicePixels="True" 
                                      MinWidth="{TemplateBinding ActualWidth}" 
                                      MaxHeight="220" 
                                      Margin="0,4,0,0">
                                    <Border x:Name="DropDownBorder" 
                                            Background="#161B26" 
                                            BorderBrush="#2A3447" 
                                            BorderThickness="1" 
                                            CornerRadius="6" 
                                            Padding="4">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="12" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.5"/>
                                        </Border.Effect>
                                        <ScrollViewer SnapsToDevicePixels="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cyber TextBox Style -->
        <Style x:Key="CyberTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#13141B"/>
            <Setter Property="Foreground" Value="#00F0FF"/>
            <Setter Property="BorderBrush" Value="#262835"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="CaretBrush" Value="#00F0FF"/>
        </Style>

        <!-- Modular Card Outer Border Style with Hover Glow -->
        <Style x:Key="ModularCardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#121319"/>
            <Setter Property="BorderBrush" Value="#20222D"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.45"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Chevron Accordion Toggle Button -->
        <Style x:Key="ChevronToggleButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#52525B"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ChevBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                BorderBrush="#1B1D25"
                                BorderThickness="0,1,0,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChevBorder" Property="Background" Value="#16172088"/>
                                <Setter Property="Foreground" Value="#A1A1AA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <!-- Main Container -->
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <!-- Top Banner: JaxCore Modular Desktop Widgets -->
            <RowDefinition Height="Auto"/>
            <!-- Modular Cards Grid (Auto so ScrollViewer can measure real content height) -->
            <RowDefinition Height="Auto" MinHeight="0"/>
        </Grid.RowDefinitions>

        <!-- Top Section Notice: JaxCore Modular Desktop Widgets -->
        <Border Grid.Row="0" Background="#12131A" BorderBrush="#1F212B" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#1C2130" BorderBrush="#00F0FF" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                            <TextBlock Text="JAXCORE MODULAR SUITE" FontSize="10" FontWeight="Bold" Foreground="#00F0FF" FontFamily="Consolas, Segoe UI"/>
                        </Border>
                        <TextBlock Text="Desktop Companion Widgets" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                    </StackPanel>
                    <TextBlock Text="Independent desktop overlays with multi-monitor pass-through, hardware telemetry sensors, and customizable visual themes." FontSize="11.5" Foreground="#71717A" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#161720" BorderBrush="#272A38" BorderThickness="1" CornerRadius="6" Padding="8,4">
                        <TextBlock Text="2 DESKTOP WIDGETS ACTIVE" FontSize="10.5" FontWeight="Bold" Foreground="#A1A1AA"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ======================================================== -->
        <!-- RESPONSIVE MODULAR CARDS GRID (CYBERCLOCK & SYSTEM GAUGES) -->
        <!-- ======================================================== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False" Focusable="True" PreviewMouseWheel="OnPreviewMouseWheel">
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="340"/>
                    <ColumnDefinition Width="*" MinWidth="340"/>
                </Grid.ColumnDefinitions>

                <!-- ==================================================== -->
                <!-- MODULE CARD 1: CYBERCLOCK WIDGET (FULL CUSTOMIZATION) -->
                <!-- ==================================================== -->
                <Border Grid.Column="0" Style="{StaticResource ModularCardBorderStyle}" Margin="0,0,14,0">
                    <StackPanel>
                        <!-- Header: Icon, Titles, Toggle -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Cyber Icon Badge -->
                            <Border Grid.Column="0" Width="40" Height="40" Background="#111A24" BorderBrush="#00F0FF" BorderThickness="1" CornerRadius="8" Margin="0,0,12,0" VerticalAlignment="Center">
                                <TextBlock Text="⏱️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <!-- Title & Status Subtext -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="CyberClock" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    <Border Background="#182329" CornerRadius="3" Padding="4,1" Margin="6,0,0,0">
                                        <TextBlock Text="CLK-01" FontSize="9" FontWeight="Bold" Foreground="#00F0FF" FontFamily="Consolas, Segoe UI"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding ClockStatusDescription, FallbackValue='REAL-TIME MATRIX // RUNNING'}" FontSize="10.5" Foreground="#71717A" Margin="0,2,0,0"/>
                            </StackPanel>

                            <!-- Master Toggle Switch -->
                            <CheckBox Grid.Column="2" 
                                      Style="{StaticResource CyberToggleSwitchStyle}" 
                                      IsChecked="{Binding IsClockActive, Mode=TwoWay}"
                                      VerticalAlignment="Center"
                                      ToolTip="Toggle CyberClock Widget on desktop"/>
                        </Grid>

                        <!-- Live Interactive Clock Preview Box (Digital or Analog) -->
                        <Border Background="#0A0B0E" BorderBrush="{Binding ClockGlowColor, FallbackValue='#00F0FF'}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,14">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="0" Color="#00F0FF" Opacity="0.15"/>
                            </Border.Effect>

                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                <!-- Digital Preview View -->
                                <StackPanel Visibility="{Binding IsDigitalMode, Converter={StaticResource BoolToVis}}" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding LiveClockTime, FallbackValue='20:45:18'}" 
                                               FontSize="28" 
                                               FontWeight="Bold" 
                                               Foreground="{Binding ClockGlowColor, FallbackValue='#00F0FF'}" 
                                               FontFamily="{Binding SelectedFontFamily, FallbackValue='Consolas'}"
                                               HorizontalAlignment="Center">
                                        <TextBlock.Effect>
                                            <DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="{Binding ClockGlowColor, FallbackValue='#00F0FF'}" Opacity="0.65"/>
                                        </TextBlock.Effect>
                                    </TextBlock>
                                    <TextBlock Text="{Binding LiveClockDate, FallbackValue='SATURDAY // 19 SEP 2026'}" 
                                               FontSize="9.5" 
                                               FontWeight="SemiBold" 
                                               Foreground="#A1A1AA" 
                                               Margin="0,4,0,0"
                                               HorizontalAlignment="Center"
                                               FontFamily="{Binding SelectedFontFamily, FallbackValue='Consolas'}"/>
                                </StackPanel>

                                <!-- Analog Preview View -->
                                <Grid Visibility="{Binding IsAnalogMode, Converter={StaticResource BoolToVis}}" Width="84" Height="84" HorizontalAlignment="Center" Margin="0,2">
                                    <Ellipse Width="80" Height="80" Stroke="#2A2C3A" StrokeThickness="1.5" Fill="#0D0E14"/>
                                    <Canvas Width="84" Height="84" ClipToBounds="False">
                                        <!-- Hour Hand -->
                                        <Line X1="42" Y1="42" X2="42" Y2="23" Stroke="#FFFFFF" StrokeThickness="2.5" StrokeStartLineCap="Round">
                                            <Line.RenderTransform>
                                                <RotateTransform Angle="{Binding HourHandAngle}" CenterX="42" CenterY="42"/>
                                            </Line.RenderTransform>
                                        </Line>
                                        <!-- Minute Hand -->
                                        <Line X1="42" Y1="42" X2="42" Y2="14" Stroke="#D4D4D8" StrokeThickness="1.8" StrokeStartLineCap="Round">
                                            <Line.RenderTransform>
                                                <RotateTransform Angle="{Binding MinuteHandAngle}" CenterX="42" CenterY="42"/>
                                            </Line.RenderTransform>
                                        </Line>
                                        <!-- Second Hand -->
                                        <Line X1="42" Y1="48" X2="42" Y2="9" Stroke="{Binding ClockGlowColor, FallbackValue='#00F0FF'}" StrokeThickness="1">
                                            <Line.RenderTransform>
                                                <RotateTransform Angle="{Binding SecondHandAngle}" CenterX="42" CenterY="42"/>
                                            </Line.RenderTransform>
                                        </Line>
                                        <!-- Center Cap -->
                                        <Ellipse Canvas.Left="39.5" Canvas.Top="39.5" Width="5" Height="5" Fill="{Binding ClockGlowColor, FallbackValue='#00F0FF'}"/>
                                    </Canvas>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Chevron Toggle: Expand/Collapse additional clock settings -->
                        <Button x:Name="BtnToggleClockExpand"
                                Style="{StaticResource ChevronToggleButtonStyle}"
                                Content="▼  Customize"
                                Margin="0,8,0,0"
                                Click="OnToggleClockExpand"
                                ToolTip="Expand to configure display mode, colors, font, and more"/>

                        <!-- EXPANDED SECTION: clock settings (collapsed by default) -->
                        <Border x:Name="ClockExpandedSection" Visibility="Collapsed" Margin="0,8,0,0">
                            <StackPanel>

                        <!-- Display Mode Switcher (Digital vs Analog) -->
                        <Border Background="#0E0F14" BorderBrush="#1F2029" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Display Mode" FontSize="11" FontWeight="SemiBold" Foreground="#A1A1AA"/>
                                    <TextBlock Text="Choose digital matrix or analog dial" FontSize="9.5" Foreground="#71717A" Margin="0,1,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#161720" BorderBrush="#252735" BorderThickness="1" CornerRadius="6" Padding="2">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Content="🔢 Digital" 
                                                     Style="{StaticResource CyberSegmentedTabStyle}" 
                                                     IsChecked="{Binding IsDigitalMode, Mode=OneWay}"
                                                     Command="{Binding SetDisplayModeCommand}"
                                                     CommandParameter="Digital"/>
                                        <RadioButton Content="🕒 Analog" 
                                                     Style="{StaticResource CyberSegmentedTabStyle}" 
                                                     IsChecked="{Binding IsAnalogMode, Mode=OneWay}"
                                                     Command="{Binding SetDisplayModeCommand}"
                                                     CommandParameter="Analog"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Digital Format Options (Visible when Digital Mode) -->
                        <Border Background="#0E0F14" BorderBrush="#1F2029" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,10"
                                Visibility="{Binding IsDigitalMode, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Digital Format" FontSize="11" FontWeight="SemiBold" Foreground="#A1A1AA"/>
                                    <TextBlock Text="Time structure &amp; seconds display" FontSize="9.5" Foreground="#71717A" Margin="0,1,0,0"/>
                                </StackPanel>
                                <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <CheckBox Content="24H" IsChecked="{Binding Is24Hour, Mode=TwoWay}" Foreground="#D4D4D8" FontSize="11" Margin="0,0,12,0"/>
                                    <CheckBox Content="Seconds" IsChecked="{Binding ShowSeconds, Mode=TwoWay}" Foreground="#D4D4D8" FontSize="11"/>
                                </WrapPanel>
                            </Grid>
                        </Border>

                        <!-- Separate Independent Date Display Control -->
                        <Border Background="#0E0F14" BorderBrush="#1F2029" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Show Date" FontSize="11" FontWeight="SemiBold" Foreground="#A1A1AA"/>
                                    <TextBlock Text="Independent calendar date strip below clock face" FontSize="9.5" Foreground="#71717A" Margin="0,1,0,0"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" IsChecked="{Binding ShowDate, Mode=TwoWay}" Style="{StaticResource CyberToggleSwitchStyle}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Visual Styles Dropdown -->
                        <Border Background="#0E0F14" BorderBrush="#1F2029" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="150"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Visual Style" FontSize="11" FontWeight="SemiBold" Foreground="#A1A1AA"/>
                                    <TextBlock Text="Presets: Cyber Neon, Minimalist, Glass, Retro" FontSize="9.5" Foreground="#71717A" Margin="0,1,0,0"/>
                                </StackPanel>
                                <ComboBox Grid.Column="1" 
                                          ItemsSource="{Binding AvailableVisualStyles}" 
                                          SelectedItem="{Binding SelectedVisualStyle, Mode=TwoWay}"
                                          Style="{StaticResource CyberComboBoxStyle}"/>
                            </Grid>
                        </Border>

                        <!-- Background Opacity Slider (0% - 100%) -->
                        <Border Background="#0E0F14" BorderBrush="#1F2029" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Background Opacity" FontSize="11" FontWeight="SemiBold" Foreground="#A1A1AA"/>
                                        <TextBlock Text="Adjust glass transparency to 0% for pure frameless floating" FontSize="9.5" Foreground="#71717A" Margin="0,1,0,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding BackgroundOpacityText, FallbackValue='85%'}" FontSize="11" FontWeight="Bold" Foreground="#00F0FF" VerticalAlignment="Center"/>
                                </Grid>
                                <Slider Grid.Row="1" 
                                        Minimum="0" Maximum="100" 
                                        Value="{Binding BackgroundOpacity, Mode=TwoWay}" 
                                        SmallChange="1" LargeChange="10"
                                        Margin="0,4,0,0"/>
                            </Grid>
                        </Border>

                        <!-- Visual Color Palette (Extended Swatches - No Manual Hex TextBox) -->
                        <Border Background="#0E0F14" BorderBrush="#1F2029" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,10">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Accent Color &amp; Glow" FontSize="11" FontWeight="SemiBold" Foreground="#A1A1AA"/>
                                        <TextBlock Text="Visual palette: Cyan, Emerald, Purple, Crimson, Amber, White, Slate" FontSize="9.5" Foreground="#71717A" Margin="0,1,0,0"/>
                                    </StackPanel>
                                    <!-- Active Color Indicator Badge -->
                                    <Border Grid.Column="1" Width="20" Height="20" CornerRadius="10" Background="{Binding ClockGlowColor, FallbackValue='#00F0FF'}" BorderBrush="#FFFFFF" BorderThickness="1.5"/>
                                </Grid>

                                <!-- Extended Circular Color Palette Buttons -->
                                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <!-- Cyan #00F0FF -->
                                    <Button Command="{Binding SetClockColorCommand}" CommandParameter="#00F0FF" Cursor="Hand" Margin="0,0,6,0" Width="22" Height="22" ToolTip="Cyan #00F0FF">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Width="22" Height="22" CornerRadius="11" Background="#00F0FF" BorderBrush="#FFFFFF" BorderThickness="1"/>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <!-- Emerald #10B981 -->
                                    <Button Command="{Binding SetClockColorCommand}" CommandParameter="#10B981" Cursor="Hand" Margin="0,0,6,0" Width="22" Height="22" ToolTip="Emerald #10B981">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Width="22" Height="22" CornerRadius="11" Background="#10B981" BorderBrush="#FFFFFF" BorderThickness="1"/>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <!-- Purple #A855F7 -->
                                    <Button Command="{Binding SetClockColorCommand}" CommandParameter="#A855F7" Cursor="Hand" Margin="0,0,6,0" Width="22" Height="22" ToolTip="Purple #A855F7">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Width="22" Height="22" CornerRadius="11" Background="#A855F7" BorderBrush="#FFFFFF" BorderThickness="1"/>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <!-- Crimson #F43F5E -->
                                    <Button Command="{Binding SetClockColorCommand}" CommandParameter="#F43F5E" Cursor="Hand" Margin="0,0,6,0" Width="22" Height="22" ToolTip="Crimson #F43F5E">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Width="22" Height="22" CornerRadius="11" Background="#F43F5E" BorderBrush="#FFFFFF" BorderThickness="1"/>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <!-- Amber #F59E0B -->
                                    <Button Command="{Binding SetClockColorCommand}" CommandParameter="#F59E0B" Cursor="Hand" Margin="0,0,6,0" Width="22" Height="22" ToolTip="Amber #F59E0B">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Width="22" Height="22" CornerRadius="11" Background="#F59E0B" BorderBrush="#FFFFFF" BorderThickness="1"/>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <!-- Pure White #FFFFFF -->
                                    <Button Command="{Binding SetClockColorCommand}" CommandParameter="#FFFFFF" Cursor="Hand" Margin="0,0,6,0" Width="22" Height="22" ToolTip="Pure White #FFFFFF">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Width="22" Height="22" CornerRadius="11" Background="#FFFFFF" BorderBrush="#71717A" BorderThickness="1"/>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <!-- Slate #64748B -->
                                    <Button Command="{Binding SetClockColorCommand}" CommandParameter="#64748B" Cursor="Hand" Margin="0,0,6,0" Width="22" Height="22" ToolTip="Slate #64748B">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Width="22" Height="22" CornerRadius="11" Background="#64748B" BorderBrush="#FFFFFF" BorderThickness="1"/>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <!-- Electric Blue #3B82F6 -->
                                    <Button Command="{Binding SetClockColorCommand}" CommandParameter="#3B82F6" Cursor="Hand" Width="22" Height="22" ToolTip="Electric Blue #3B82F6">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Width="22" Height="22" CornerRadius="11" Background="#3B82F6" BorderBrush="#FFFFFF" BorderThickness="1"/>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </WrapPanel>

                                <!-- Full-spectrum Color Picker (HSB + Hex/RGB) -->
                                <Border Background="#0A0B0E" BorderBrush="#1F222E" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,10,0,0" HorizontalAlignment="Center">
                                    <controls:ColorPickerControl x:Name="AdvancedColorPicker" ColorChanged="OnAdvancedColorChanged"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Font Family Selector -->
                        <Border Background="#0E0F14" BorderBrush="#1F2029" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="150"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Clock Font" FontSize="11" FontWeight="SemiBold" Foreground="#A1A1AA"/>
                                    <TextBlock Text="Monospace or clean sans-serif typography" FontSize="9.5" Foreground="#71717A" Margin="0,1,0,0"/>
                                </StackPanel>
                                <ComboBox Grid.Column="1" 
                                          ItemsSource="{Binding AvailableFontFamilies}" 
                                          SelectedItem="{Binding SelectedFontFamily, Mode=TwoWay}"
                                          Style="{StaticResource CyberComboBoxStyle}"/>
                            </Grid>
                         </Border>

                         <!-- Lock Widget Control (Click-Through & Desktop Pinning) -->
                        <Border Background="#0E0F14" BorderBrush="#1F2029" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Lock Widget" FontSize="11" FontWeight="SemiBold" Foreground="#A1A1AA"/>
                                    <TextBlock Text="Pin behind all windows &amp; pass-through clicks" FontSize="9.5" Foreground="#71717A" Margin="0,1,0,0"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" 
                                          IsChecked="{Binding IsClockLocked, Mode=TwoWay}" 
                                          Style="{StaticResource CyberToggleSwitchStyle}" 
                                          VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                            </StackPanel>
                        </Border>
                        <!-- End ClockExpandedSection -->

                    </StackPanel>
                </Border>

                <!-- ==================================================== -->
                <!-- MODULE CARD 2: SYSTEM GAUGES WIDGET                 -->
                <!-- ==================================================== -->
                <Border Grid.Column="1" Style="{StaticResource ModularCardBorderStyle}">
                    <StackPanel>
                        <!-- Header: Icon, Titles, Toggle -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Cyber Icon Badge -->
                            <Border Grid.Column="0" Width="40" Height="40" Background="#11241C" BorderBrush="#00FF9D" BorderThickness="1" CornerRadius="8" Margin="0,0,12,0" VerticalAlignment="Center">
                                <TextBlock Text="🎛️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <!-- Title & Status Subtext -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="System Gauges" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    <Border Background="#162A20" CornerRadius="3" Padding="4,1" Margin="6,0,0,0">
                                        <TextBlock Text="HW-02" FontSize="9" FontWeight="Bold" Foreground="#00FF9D" FontFamily="Consolas, Segoe UI"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding GaugesStatusDescription, FallbackValue='HARDWARE TELEMETRY // STREAMING'}" FontSize="10.5" Foreground="#71717A" Margin="0,2,0,0"/>
                            </StackPanel>

                            <!-- Independent hardware widget toggles -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <CheckBox Style="{StaticResource CyberToggleSwitchStyle}" IsChecked="{Binding IsCpuActive, Mode=TwoWay}" ToolTip="Toggle CPU widget" Margin="0,0,4,0"/>
                                <CheckBox Style="{StaticResource CyberToggleSwitchStyle}" IsChecked="{Binding IsGpuActive, Mode=TwoWay}" ToolTip="Toggle GPU widget" Margin="0,0,4,0"/>
                                <CheckBox Style="{StaticResource CyberToggleSwitchStyle}" IsChecked="{Binding IsRamActive, Mode=TwoWay}" ToolTip="Toggle RAM widget"/>
                            </StackPanel>
                        </Grid>

                        <!-- Telemetry Gauges Preview (CPU, RAM, GPU) -->
                        <Border Background="#0A0B0E" BorderBrush="#1F202B" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,14">
                            <StackPanel>
                                <!-- CPU Load Gauge -->
                                <Grid Margin="0,0,0,2">
                                    <TextBlock Text="⚡ CPU LOAD" FontSize="10" FontWeight="SemiBold" Foreground="#93C5FD"/>
                                    <TextBlock Text="{Binding CpuPercentText, FallbackValue='24%'}" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Right" FontFamily="Consolas, Segoe UI"/>
                                </Grid>
                                <ProgressBar Value="{Binding CpuPercent, Mode=OneWay, FallbackValue=24}" Maximum="100" Style="{StaticResource CyberProgressBarStyle}" Foreground="#38BDF8" Margin="0,0,0,12"/>

                                <!-- RAM Memory Gauge -->
                                <Grid Margin="0,0,0,2">
                                    <TextBlock Text="🎛️ SYSTEM MEMORY (RAM)" FontSize="10" FontWeight="SemiBold" Foreground="#A7F3D0"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding RamUsageDetail, FallbackValue='13.4 / 32.0 GB'}" FontSize="9.5" Foreground="#71717A" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding RamPercentText, FallbackValue='42%'}" FontSize="11" FontWeight="Bold" Foreground="#00FF9D" VerticalAlignment="Center" FontFamily="Consolas, Segoe UI"/>
                                    </StackPanel>
                                </Grid>
                                <ProgressBar Value="{Binding RamPercent, Mode=OneWay, FallbackValue=42}" Maximum="100" Style="{StaticResource CyberProgressBarStyle}" Foreground="#00FF9D" Margin="0,0,0,12"/>

                                <!-- GPU Compute Gauge -->
                                <Grid Margin="0,0,0,2">
                                    <TextBlock Text="🎮 GPU ACCELERATION" FontSize="10" FontWeight="SemiBold" Foreground="#DDD6FE"/>
                                    <TextBlock Text="{Binding GpuPercentText, FallbackValue='18%'}" FontSize="11" FontWeight="Bold" Foreground="#BD00FF" HorizontalAlignment="Right" FontFamily="Consolas, Segoe UI"/>
                                </Grid>
                                <ProgressBar Value="{Binding GpuPercent, Mode=OneWay, FallbackValue=18}" Maximum="100" Style="{StaticResource CyberProgressBarStyle}" Foreground="#BD00FF"/>
                            </StackPanel>
                        </Border>

                        <!-- Chevron Toggle: Expand/Collapse gauge settings -->
                        <Button x:Name="BtnToggleGaugesExpand"
                                Style="{StaticResource ChevronToggleButtonStyle}"
                                Content="▼  Customize"
                                Margin="0,8,0,0"
                                Click="OnToggleGaugesExpand"
                                ToolTip="Expand to configure position lock and gauge options"/>

                        <!-- EXPANDED SECTION: gauge settings (collapsed by default) -->
                        <Border x:Name="GaugesExpandedSection" Visibility="Collapsed" Margin="0,8,0,0">
                            <StackPanel>

                        <!-- Lock Position Control -->
                        <Border Background="#0E0F14" BorderBrush="#1F2029" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Position Lock" FontSize="11" FontWeight="SemiBold" Foreground="#A1A1AA"/>
                                    <TextBlock Text="Prevent accidental dragging during gameplay" FontSize="9.5" Foreground="#71717A" Margin="0,1,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" 
                                        Command="{Binding ToggleGaugesLockCommand}" 
                                        Style="{StaticResource CyberModeButtonStyle}">
                                    <TextBlock Text="{Binding GaugesLockModeText, FallbackValue='🔒 POSITION LOCKED'}" FontSize="10.5"/>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Telemetry Features Pill Bar -->
                        <Border Background="#0E0F14" BorderBrush="#1F2029" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,14">
                            <WrapPanel Orientation="Horizontal">
                                <Border Background="#161822" CornerRadius="4" Padding="6,3" Margin="0,0,6,4">
                                    <TextBlock Text="1000ms Polling" FontSize="9.5" Foreground="#94A3B8"/>
                                </Border>
                                <Border Background="#161822" CornerRadius="4" Padding="6,3" Margin="0,0,6,4">
                                    <TextBlock Text="High Load Glow" FontSize="9.5" Foreground="#94A3B8"/>
                                </Border>
                                <Border Background="#161822" CornerRadius="4" Padding="6,3" Margin="0,0,6,4">
                                    <TextBlock Text="Direct2D Zero Lag" FontSize="9.5" Foreground="#00FF9D"/>
                                </Border>
                                <Border Background="#161822" CornerRadius="4" Padding="6,3" Margin="0,0,6,4">
                                    <TextBlock Text="Uptime Monitor" FontSize="9.5" Foreground="#94A3B8"/>
                                </Border>
                            </WrapPanel>
                        </Border>

                            </StackPanel>
                        </Border>
                        <!-- End GaugesExpandedSection -->

                    </StackPanel>
                </Border>

            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
