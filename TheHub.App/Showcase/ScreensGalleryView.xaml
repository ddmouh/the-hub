<UserControl x:Class="TheHub.App.Showcase.ScreensGalleryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TheHub.App.Showcase"
             Background="#0B0B0D"
             Foreground="#E4E4E7"
             FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif">

    <UserControl.Resources>
        <!-- Category Filter Chip Style -->
        <Style x:Key="GalleryFilterChipStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="#141418"/>
            <Setter Property="Foreground" Value="#A1A1AA"/>
            <Setter Property="BorderBrush" Value="#22222B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="20" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#3F3F50"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3B82F6"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#60A5FA"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Gallery Action Button -->
        <Style x:Key="GalleryActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#181820"/>
            <Setter Property="Foreground" Value="#E4E4E7"/>
            <Setter Property="BorderBrush" Value="#2A2A38"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#252532"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#3B82F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Accent Button -->
        <Style x:Key="GalleryPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2563EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Header & Toolbar -->
            <RowDefinition Height="Auto"/>
            <!-- Filter Categories Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Showcase Cards ScrollViewer -->
            <RowDefinition Height="*"/>
            <!-- Status & Notification Footer -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- 1. TOP HEADER & ACTION CONTROLS                             -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="#111116" BorderBrush="#1C1C24" BorderThickness="0,0,0,1" Padding="20,16" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Title & Meta -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="26" Height="26" Background="#1E1E28" BorderBrush="#3B82F6" BorderThickness="1.5" CornerRadius="7" Margin="0,0,10,0">
                            <TextBlock Text="🖼️" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="UI Flow &amp; Screen Showcase Gallery" FontSize="19" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                        <Border Background="#203B82F6" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Mobbin / PageFlows Mode" FontSize="10.5" FontWeight="SemiBold" Foreground="#60A5FA"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Live visual design catalog &amp; automated snapshot engine rendering all states, overlays, widgets, and dialogs." FontSize="11.5" Foreground="#71717A" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Action Buttons & Search -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Search Input -->
                    <Border Width="210" Height="34" Background="#16161E" BorderBrush="#272736" BorderThickness="1" CornerRadius="8" Padding="8,0" Margin="0,0,10,0">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🔍" FontSize="11" Foreground="#71717A" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBox x:Name="GallerySearchBox" Grid.Column="1" Background="Transparent" Foreground="#FFFFFF" BorderThickness="0" FontSize="11.5" VerticalAlignment="Center" TextChanged="OnGallerySearchChanged" CaretBrush="#3B82F6"/>
                        </Grid>
                    </Border>

                    <!-- Export All Button -->
                    <Button Content="📸 Export All (PNG)" Style="{StaticResource GalleryPrimaryButtonStyle}" Margin="0,0,8,0" Click="OnExportAllClick" ToolTip="Render and save all registered screens as high-res PNGs in /Screenshots/UI_Flow"/>
                    
                    <!-- Open Screenshots Folder -->
                    <Button Content="📂 Open Folder" Style="{StaticResource GalleryActionButtonStyle}" Margin="0,0,8,0" Click="OnOpenFolderClick" ToolTip="Open the Screenshots/UI_Flow folder in Windows Explorer"/>

                    <!-- Refresh Previews -->
                    <Button Content="🔄 Refresh" Style="{StaticResource GalleryActionButtonStyle}" Click="OnRefreshClick" ToolTip="Re-generate and refresh visual thumbnails"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- 2. CATEGORY FILTER CHIPS BAR                                -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="1" Margin="20,0,20,12">
            <WrapPanel x:Name="CategoryFilterWrapPanel">
                <RadioButton Content="All Screens (34)" Style="{StaticResource GalleryFilterChipStyle}" Tag="All" IsChecked="True" Click="OnCategoryFilterClick"/>
                <RadioButton Content="🏝️ Dynamic Island (12)" Style="{StaticResource GalleryFilterChipStyle}" Tag="Dynamic Island" Click="OnCategoryFilterClick"/>
                <RadioButton Content="⚡ Dashboard Pages (7)" Style="{StaticResource GalleryFilterChipStyle}" Tag="Dashboard" Click="OnCategoryFilterClick"/>
                <RadioButton Content="🎯 Radial Launcher (3)" Style="{StaticResource GalleryFilterChipStyle}" Tag="Radial Wheel" Click="OnCategoryFilterClick"/>
                <RadioButton Content="🧩 Desktop Widgets (4)" Style="{StaticResource GalleryFilterChipStyle}" Tag="Widgets" Click="OnCategoryFilterClick"/>
                <RadioButton Content="⚙️ Settings &amp; AI (5)" Style="{StaticResource GalleryFilterChipStyle}" Tag="Settings &amp; Options" Click="OnCategoryFilterClick"/>
                <RadioButton Content="🗔 Modals &amp; Controls (4)" Style="{StaticResource GalleryFilterChipStyle}" Tag="Modals &amp; Dialogs" Click="OnCategoryFilterClick"/>
            </WrapPanel>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- 3. SHOWCASE CARDS GRID (Mobbin / PageFlows style)          -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20,0,10,20">
            <ItemsControl x:Name="ShowcaseCardsItemsControl">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Individual Showcase Card -->
                        <Border Width="335" Height="305" Margin="0,0,16,16"
                                Background="#121217"
                                BorderBrush="#22222D"
                                BorderThickness="1.5"
                                CornerRadius="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <!-- Card Header: Category & State Pill -->
                                    <RowDefinition Height="Auto"/>
                                    <!-- High-Fidelity Preview Container -->
                                    <RowDefinition Height="150"/>
                                    <!-- Card Details & Actions -->
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Header -->
                                <Grid Grid.Row="0" Margin="12,10,12,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Category Tag -->
                                    <Border Grid.Column="0" Background="#1C1E2A" BorderBrush="{Binding BadgeColor}" BorderThickness="1" CornerRadius="6" Padding="8,2" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Category}" FontSize="10.5" FontWeight="Bold" Foreground="{Binding BadgeColor}"/>
                                    </Border>

                                    <!-- State Tag -->
                                    <Border Grid.Column="1" Background="#1A1A22" CornerRadius="6" Padding="6,2">
                                        <TextBlock Text="{Binding StateTag}" FontSize="10" Foreground="#9CA3AF" FontWeight="Medium"/>
                                    </Border>
                                </Grid>

                                <!-- Live / Rendered Preview Area (Click to Zoom Lightbox) -->
                                <Border Grid.Row="1" Margin="10,0,10,8"
                                        Background="#08080C"
                                        BorderBrush="#1C1C26"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        ClipToBounds="True"
                                        Cursor="Hand"
                                        MouseDown="OnCardPreviewMouseDown"
                                        Tag="{Binding}">
                                    <Grid>
                                        <!-- Rendered Bitmap Image View -->
                                        <Image Source="{Binding ThumbnailSource}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        
                                        <!-- Hover Pill -->
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6" Background="#B2000000" CornerRadius="4" Padding="6,2">
                                            <TextBlock Text="🔎 Click to Zoom" FontSize="9.5" Foreground="#D4D4D8"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Card Footer: Title, Description & Action Buttons -->
                                <Grid Grid.Row="2" Margin="12,0,12,10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Title -->
                                    <TextBlock Grid.Row="0" Text="{Binding Title}" FontSize="12.5" FontWeight="Bold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                                    
                                    <!-- Description -->
                                    <TextBlock Grid.Row="1" Text="{Binding Description}" FontSize="10.5" Foreground="#71717A" TextWrapping="Wrap" MaxHeight="28" TextTrimming="CharacterEllipsis" Margin="0,2,0,6"/>

                                    <!-- Action Buttons -->
                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Inspect Live Button -->
                                        <Button Grid.Column="0" Content="⚡ Inspect in App" Style="{StaticResource GalleryPrimaryButtonStyle}" Padding="10,4" FontSize="11" Margin="0,0,6,0" Tag="{Binding}" Click="OnInspectClick" ToolTip="Jump directly to this active view/modal in The Hub"/>

                                        <!-- Save PNG Button -->
                                        <Button Grid.Column="1" Content="💾 PNG" Style="{StaticResource GalleryActionButtonStyle}" Padding="8,4" FontSize="10.5" Margin="0,0,4,0" Tag="{Binding}" Click="OnExportSingleClick" ToolTip="Export high-res PNG for this screen"/>

                                        <!-- Zoom Lightbox Button -->
                                        <Button Grid.Column="2" Content="🔎" Style="{StaticResource GalleryActionButtonStyle}" Padding="8,4" FontSize="10.5" Tag="{Binding}" Click="OnZoomCardClick" ToolTip="Open full-size lightbox view"/>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- 4. BOTTOM STATUS NOTIFICATION BAR                           -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="3" Background="#0F0F14" BorderBrush="#1C1C24" BorderThickness="0,1,0,0" Padding="20,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtGalleryStatus" Grid.Column="0" Text="Showing all 17 registered visual UI flows. Ready for inspection and high-res export." FontSize="11" Foreground="#71717A" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtExportPathInfo" Grid.Column="1" Text="Screenshots folder: /Screenshots/UI_Flow/" FontSize="10.5" Foreground="#3B82F6" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="OnOpenFolderClick"/>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- 5. LIGHTBOX MODAL INSPECTOR (Full Zoom Preview)             -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Grid x:Name="LightboxModal" Grid.RowSpan="4" Visibility="Collapsed">
            <!-- Semi-transparent backdrop -->
            <Border Background="#D8000000" MouseDown="OnCloseLightboxClick"/>

            <!-- Lightbox Dialog Card -->
            <Border Width="780" MaxHeight="620" Background="#121218" BorderBrush="#3B82F6" BorderThickness="1.5" CornerRadius="16" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Header -->
                        <RowDefinition Height="Auto"/>
                        <!-- Full Preview Host Area -->
                        <RowDefinition Height="*"/>
                        <!-- Metadata & Quick Jump -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="TxtLightboxTitle" Text="Screen Title" FontSize="17" FontWeight="Bold" Foreground="#FFFFFF"/>
                            <TextBlock x:Name="TxtLightboxCategory" Text="Category • State Tag" FontSize="11.5" Foreground="#3B82F6" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="✕" Style="{StaticResource GalleryActionButtonStyle}" Padding="10,4" FontSize="13" Click="OnCloseLightboxClick"/>
                    </Grid>

                    <!-- Preview Frame Host -->
                    <Border Grid.Row="1" Background="#0A0A0E" BorderBrush="#22222E" BorderThickness="1" CornerRadius="10" Padding="10" MinHeight="320" MaxHeight="420">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <Viewbox x:Name="LightboxViewbox" Stretch="Uniform" MaxHeight="400">
                                <ContentControl x:Name="LightboxPreviewHost"/>
                            </Viewbox>
                        </ScrollViewer>
                    </Border>

                    <!-- Metadata & Actions -->
                    <Grid Grid.Row="2" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtLightboxDescription" Text="Description here..." FontSize="11.5" Foreground="#9CA3AF" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="💾 Export This Screen (PNG)" Style="{StaticResource GalleryActionButtonStyle}" Margin="0,0,8,0" Click="OnLightboxExportClick"/>
                            <Button Content="⚡ Jump to Screen in App" Style="{StaticResource GalleryPrimaryButtonStyle}" Click="OnLightboxInspectClick"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
