<Window x:Class="TheHub.App.Showcase.ScreensGalleryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:showcase="clr-namespace:TheHub.App.Showcase"
        Title="The Hub — UI Flow &amp; Screen Showcase Gallery"
        Height="780" Width="1180"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#0B0B0D"
        Foreground="#E4E4E7"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif">
    <Grid>
        <showcase:ScreensGalleryView x:Name="GalleryViewControl"/>
    </Grid>
</Window>
