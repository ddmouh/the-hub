<UserControl x:Class="TheHub.App.Showcase.ControlsShowcaseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:TheHub.Design.Controls;assembly=TheHub.Design"
             Background="{StaticResource Brush.Bg.Window}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24" MaxWidth="1100">
            <!-- 1. Header with Wrapping Actions -->
            <controls:SectionHeader Title="Design System Controls"
                                    Subtitle="Official controls catalog matching DESIGN_SYSTEM.md specifications.">
                <controls:SectionHeader.Actions>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Secondary" Style="{StaticResource HubButton.Secondary}" Margin="0,0,8,0"/>
                        <Button Content="Primary Action" Style="{StaticResource HubButton.Primary}"/>
                    </StackPanel>
                </controls:SectionHeader.Actions>
            </controls:SectionHeader>

            <!-- 2. HubHoldButton (Destructive Confirm) Card -->
            <Border Style="{StaticResource HubCard}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="1. HUB HOLD BUTTON (DESTRUCTIVE CONFIRM)" Style="{StaticResource Text.Section}" Margin="0,0,0,4"/>
                    <TextBlock Text="Press and hold fills progressively with clip-based text inversion. Releasing early rolls back via Spring.Snappy."
                               Style="{StaticResource Text.Caption}" Margin="0,0,0,14"/>

                    <!-- State Matrix -->
                    <WrapPanel Orientation="Horizontal">
                        <!-- Rest Danger -->
                        <StackPanel Margin="0,0,16,12">
                            <TextBlock Text="Rest (Danger)" Style="{StaticResource Text.Caption}" Margin="0,0,0,6"/>
                            <controls:HubHoldButton Content="Delete Workspace"
                                                    Variant="Danger"
                                                    HoldingText="Release to cancel"
                                                    ConfirmedText="Workspace deleted"
                                                    Width="170"/>
                        </StackPanel>

                        <!-- Rest Neutral -->
                        <StackPanel Margin="0,0,16,12">
                            <TextBlock Text="Rest (Neutral)" Style="{StaticResource Text.Caption}" Margin="0,0,0,6"/>
                            <controls:HubHoldButton Content="Reset Settings"
                                                    Variant="Neutral"
                                                    HoldingText="Release to cancel"
                                                    ConfirmedText="Settings reset"
                                                    Width="170"/>
                        </StackPanel>

                        <!-- AI Kill Switch Variant -->
                        <StackPanel Margin="0,0,16,12">
                            <TextBlock Text="AI Kill Switch (Danger)" Style="{StaticResource Text.Caption}" Margin="0,0,0,6"/>
                            <controls:HubHoldButton Content="Emergency Stop"
                                                    Variant="Danger"
                                                    HoldingText="Release to cancel"
                                                    ConfirmedText="AI Terminated"
                                                    Width="170"/>
                        </StackPanel>

                        <!-- Disabled State -->
                        <StackPanel Margin="0,0,16,12">
                            <TextBlock Text="Disabled State" Style="{StaticResource Text.Caption}" Margin="0,0,0,6"/>
                            <controls:HubHoldButton Content="Locked Action"
                                                    IsEnabled="False"
                                                    Width="170"/>
                        </StackPanel>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- 3. HubRangeSlider (Dual Thumb) Card -->
            <Border Style="{StaticResource HubCard}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="2. HUB RANGE SLIDER (DUAL THUMB)" Style="{StaticResource Text.Section}" Margin="0,0,0,4"/>
                    <TextBlock Text="Two 16px thumbs on a 4px track with Accent fill and floating value bubble. Tab switches thumbs, Arrows adjust."
                               Style="{StaticResource Text.Caption}" Margin="0,0,0,14"/>

                    <Grid Margin="0,8,0,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Default Range (20 - 80) -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,16">
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Volume Range Protection (dB)" Style="{StaticResource Text.Label}"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding ElementName=RangeSlider1, Path=LowerValue, StringFormat='{}{0:0}'}" Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.Accent}"/>
                                    <TextBlock Text=" – " Style="{StaticResource Text.Caption}"/>
                                    <TextBlock Text="{Binding ElementName=RangeSlider1, Path=UpperValue, StringFormat='{}{0:0}'}" Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.Accent}"/>
                                </StackPanel>
                            </Grid>
                            <controls:HubRangeSlider x:Name="RangeSlider1"
                                                     Minimum="0" Maximum="100"
                                                     LowerValue="25" UpperValue="75"
                                                     MinimumDistance="10" Step="1"
                                                     ValueFormat="{}{0:0} dB"/>
                        </StackPanel>

                        <!-- Frequency / Distance Constrained Range -->
                        <StackPanel Grid.Row="1" Margin="0,0,0,16">
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Widget Refresh Interval Range (MinimumDistance: 15s)" Style="{StaticResource Text.Label}"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding ElementName=RangeSlider2, Path=LowerValue, StringFormat='{}{0:0}s'}" Style="{StaticResource Text.Caption}"/>
                                    <TextBlock Text=" to " Style="{StaticResource Text.Caption}"/>
                                    <TextBlock Text="{Binding ElementName=RangeSlider2, Path=UpperValue, StringFormat='{}{0:0}s'}" Style="{StaticResource Text.Caption}"/>
                                </StackPanel>
                            </Grid>
                            <controls:HubRangeSlider x:Name="RangeSlider2"
                                                     Minimum="5" Maximum="120"
                                                     LowerValue="15" UpperValue="60"
                                                     MinimumDistance="15" Step="5"
                                                     ValueFormat="{}{0:0}s"/>
                        </StackPanel>

                        <!-- Disabled Range Slider -->
                        <StackPanel Grid.Row="2">
                            <TextBlock Text="Disabled Range Slider" Style="{StaticResource Text.Caption}" Margin="0,0,0,6"/>
                            <controls:HubRangeSlider Minimum="0" Maximum="100"
                                                     LowerValue="30" UpperValue="70"
                                                     IsEnabled="False"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 4. HubPillTabs (Segmented Navigation) Card -->
            <Border Style="{StaticResource HubCard}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="3. HUB PILL TABS (SEGMENTED NAVIGATION)" Style="{StaticResource Text.Section}" Margin="0,0,0,4"/>
                    <TextBlock Text="Pill container with sliding Bg.Raised indicator powered by Spring.Smooth. Keyboard arrows switch tabs."
                               Style="{StaticResource Text.Caption}" Margin="0,0,0,14"/>

                    <!-- Standard Tabs -->
                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="Standard Segmented Navigation (LTR)" Style="{StaticResource Text.Caption}" Margin="0,0,0,8"/>
                        <controls:HubPillTabs SelectedIndex="0" HorizontalAlignment="Left">
                            <controls:HubPillTabItem Content="Overview"/>
                            <controls:HubPillTabItem Content="Workspaces"/>
                            <controls:HubPillTabItem Content="Radial Wheel"/>
                            <controls:HubPillTabItem Content="Dynamic Island"/>
                            <controls:HubPillTabItem Content="AI Assistant"/>
                        </controls:HubPillTabs>
                    </StackPanel>

                    <!-- RTL Tabs -->
                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="Arabic Segmented Navigation (RTL Safe)" Style="{StaticResource Text.Caption}" Margin="0,0,0,8"/>
                        <controls:HubPillTabs SelectedIndex="1" FlowDirection="RightToLeft" HorizontalAlignment="Left">
                            <controls:HubPillTabItem Content="نظرة عامة"/>
                            <controls:HubPillTabItem Content="مساحات العمل"/>
                            <controls:HubPillTabItem Content="الخلفيات المتحركة"/>
                            <controls:HubPillTabItem Content="الإعدادات"/>
                        </controls:HubPillTabs>
                    </StackPanel>

                    <!-- CollapseWhenIdle Tabs -->
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="CollapseWhenIdle = True (Collapses to active tab when cursor leaves)" Style="{StaticResource Text.Caption}" Margin="0,0,0,8"/>
                        <controls:HubPillTabs SelectedIndex="0" CollapseWhenIdle="True" HorizontalAlignment="Left">
                            <controls:HubPillTabItem Content="⚡ Live Metrics"/>
                            <controls:HubPillTabItem Content="🕒 Cyber Clock"/>
                            <controls:HubPillTabItem Content="🎮 Game Mode"/>
                        </controls:HubPillTabs>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 5. HubSlider (Single Thumb with Value Bubble) Card -->
            <Border Style="{StaticResource HubCard}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="4. HUB SLIDER (UPGRADED WITH VALUE BUBBLE)" Style="{StaticResource Text.Section}" Margin="0,0,0,4"/>
                    <TextBlock Text="Single 16px thumb on 4px track with animated value bubble appearing on drag or keyboard focus."
                               Style="{StaticResource Text.Caption}" Margin="0,0,0,14"/>

                    <Grid Margin="0,8,0,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Active Slider -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,16">
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Dynamic Island Opacity" Style="{StaticResource Text.Label}"/>
                                <TextBlock Text="{Binding ElementName=SingleSlider1, Path=Value, StringFormat='{}{0:0}%'}"
                                           Style="{StaticResource Text.Caption}"
                                           Foreground="{StaticResource Brush.Accent}"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                            <controls:HubSlider x:Name="SingleSlider1"
                                                Minimum="10" Maximum="100" Value="85"
                                                ValueFormat="{}{0:0}%"/>
                        </StackPanel>

                        <!-- Disabled Slider -->
                        <StackPanel Grid.Row="1">
                            <TextBlock Text="Disabled Single Slider" Style="{StaticResource Text.Caption}" Margin="0,0,0,6"/>
                            <controls:HubSlider Minimum="0" Maximum="100" Value="50" IsEnabled="False"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 6. HubToggle (Upgraded with 1.15x Stretch) Card -->
            <Border Style="{StaticResource HubCard}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="5. HUB TOGGLE (UPGRADED WITH SPRING PRESS-STRETCH)" Style="{StaticResource Text.Section}" Margin="0,0,0,4"/>
                    <TextBlock Text="Thumb stretches 1.15x on press via Spring.Snappy and returns on release; track cross-fades via Fade.Base."
                               Style="{StaticResource Text.Caption}" Margin="0,0,0,14"/>

                    <WrapPanel Orientation="Horizontal">
                        <StackPanel Margin="0,0,24,12" VerticalAlignment="Center">
                            <TextBlock Text="Rest (Unchecked)" Style="{StaticResource Text.Caption}" Margin="0,0,0,6"/>
                            <controls:HubToggle IsChecked="False"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,24,12" VerticalAlignment="Center">
                            <TextBlock Text="Rest (Checked / Active)" Style="{StaticResource Text.Caption}" Margin="0,0,0,6"/>
                            <controls:HubToggle IsChecked="True"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,24,12" VerticalAlignment="Center">
                            <TextBlock Text="Disabled (Unchecked)" Style="{StaticResource Text.Caption}" Margin="0,0,0,6"/>
                            <controls:HubToggle IsChecked="False" IsEnabled="False"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,24,12" VerticalAlignment="Center">
                            <TextBlock Text="Disabled (Checked)" Style="{StaticResource Text.Caption}" Margin="0,0,0,6"/>
                            <controls:HubToggle IsChecked="True" IsEnabled="False"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,24,12" VerticalAlignment="Center">
                            <TextBlock Text="Legacy CheckBox Style" Style="{StaticResource Text.Caption}" Margin="0,0,0,6"/>
                            <CheckBox Style="{StaticResource HubToggle}" IsChecked="True"/>
                        </StackPanel>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- 7. Legacy Button Hierarchy Card (Preserved) -->
            <Border Style="{StaticResource HubCard}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="STANDARD BUTTON HIERARCHY" Style="{StaticResource Text.Section}" Margin="0,0,0,12"/>
                    <WrapPanel Orientation="Horizontal">
                        <Button Content="Primary" Style="{StaticResource HubButton.Primary}" Margin="0,0,10,10"/>
                        <Button Content="Secondary" Style="{StaticResource HubButton.Secondary}" Margin="0,0,10,10"/>
                        <Button Content="Ghost Button" Style="{StaticResource HubButton.Ghost}" Margin="0,0,10,10"/>
                        <Button Content="Kill Switch (Danger)" Style="{StaticResource HubButton.Danger}" Margin="0,0,10,10"/>
                        <Button Content="Disabled" Style="{StaticResource HubButton.Primary}" IsEnabled="False" Margin="0,0,10,10"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
