<UserControl x:Class="TheHub.App.Pages.OverviewPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TheHub.App"
             xmlns:design="clr-namespace:TheHub.Design.Controls;assembly=TheHub.Design"
             mc:Ignorable="d" 
             d:DesignHeight="1200" d:DesignWidth="850">
    <Grid>
        <Grid.RowDefinitions>
            <!-- Header & Action Buttons -->
            <RowDefinition Height="Auto"/>
            <!-- Sub Tabs Selector -->
            <RowDefinition Height="Auto"/>
            <!-- Active Sub Tab Content -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Desktop Customization Studio" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF"/>
            <TextBlock Text="Manage animated wallpapers, desktop widgets, taskbar appearance, and system HUD overlays." FontSize="12" Foreground="#71717A" Margin="0,3,0,0"/>
        </StackPanel>

        <!-- Sub Tabs Navigation -->
        <design:HubPillTabs x:Name="OverviewSubTabs" Grid.Row="1" SelectedIndex="0" SelectionChanged="OnOverviewSubTabsSelectionChanged" Margin="0,0,0,16">
            <design:HubPillTabItem Content="Wallpapers"/>
            <design:HubPillTabItem Content="Widgets"/>
            <design:HubPillTabItem Content="Taskbar &amp; Dock"/>
        </design:HubPillTabs>

        <!-- Sub Tab Panels Container -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,-6,0">
            <StackPanel Margin="0,0,6,16">

                <!-- 1. WALLPAPERS TAB CONTENT -->
                <StackPanel x:Name="SubPanelOverviewWallpapers" Visibility="Visible">

                    <!-- Wallpaper Options Toolbar -->
                    <Border Background="#16191E" BorderBrush="#252A33" BorderThickness="1" CornerRadius="10" Padding="16,10" Margin="0,0,0,14">
                        <StackPanel>
                            <design:SettingRow Title="Auto-pause in fullscreen/games"
                                               Description="Pauses live video when full-screen apps or games run on that display">
                                
                                    <design:HubToggle x:Name="ChkPauseWallpaperFullscreen"
                                                      Checked="OnWallpaperSettingChanged"
                                                      Unchecked="OnWallpaperSettingChanged"/>
                                
                            </design:SettingRow>
                            <design:SettingRow Title="Pause on battery power"
                                               Description="Freezes live video wallpapers when running on battery power to conserve energy">
                                
                                    <design:HubToggle x:Name="ChkPauseWallpaperBattery"
                                                      Checked="OnWallpaperSettingChanged"
                                                      Unchecked="OnWallpaperSettingChanged"/>
                                
                            </design:SettingRow>
                            <design:SettingRow Title="Mute sound"
                                               Description="Mutes audio playback on animated video wallpapers">
                                
                                    <design:HubToggle x:Name="ChkMuteWallpaperAudio"
                                                      Checked="OnWallpaperMuteChanged"
                                                      Unchecked="OnWallpaperMuteChanged"/>
                                
                            </design:SettingRow>
                            <design:SettingRow Title="Wallpaper Video Fit"
                                               Description="Choose sizing aspect ratio mode across display monitor boundaries">
                                
                                    <ComboBox x:Name="CmbWallpaperFit" Width="120" Height="28" SelectionChanged="OnWallpaperFitSelectionChanged" FontSize="12">
                                        <ComboBoxItem Content="Fill" ToolTip="Fill screen (UniformToFill)"/>
                                        <ComboBoxItem Content="Fit" ToolTip="Fit entire video within screen (Uniform)"/>
                                        <ComboBoxItem Content="Stretch" ToolTip="Stretch video to screen boundaries (Fill)"/>
                                        <ComboBoxItem Content="Center" ToolTip="Center video in original aspect ratio"/>
                                        <ComboBoxItem Content="Span" ToolTip="Span video across multiple monitors"/>
                                    </ComboBox>
                                
                            </design:SettingRow>
                        </StackPanel>
                    </Border>

                    <!-- Multi-Monitor Selector Card -->
                    <Border Background="#16191E" BorderBrush="#252A33" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <WrapPanel Margin="0,0,0,12" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,8" MinWidth="180">
                                    <TextBlock Text="🖥️" FontSize="14" Margin="0,0,6,0"/>
                                    <TextBlock Text="TARGET DISPLAY" FontSize="11.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                                </StackPanel>
                                
                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                                    <Button Content="+ Add Wallpaper" Style="{StaticResource PrimaryButtonStyle}" Padding="14,7" Margin="0,0,8,0" Click="OnAddWallpaperClick" ToolTip="Add an animated video (MP4, WebM, GIF) or static image (JPG, PNG)"/>
                                    <Button Content="🔄 Refresh Displays" Style="{StaticResource SmallActionButtonStyle}" Click="OnRefreshDisplaysClick" Margin="0,0,8,0" ToolTip="Detect newly connected monitors"/>
                                    <Button Content="🛑 Clear Display Wallpaper" Style="{StaticResource SmallActionButtonStyle}" Foreground="#F87171" Click="OnClearCurrentDisplayWallpaperClick" ToolTip="Clear and reset wallpaper on the selected display target"/>
                                </WrapPanel>
                            </WrapPanel>

                            <!-- Display Buttons Row -->
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="MonitorSelectorPanel" Orientation="Horizontal" Margin="0,4,0,4"/>
                            </ScrollViewer>

                            <!-- Current Target Status Indicator -->
                            <Border Background="#0E0E12" BorderBrush="#1F1F26" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,10,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Active Target:" FontSize="11.5" FontWeight="Medium" Foreground="#A1A1AA" Margin="0,0,6,0"/>
                                        <TextBlock x:Name="TxtSelectedTargetDisplay" Text="All Displays (Duplicate Mode)" FontSize="11.5" FontWeight="Bold" Foreground="#3B82F6"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TxtCurrentTargetWallpaperStatus" Grid.Column="1" Text="Wallpaper: None" FontSize="11" Foreground="#71717A" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Section Title -->
                    <TextBlock Text="YOUR WALLPAPERS" FontSize="11" FontWeight="Bold" Foreground="#71717A" Margin="0,0,0,12"/>

                    <!-- Empty State Card -->
                    <Border x:Name="WallpaperEmptyPrompt" Visibility="Collapsed" Background="#16191E" BorderBrush="#252A33" BorderThickness="1" CornerRadius="10" Padding="32" Margin="0,0,0,16">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="🎬" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock Text="No Wallpapers Added Yet" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                            <TextBlock Text="Click '+ Add Wallpaper' to select any animated video (MP4, WebM, GIF) or high-res image (PNG, JPG)." FontSize="12" Foreground="#71717A" HorizontalAlignment="Center" Margin="0,6,0,16" TextAlignment="Center"/>
                            <Button Content="+ Add Wallpaper" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Center" Padding="16,8" Click="OnAddWallpaperClick"/>
                        </StackPanel>
                    </Border>

                    <!-- Wallpaper Cards Grid -->
                    <ItemsControl x:Name="WallpapersGalleryControl">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="220" Height="185" Margin="0,0,14,14"
                                        Background="#16191E"
                                        BorderBrush="{Binding CardBorderBrush}"
                                        BorderThickness="1.5"
                                        CornerRadius="10">
                                    <Grid Margin="12">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="95"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <!-- Top Visual / Badge Box -->
                                        <Border Grid.Row="0" Background="#1C1C22" BorderBrush="#2A2A34" BorderThickness="1" CornerRadius="8" Padding="8">
                                            <Grid>
                                                <TextBlock Text="{Binding WarningBadgeText}" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="9.5" FontWeight="Bold" Foreground="#EF4444"/>
                                                <TextBlock Text="🎞️" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5"/>
                                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="{Binding TypeBadgeBackground}" CornerRadius="4" Padding="6,2">
                                                    <TextBlock Text="{Binding TypeBadgeText}" FontSize="9.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <!-- Bottom Details & Actions -->
                                        <Grid Grid.Row="1" Margin="0,8,0,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" ToolTip="{Binding FilePath}"/>
                                            
                                            <Grid Grid.Row="1" Margin="0,6,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" Content="{Binding StatusText}" Style="{StaticResource SmallActionButtonStyle}" Background="{Binding StatusBackground}" Foreground="#FFFFFF" Tag="{Binding}" Click="OnApplyWallpaperCardClick" Margin="0,0,6,0"/>
                                                <design:HubHoldButton Grid.Column="1"
                                                                Width="32" Height="32" MinWidth="32"
                                                                Variant="Danger" Padding="0"
                                                                HoldingText="" ConfirmedText=""
                                                                Tag="{Binding}"
                                                                Confirmed="OnDeleteWallpaperCardClick"
                                                                ToolTip="Hold to delete">
                                                    <TextBlock Text="🗑" FontSize="12" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </design:HubHoldButton>
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- 2. DESKTOP WIDGETS TAB CONTENT -->
                <StackPanel x:Name="SubPanelOverviewWidgets" Visibility="Collapsed">
                    <local:OverviewView x:Name="OverviewWidgetsControl"/>
                </StackPanel>

                <!-- 3. TASKBAR & DOCK TAB CONTENT -->
                <StackPanel x:Name="SubPanelOverviewTaskbar" Visibility="Collapsed">

                    <!-- Card 1: Taskbar Transparency -->
                    <Border Background="#16191E" BorderBrush="#252A33" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🪟" FontSize="14" Margin="0,0,6,0"/>
                                    <TextBlock Text="Taskbar Transparency &amp; Composition Mode" FontSize="13.5" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                </StackPanel>
                                <TextBlock Text="Control Windows shell taskbar visual blend modes using DirectComposition and Windows Accent DWM APIs." FontSize="11.5" Foreground="#71717A" Margin="0,3,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Mode:" Foreground="#A1A1AA" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox x:Name="CmbTaskbarTransparency" Width="170" Height="28" SelectedIndex="1" FontSize="12">
                                    <ComboBoxItem Content="Default (Windows Native)"/>
                                    <ComboBoxItem Content="Clear (100% Transparent)"/>
                                    <ComboBoxItem Content="Blur (Frosted Aero Glass)"/>
                                    <ComboBoxItem Content="Acrylic (Fluent Mica &amp; Blur)"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Card 2: Dynamic Taskbar State -->
                    <Border Background="#16191E" BorderBrush="#252A33" BorderThickness="1" CornerRadius="10" Padding="16,10" Margin="0,0,0,14">
                        <design:SettingRow Title="Dynamic Taskbar State"
                                           Description="Automatically transition taskbar to pure clear when only desktop is visible, and smoothly restore Blur/Acrylic when application windows are maximized or focused.">
                            
                                <design:HubToggle x:Name="ChkDynamicTaskbarState" IsChecked="True"/>
                            
                        </design:SettingRow>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
