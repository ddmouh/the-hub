<UserControl x:Class="TheHub.App.Pages.OptionsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:design="clr-namespace:TheHub.Design.Controls;assembly=TheHub.Design" 
             mc:Ignorable="d" 
             d:DesignHeight="900" d:DesignWidth="800">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" Focusable="True" MinHeight="0">
        <StackPanel Margin="0,0,10,20">
            <TextBlock Text="Options &amp; Preferences" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF"/>
            <TextBlock Text="Dashboard font, custom fonts, and application preferences." FontSize="12.5" Foreground="#71717A" Margin="0,4,0,20"/>

            <!-- DASHBOARD FONT -->
            <Border Background="#16191E" BorderBrush="#252A33" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,14">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="200"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🖥" FontSize="14" Margin="0,0,6,0"/>
                                <TextBlock Text="Dashboard Font" FontSize="13.5" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                            </StackPanel>
                            <TextBlock Text="System-wide font applied to The Hub dashboard UI. Takes effect immediately." FontSize="11.5" Foreground="#71717A" Margin="0,3,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ComboBox x:Name="CmbDashboardFont"
                                  Grid.Column="1"
                                  VerticalAlignment="Center"
                                  FontSize="12"
                                  SelectionChanged="OnDashboardFontChanged"
                                  ToolTip="Select the font used throughout the Hub dashboard UI">
                            <ComboBoxItem Content="Segoe UI Variable Text" Tag="Segoe UI Variable Text"/>
                            <ComboBoxItem Content="Segoe UI" Tag="Segoe UI" IsSelected="True"/>
                            <ComboBoxItem Content="Inter" Tag="Inter"/>
                            <ComboBoxItem Content="Roboto" Tag="Roboto"/>
                            <ComboBoxItem Content="Open Sans" Tag="Open Sans"/>
                            <ComboBoxItem Content="Arial" Tag="Arial"/>
                            <ComboBoxItem Content="Calibri" Tag="Calibri"/>
                            <ComboBoxItem Content="Consolas" Tag="Consolas"/>
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Custom Fonts Management Card -->
            <Border Background="#16191E" BorderBrush="#252A33" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,14">
                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🔤" FontSize="14" Margin="0,0,6,0"/>
                                <TextBlock Text="Custom Fonts" FontSize="13.5" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                            </StackPanel>
                            <TextBlock Text="Install .ttf / .otf fonts. Installed fonts appear automatically in each widget's Font selector below." FontSize="11.5" Foreground="#71717A" Margin="0,3,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="⬇ Install New Font" Style="{StaticResource PrimaryButtonStyle}" Padding="14,7" VerticalAlignment="Center" Click="OnInstallFontClick" ToolTip="Select a .ttf or .otf file to install"/>
                    </Grid>
                    <TextBlock Text="INSTALLED FONTS" FontSize="11" FontWeight="Bold" Foreground="#71717A" Margin="0,10,0,8"/>
                    <ItemsControl x:Name="FontsListControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding FamilyName}" FontFamily="{Binding PreviewFontFamily}" FontSize="16" Foreground="#FFFFFF"/>
                                            <TextBlock Text="{Binding FileName}" FontFamily="Consolas, monospace" FontSize="11" Foreground="#9CA3AF" Margin="0,1,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <design:HubHoldButton Width="32" Height="32" MinWidth="32"
                                                        Variant="Danger" Padding="0"
                                                        HoldingText="" ConfirmedText=""
                                                        Tag="{Binding FileName}"
                                                        Confirmed="OnDeleteFontClick"
                                                        ToolTip="Hold to delete">
                                    <TextBlock Text="🗑" FontSize="12" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </design:HubHoldButton>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="FontsEmptyPrompt" Text="No custom fonts installed yet. Click 'Install New Font' to add one." FontSize="11.5" Foreground="#71717A" Margin="0,4,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <!-- WALLPAPERS CONFIGURATION GROUP -->
            <TextBlock Text="WALLPAPERS" FontSize="11" FontWeight="Bold" Foreground="#71717A" Margin="0,4,0,10"/>
            <Border Background="#16191E" BorderBrush="#252A33" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,0,0,14">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,14">
                        <TextBlock Text="🎬" FontSize="14" Margin="0,0,8,0"/>
                        <StackPanel>
                            <TextBlock Text="Wallpaper Behaviour" FontSize="13.5" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                            <TextBlock Text="Quick-access wallpaper controls mirrored from the Wallpapers tab." FontSize="11.5" Foreground="#71717A" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Control 1: Auto-pause in fullscreen -->
                    <Border Background="#12141A" BorderBrush="#1F2029" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Auto-pause in fullscreen / games" FontSize="12" FontWeight="SemiBold" Foreground="#E4E4E7"/>
                                <TextBlock Text="Pauses live video when a full-screen app or game runs on that display" FontSize="11" Foreground="#71717A" Margin="0,2,0,0"/>
                            </StackPanel>
                            <design:HubToggle x:Name="ChkOptPauseFullscreen"
                                              Grid.Column="1"
                                              VerticalAlignment="Center"
                                              Checked="OnOptionsWallpaperSettingChanged"
                                              Unchecked="OnOptionsWallpaperSettingChanged"
                                              Tag="PauseFullscreen"
                                              ToolTip="Pauses live video when full-screen apps or games run on that display"/>
                        </Grid>
                    </Border>

                    <!-- Control 2: Pause on battery -->
                    <Border Background="#12141A" BorderBrush="#1F2029" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Pause on battery power" FontSize="12" FontWeight="SemiBold" Foreground="#E4E4E7"/>
                                <TextBlock Text="Freezes live video wallpapers when running on battery to conserve energy" FontSize="11" Foreground="#71717A" Margin="0,2,0,0"/>
                            </StackPanel>
                            <design:HubToggle x:Name="ChkOptPauseBattery"
                                              Grid.Column="1"
                                              VerticalAlignment="Center"
                                              Checked="OnOptionsWallpaperSettingChanged"
                                              Unchecked="OnOptionsWallpaperSettingChanged"
                                              Tag="PauseBattery"
                                              ToolTip="Freezes live video wallpapers when running on battery power"/>
                        </Grid>
                    </Border>

                    <!-- Control 3: Mute sound -->
                    <Border Background="#12141A" BorderBrush="#1F2029" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Mute wallpaper audio" FontSize="12" FontWeight="SemiBold" Foreground="#E4E4E7"/>
                                <TextBlock Text="Silences any audio embedded in animated video wallpapers" FontSize="11" Foreground="#71717A" Margin="0,2,0,0"/>
                            </StackPanel>
                            <design:HubToggle x:Name="ChkOptMuteAudio"
                                              Grid.Column="1"
                                              VerticalAlignment="Center"
                                              Checked="OnOptionsWallpaperSettingChanged"
                                              Unchecked="OnOptionsWallpaperSettingChanged"
                                              Tag="MuteAudio"
                                              ToolTip="Mutes audio in animated video wallpapers"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
